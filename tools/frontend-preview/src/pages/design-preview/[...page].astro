---
import Layout from '../../../../../src/layouts/DesignPreview.astro';
import Gallery from '../../../../../src/components/design-preview/Gallery.astro';
import Lightbox from '../../../../../src/components/design-preview/Lightbox.astro';
import CooperationForm from '../../../../../src/components/design-preview/CooperationForm.astro';
import {asset,collections,steps} from '../../../../../src/data/design-preview';
export function getStaticPaths(){return ['portfolio','cooperation','about',...Array.from({length:20},(_,i)=>'series/'+i)].map(page=>({params:{page}}));}
const page=Astro.params.page;
const seriesId=Number(page.split('/')[1]||8),collection=collections[seriesId]||collections[8];
const title=page==='portfolio'?'全部作品':page==='cooperation'?'一起創作':page==='about'?'關於我':page.startsWith('series/')?collection.title:'PHOX999';
const seriesImages=collection.photos;
---
<Layout title={title}>
<main id="main-content">
{page==='portfolio'&&<><section class="page-intro editorial-intro"><small class="eyebrow">PHOX999 / SELECTED STORIES</small><div class="section-heading"><h1>一些相遇，一些故事。</h1><p class="intro-meta">全部作品 / {collections.length} SERIES</p></div></section><section class="page-space gallery-section"><Gallery items={collections}/></section></>}
{page.startsWith('series/')&&<><section class="page-intro editorial-intro"><a class="eyebrow" href="/design-preview/portfolio/">全部作品 / SERIES {String(seriesId+1).padStart(2,'0')}</a><div class="section-heading"><h1>{collection.title}</h1><p class="intro-meta">{seriesImages.length} PHOTOGRAPHS / PHOX999</p></div></section><section class="page-space gallery-section"><Gallery items={seriesImages.map((image,index)=>({image,index}))} detail title={collection.title}/></section><section class="page-space series-next"><a href="/design-preview/portfolio/">返回全部作品</a><h2>繼續看見，不同的故事。</h2></section><Lightbox images={seriesImages}/></>}
{page==='cooperation'&&<>
<section class="cooperation-hero" aria-labelledby="cooperation-title">
<picture><source media="(max-width:600px)" srcset={asset('370bf.png')}/><img src={asset('68a98.png')} width="1800" height="1200" alt="人像攝影作品" fetchpriority="high"/></picture>
<div class="cooperation-hero__text"><small class="eyebrow">COLLABORATION / PHOX999</small><h1 id="cooperation-title">一起創作</h1><p>先留下想法，我們再一起確認怎麼拍。</p></div>
</section>
<section class="page-space process-section" aria-labelledby="process-title"><small class="eyebrow">PROCESS / 01 — 04</small><h2 id="process-title">從想法，到一起完成。</h2><ol class="process-cards">{steps.map(step=><li><article><small>{step[0]}</small><h3>{step[1]}</h3><p>{step[2]}</p><p>{step[3]}</p></article></li>)}</ol></section>
<section class="page-space cooperation-form-section"><CooperationForm/></section></>}
{page==='about'&&<section class="about-profile" aria-labelledby="about-title"><div class="portrait-placeholder"><h2>個人照</h2><p>使用站台現有 Profile-pic.jpg<br/>等待照片上傳授權</p></div><div class="about-narrative"><small class="eyebrow">ABOUT PHOX999</small><h1 id="about-title">嗨，我是小蔡。</h1><small class="eyebrow about-role">PHOX999 / 台北人像攝影</small><p class="about-copy">我是小蔡，喜歡自然、有故事的人像。<br/>以雙北為主，拍攝外景、棚拍與主題創作。<br/>第一次拍照也沒關係，我們一起找到舒服的節奏。</p><div class="social-icons"><a href="https://www.instagram.com/phox999_/" aria-label="Instagram" target="_blank" rel="noreferrer"><img src={asset('4fa21.svg')} width="24" height="24" alt=""/></a><a href="mailto:chuajinglun@ymail.com" aria-label="Email"><img src={asset('f50cb.svg')} width="24" height="24" alt=""/></a></div><a class="pill" href="/design-preview/cooperation/">了解合作方式</a></div></section>}
</main></Layout>
