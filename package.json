{
  "name": "phox999-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-portfolio-thumbnails.mjs && node scripts/motion-lab-assets.mjs && astro dev",
    "build": "node scripts/generate-portfolio-thumbnails.mjs && node scripts/motion-lab-assets.mjs && astro build",
    "build:worker": "npm run build && node scripts/prepare-worker-assets.mjs",
    "verify:worker": "node scripts/verify-seo.mjs --dist worker-dist --strict-dist",
    "verify:seo": "node scripts/verify-seo.mjs",
    "images:webp": "node scripts/convert-webp.mjs",
    "images:seo": "node scripts/generate-seo-image-variants.mjs",
    "images:admin": "node scripts/generate-portfolio-thumbnails.mjs",
    "verify:routes": "node scripts/verify-portfolio-routes.mjs",
    "preview": "astro preview",
    "pretest": "node scripts/generate-portfolio-thumbnails.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@supabase/supabase-js": "^2.110.7",
    "astro": "^5.10.0",
    "gsap": "^3.15.0",
    "sharp": "^0.35.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "wrangler": "^4.112.0"
  }
}
