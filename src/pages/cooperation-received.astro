---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {siteConfig} from '../data/site';
import '../styles/inner-pages.css';
---
<BaseLayout title="申請已送出｜phox999 photography" description="保存本次收件代碼，查看下一步與預約中心。" noindex={true} referrer="no-referrer"><Header/><main id="main-content" class="inner-page" tabindex="-1"><section class="container received"><p class="eyebrow">YOUR NEXT CHAPTER</p><h1 id="received-title">讓下一次拍攝，從這裡開始。</h1><p id="received-status" role="status">正在確認收件…</p><div id="received-content" hidden><h2>已收到你的合作意向。</h2><p>送出申請不等於預約成立，拍攝安排需雙方確認。</p><p>收件代碼 <code id="received-code"></code></p><p id="received-time"></p><ol><li>保存代碼或私人連結；兩者都能管理本次預約。</li><li>前往預約中心選擇時段，可暫留 24 小時。</li><li>我會依主題與檔期評估，再透過你留下的聯絡方式回覆。</li></ol><p>若 3 個工作天後仍未收到回覆，歡迎附上收件編號詢問；實際回覆時間依拍攝安排而定。</p><div class="received-actions"><button class="button button--secondary" id="received-copy" type="button">複製查詢代碼</button><button class="button button--secondary" id="received-save" type="button">下載私人收件回條</button><a class="button button--primary" id="received-center">前往預約中心</a></div><p class="received-private">請勿公開分享代碼或私人連結。</p></div><a href={siteConfig.mailtoUrl}>聯繫攝影師</a><noscript><p>請開啟 JavaScript 讀取私人收件資料，或聯繫攝影師。</p></noscript></section></main><Footer/></BaseLayout>
<script>
 import {tokenFromFragment,formatShootTime} from '../lib/inquiry-workflow';
 import {centerFromResponse} from '../lib/cooperation-center';
 const token=tokenFromFragment(location.hash);if(location.hash||location.search)history.replaceState(null,'',location.pathname);
 const $=(id:string)=>document.getElementById(id)!;let reference='';const link=`/cooperation-status/#token=${token}`;
 async function load(){if(!token){$('received-status').textContent='請使用送出申請後提供的私人收件連結，或到預約中心輸入查詢代碼。';const a=document.createElement('a');a.href='/cooperation-status/';a.textContent='開啟預約中心';$('received-status').append(a);return;}try{const r=await fetch('/api/cooperation/center',{method:'POST',headers:{'Content-Type':'application/json','X-Phox-Request':'1',Authorization:`Bearer ${token}`},body:JSON.stringify({action:'open'}),credentials:'omit',cache:'no-store',signal:AbortSignal.timeout(20000)});if(!r.ok)throw new Error();const data=centerFromResponse(await r.json());if(!data)throw new Error();reference=data.reference;$('received-code').textContent=reference;$('received-time').textContent=`收件時間 ${formatShootTime(data.createdAt)}（台北時間）`;($('received-center')as HTMLAnchorElement).href=link;$('received-content').hidden=false;$('received-status').textContent='收件已確認。';}catch{$('received-status').textContent='暫時無法讀取收件資料。請重新開啟保存的連結，或聯繫攝影師確認。';}}
 $('received-copy').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(reference);$('received-status').textContent='已複製查詢代碼。';}catch{$('received-status').textContent='無法自動複製，請長按或選取畫面上的代碼保存。';}});
 $('received-save').addEventListener('click',()=>{const url=URL.createObjectURL(new Blob([`Phox999 私人收件回條\n收件編號：${reference}\n私人預約中心：${new URL(link,location.origin).href}\n請勿公開分享。\n`],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download=`${reference}-receipt.txt`;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});void load();
</script>
<style>.received{max-width:900px;padding:clamp(24px,5vw,48px);background:#fff;border-radius:32px;box-shadow:var(--shadow-card);}.received h1{font-size:clamp(1.8rem,4vw,2.8rem);line-height:1.5;}.received h2{font-size:1.5rem;margin-top:28px;}.received p,.received li{line-height:1.9;margin-block:16px;}.received code{overflow-wrap:anywhere;}.received ol{padding-left:24px;}.received-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px;}.received-private{color:var(--color-muted);}.received [hidden]{display:none!important;}@media(max-width:600px){.received-actions .button{width:100%;}}</style>
