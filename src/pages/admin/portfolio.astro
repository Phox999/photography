---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { portfolioAdminCatalog } from '../../data/portfolioCatalog';

const portfolioSeed = portfolioAdminCatalog.map(({ slug, title, category, description, cover, images, totalImages }) => ({
  slug,
  title,
  category,
  description,
  cover: `static:${cover}`,
  images: images.map((image) => `static:${image}`),
  totalImages,
}));
const portfolioSeedJson = JSON.stringify(portfolioSeed).replaceAll('<', '\\u003c');
---
<AdminLayout title="管理作品集" current="portfolio" wide={true}>
  <div class="portfolio-admin-page">
    <header class="portfolio-page-toolbar">
      <div class="portfolio-page-title">
        <span class="admin-eyebrow">作品集</span>
        <h1>作品工作台</h1>
      </div>
      <span class="portfolio-publish-state" id="portfolio-publish-state" role="status" aria-live="polite">正在載入</span>
      <a class="admin-button admin-button--quiet" href="/portfolio/" target="_blank" rel="noopener">預覽前台</a>
      <button class="admin-button admin-button--quiet" type="button" id="portfolio-reload">重新載入</button>
      <button class="admin-button" type="button" id="portfolio-publish" disabled>發布作品集</button>
    </header>
    <p class="admin-status portfolio-load-status" id="portfolio-load-status" role="status" aria-live="polite"></p>
    <p class="admin-status portfolio-load-status" id="portfolio-validation-status" role="status" aria-live="polite" hidden></p>

    <section class="portfolio-workbench" id="portfolio-editor" aria-label="作品集管理工作台" hidden>
      <aside class="portfolio-sidebar" id="portfolio-sidebar" aria-label="作品系列清單">
        <div class="portfolio-sidebar__top">
          <div class="portfolio-sidebar__heading"><span aria-hidden="true">≡</span><h2>作品系列</h2><span class="portfolio-count" id="portfolio-count"></span></div>
          <button class="portfolio-icon-button" type="button" id="portfolio-sidebar-toggle" aria-label="收合作品系列側欄" aria-controls="portfolio-sidebar" aria-expanded="true" title="收合／展開作品系列">‹</button>
        </div>
        <button class="admin-button portfolio-add-button" type="button" id="portfolio-add"><span aria-hidden="true">＋</span> 新增作品</button>
        <div class="portfolio-list-filters">
          <label class="portfolio-visually-hidden" for="portfolio-search">搜尋作品系列</label>
          <input id="portfolio-search" type="search" placeholder="搜尋作品" autocomplete="off" />
          <label class="portfolio-visually-hidden" for="portfolio-category-filter">依分類篩選</label>
          <select id="portfolio-category-filter" aria-label="依分類篩選作品">
            <option value="all">全部分類</option><option value="外拍">外拍</option><option value="棚拍">棚拍</option>
          </select>
          <button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-sort-toggle" aria-pressed="false">排序模式</button>
          <button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-restore-order" hidden>還原系列順序</button>
          <p class="portfolio-sort-hint" id="portfolio-sort-hint" hidden>拖曳把手排序；也可用鍵盤按鈕調整位置。篩選時停用全域排序。</p>
        </div>
        <div class="portfolio-collection-list" id="portfolio-list" aria-label="作品系列"></div>
      </aside>

      <main class="portfolio-stage">
        <header class="portfolio-stage__toolbar">
          <button class="portfolio-icon-button portfolio-mobile-sidebar-toggle" type="button" id="portfolio-mobile-sidebar-toggle" aria-controls="portfolio-sidebar" aria-expanded="false" aria-label="開啟作品系列清單">☰</button>
          <div class="portfolio-stage__collection">
            <h2 id="portfolio-detail-heading">選擇作品系列</h2>
            <p id="portfolio-detail-count" class="admin-meta"></p>
          </div>
          <div class="portfolio-stage__actions">
            <label class="admin-button admin-button--quiet portfolio-select-files" for="portfolio-image-input">上傳照片</label>
            <button class="admin-button admin-button--quiet" type="button" id="portfolio-upload" disabled>開始上傳</button>
            <button class="admin-button admin-button--quiet" type="button" id="portfolio-selection-toggle" aria-pressed="false">多選照片</button>
            <button class="admin-button admin-button--quiet" type="button" id="portfolio-photo-sort-toggle" aria-pressed="false">照片排序</button>
            <button class="admin-button admin-button--quiet" type="button" id="portfolio-info-toggle" aria-expanded="false" aria-controls="portfolio-info-drawer">作品資訊</button>
          </div>
          <div class="portfolio-position-control" id="portfolio-position-control" hidden>
            <label for="portfolio-position">移至第</label>
            <select id="portfolio-position" aria-label="作品系列排序位置"></select>
            <span>位</span>
            <button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-move-to-position">套用位置</button>
          </div>
        </header>

        <input class="portfolio-visually-hidden" id="portfolio-image-input" type="file" accept="image/jpeg,image/png,image/webp" multiple aria-describedby="portfolio-upload-help" />
        <section class="portfolio-upload-panel" id="portfolio-upload-panel" aria-label="加入作品照片">
          <label class="portfolio-dropzone" id="portfolio-dropzone" for="portfolio-image-input">
            <span class="portfolio-dropzone__icon" aria-hidden="true">↑</span>
            <span><strong>拖曳照片至此，或選擇照片</strong><small id="portfolio-upload-help">JPG/JPEG 會以品質 0.88 轉成 WebP；PNG 與 WebP 保持原格式。單張上傳檔案上限 8 MiB。</small></span>
          </label>
          <div class="portfolio-upload-queue" id="portfolio-upload-queue" hidden>
            <div class="portfolio-upload-queue__heading"><div><h3>上傳佇列</h3><p id="portfolio-upload-status" class="admin-meta" role="status" aria-live="polite"></p></div>
              <div class="portfolio-upload-queue__actions"><button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-stop-upload" hidden>停止後續上傳</button><button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-retry-failed" hidden>重試失敗項目</button><button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-clear-uploaded">清除已加入項目</button></div>
            </div>
            <ul class="portfolio-upload-queue__list" id="portfolio-upload-queue-list"></ul>
          </div>
        </section>

        <div class="portfolio-photo-area">
          <div class="portfolio-photo-empty" id="portfolio-photo-empty"><strong>選取左側作品系列</strong><span>中央區域會顯示可編排照片。</span></div>
          <div class="portfolio-photo-grid" id="portfolio-photos" aria-label="作品照片"></div>
        </div>

        <div class="portfolio-batch-toolbar" id="portfolio-batch-toolbar" hidden>
          <div><strong id="portfolio-selected-count">已選取 0 張</strong><span id="portfolio-selection-help">照片移動後仍需發布才會更新網站。</span></div>
          <div class="portfolio-batch-toolbar__actions">
            <button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-select-all">全選此作品</button>
            <button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-move-selected" disabled>移動到系列</button>
            <button class="admin-button admin-button--danger-quiet admin-button--small" type="button" id="portfolio-remove-selected" disabled>從作品移除</button>
            <button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-clear-selection">取消選取</button>
          </div>
        </div>

        <aside class="portfolio-info-drawer" id="portfolio-info-drawer" aria-label="作品資訊" aria-hidden="true" hidden>
          <div class="portfolio-info-drawer__heading"><div><span class="admin-eyebrow">作品設定</span><h2>作品資訊</h2></div><button class="portfolio-icon-button" type="button" id="portfolio-info-close" aria-label="關閉作品資訊">×</button></div>
          <form id="portfolio-detail-form">
            <div class="admin-field"><label for="portfolio-title">作品名稱</label><input id="portfolio-title" maxlength="120" required /></div>
            <div class="admin-field"><label for="portfolio-category">作品分類</label><select id="portfolio-category"><option value="外拍">外拍</option><option value="棚拍">棚拍</option></select></div>
            <div class="admin-field"><label for="portfolio-description">作品介紹</label><textarea id="portfolio-description" rows="5" maxlength="1000"></textarea><small class="admin-help">最多 1000 字；修改會先保留在本頁草稿。</small></div>
            <div class="portfolio-cover-preview"><span class="admin-eyebrow">目前封面</span><button type="button" id="portfolio-cover-jump" aria-label="回到目前封面照片"><img id="portfolio-cover-preview" alt="目前作品封面預覽" loading="lazy" decoding="async" hidden /><span id="portfolio-cover-label">尚未選擇封面</span></button></div>
            <p class="portfolio-info-drawer__note" id="portfolio-info-note">本頁修改會在按下「發布作品集」後才更新網站。</p>
          </form>
        </aside>
        <button class="portfolio-drawer-backdrop" id="portfolio-drawer-backdrop" type="button" tabindex="-1" aria-label="關閉作品資訊" hidden></button>
      </main>
    </section>

    <div class="portfolio-toast" id="portfolio-toast" role="status" aria-live="polite" hidden>
      <span id="portfolio-toast-message"></span><button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-undo-move" hidden>復原上一步移動</button>
    </div>
    <p class="portfolio-announcement portfolio-visually-hidden" id="portfolio-announcement" aria-live="polite"></p>

    <dialog class="portfolio-dialog" id="portfolio-move-dialog" aria-labelledby="portfolio-move-title">
      <div class="portfolio-dialog__header"><div><span class="admin-eyebrow">批次移動</span><h2 id="portfolio-move-title">移動照片到其他作品系列</h2></div><button class="portfolio-icon-button" type="button" data-close-move aria-label="關閉移動視窗">×</button></div>
      <p class="portfolio-dialog__source" id="portfolio-move-source"></p>
      <label class="admin-field"><span>搜尋目的地</span><input type="search" id="portfolio-destination-search" placeholder="輸入作品名稱" autocomplete="off" /></label>
      <label class="admin-field" for="portfolio-destination"><span>目的地作品系列</span><select id="portfolio-destination"><option value="">請選擇目的地</option></select></label>
      <p class="portfolio-dialog__summary" id="portfolio-move-summary" aria-live="polite">請選擇目的地。</p>
      <p class="portfolio-dialog__warning" id="portfolio-move-warning" hidden></p>
      <div class="portfolio-dialog__actions"><button class="admin-button admin-button--quiet" type="button" data-close-move>取消</button><button class="admin-button" type="button" id="portfolio-confirm-move" disabled>確認移動</button></div>
    </dialog>

    <dialog class="portfolio-dialog portfolio-confirm-dialog" id="portfolio-confirm-dialog" aria-labelledby="portfolio-confirm-title" aria-describedby="portfolio-confirm-message">
      <div class="portfolio-dialog__header"><div><span class="admin-eyebrow">請確認</span><h2 id="portfolio-confirm-title">確認操作</h2></div></div>
      <p class="portfolio-dialog__source" id="portfolio-confirm-message"></p>
      <div class="portfolio-dialog__actions"><button class="admin-button admin-button--quiet" type="button" id="portfolio-confirm-cancel">取消</button><button class="admin-button" type="button" id="portfolio-confirm-accept">確認</button></div>
    </dialog>

    <dialog class="portfolio-preview-dialog" id="portfolio-preview-dialog" aria-label="照片預覽">
      <button class="portfolio-preview-dialog__close" type="button" id="portfolio-preview-close" aria-label="關閉照片預覽">×</button>
      <button class="portfolio-preview-dialog__nav portfolio-preview-dialog__nav--previous" type="button" id="portfolio-preview-previous" aria-label="上一張照片">‹</button>
      <img id="portfolio-preview-image" alt="" />
      <button class="portfolio-preview-dialog__nav portfolio-preview-dialog__nav--next" type="button" id="portfolio-preview-next" aria-label="下一張照片">›</button>
      <p id="portfolio-preview-caption" aria-live="polite"></p>
    </dialog>

    <script id="portfolio-seed" type="application/json" set:html={portfolioSeedJson}></script>
  </div>
</AdminLayout>

<script>
  import { AdminApiError, adminErrorMessage, requestAdmin, requireAdminSession, setUnsavedChanges } from '../../lib/admin-client';
  import { portfolioChangeSet } from '../../lib/portfolio-changes.js';
  import { portfolioDraftIssues } from '../../lib/portfolio-validation.js';
  import { portfolioThumbnailSource, setPortfolioThumbnailSource } from '../../lib/portfolio-thumbnails';
  import { PORTFOLIO_THUMBNAIL_TARGET_BYTES, preparePortfolioImage } from '../../lib/portfolio-upload.js';
  import {
    movePhotosBetweenCollections,
    PORTFOLIO_PHOTO_LIMIT,
    removePhotosFromCollection,
    reorderCollection,
    reorderPhoto,
    restoreMovedPhotos,
  } from '../../lib/portfolio-workbench.js';

  type PortfolioPhoto = { path: string; url: string; thumbnail_url?: string | null };
  type Collection = { slug: string; title: string; category: '外拍' | '棚拍'; description: string; cover: string; coverUrl: string; coverThumbnailUrl?: string | null; images: PortfolioPhoto[]; totalImages: number };
  type PortfolioPayloadItem = { slug: string; title: string; category: Collection['category']; description: string; cover: string; images: string[]; totalImages: number };
  type PortfolioResponse = { version: number; collections: Array<Omit<Collection, 'coverUrl' | 'coverThumbnailUrl'> & { cover_url: string; cover_thumbnail_url?: string | null; images: PortfolioPhoto[] }> };
  type UploadStatus = 'waiting' | 'converting' | 'uploading' | 'added' | 'failed';
  type UploadItem = { id: string; file: File | null; targetSlug: string; status: UploadStatus; originalName: string; originalBytes: number; prepared?: { file: File; thumbnail: Blob }; thumbnailBytes?: number; outputBytes?: number; outputName?: string; message?: string };

  const $ = <T extends Element = HTMLElement>(id: string) => document.getElementById(id) as T;
  const editor = $<HTMLElement>('portfolio-editor');
  const list = $<HTMLElement>('portfolio-list');
  const photoGrid = $<HTMLElement>('portfolio-photos');
  const photoIndexByPath = new Map<string, number>();
  let renderedPhotoSlug = '';
  const photoObserver = typeof IntersectionObserver === 'undefined' ? null : new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      const image = entry.target as HTMLImageElement;
      photoObserver?.unobserve(image);
      if (!image.isConnected || !image.dataset.pendingSrc) continue;
      setPortfolioThumbnailSource(image, image.dataset.pendingSrc!, image.dataset.pendingThumbnail || '', { fallbackToOriginalOnError: true });
      delete image.dataset.pendingSrc;
      delete image.dataset.pendingThumbnail;
    }
  }, { root: photoGrid.parentElement, rootMargin: '200px 0px' });
  const detailForm = $<HTMLFormElement>('portfolio-detail-form');
  const titleInput = $<HTMLInputElement>('portfolio-title');
  const categoryInput = $<HTMLSelectElement>('portfolio-category');
  const descriptionInput = $<HTMLTextAreaElement>('portfolio-description');
  const photoInput = $<HTMLInputElement>('portfolio-image-input');
  const destinationSelect = $<HTMLSelectElement>('portfolio-destination');
  const moveDialog = $<HTMLDialogElement>('portfolio-move-dialog');
  const confirmDialog = $<HTMLDialogElement>('portfolio-confirm-dialog');
  const previewDialog = $<HTMLDialogElement>('portfolio-preview-dialog');
  const confirmMessage = $<HTMLElement>('portfolio-confirm-message');
  const confirmCancel = $<HTMLButtonElement>('portfolio-confirm-cancel');
  const confirmAccept = $<HTMLButtonElement>('portfolio-confirm-accept');
  let collections: Collection[] = [];
  let selectedSlug = '';
  let version = 1;
  let originalCollections: PortfolioPayloadItem[] = [];
  let baselineBySlug = new Map<string, PortfolioPayloadItem>();
  let baselineOrder: string[] = [];
  let orderDirty = false;
  const dirtySlugs = new Set<string>();
  const deletedSlugs = new Set<string>();
  const draftIssuesBySlug = new Map<string, ReturnType<typeof portfolioDraftIssues>>();
  let busy = false;
  let publishing = false;
  let uploading = false;
  let stopUploadRequested = false;
  let saveFailed = false;
  let selectionMode = false;
  let collectionSortMode = false;
  let photoSortMode = false;
  let sidebarCollapsed = false;
  let draggedCollectionSlug = '';
  let draggedPhotoPath = '';
  let rangeAnchorPath = '';
  let previewPath = '';
  let lastMoveUndo: ReturnType<typeof movePhotosBetweenCollections>['undo'] | null = null;
  let drawerTrigger: HTMLElement | null = null;
  let confirmDialogActive = false;
  let dragScrollFrame = 0;
  let dragScrollContainer: HTMLElement | null = null;
  let dragScrollVelocity = 0;
  let detailUpdateTimer = 0;
  let detailComposing = false;
  const selectedPaths = new Set<string>();
  const uploadItems: UploadItem[] = [];
  const uploadQueueList = $('portfolio-upload-queue-list');

  function requestConfirmation(message: string, acceptLabel: string): Promise<boolean> {
    if (confirmDialogActive) return Promise.resolve(false);
    confirmDialogActive = true;
    const returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    confirmMessage.textContent = message;
    confirmAccept.textContent = acceptLabel;
    confirmDialog.returnValue = 'cancel';

    return new Promise<boolean>((resolve) => {
      const finish = () => {
        confirmDialogActive = false;
        const canRestore = returnFocus?.isConnected
          && !('disabled' in returnFocus && Boolean((returnFocus as HTMLButtonElement).disabled));
        if (canRestore) returnFocus.focus();
        else $('portfolio-reload').focus();
        resolve(confirmDialog.returnValue === 'confirm');
      };
      confirmDialog.addEventListener('close', finish, { once: true });
      try {
        confirmDialog.showModal();
        confirmCancel.focus();
      } catch {
        confirmDialog.removeEventListener('close', finish);
        confirmDialogActive = false;
        resolve(false);
      }
    });
  }

  confirmCancel.addEventListener('click', () => confirmDialog.close('cancel'));
  confirmAccept.addEventListener('click', () => confirmDialog.close('confirm'));
  confirmDialog.addEventListener('click', (event) => {
    if (event.target === confirmDialog) confirmDialog.close('cancel');
  });

  function seedCollections(): Collection[] {
    const seed = JSON.parse($('portfolio-seed').textContent || '[]') as Array<Omit<Collection, 'coverUrl' | 'images'> & { images: string[] }>;
    return seed.map((item) => ({
      ...item,
      coverUrl: item.cover.slice('static:'.length),
      images: item.images.map((path) => ({ path, url: path.slice('static:'.length) })),
    }));
  }
  function collectionFromResponse(item: PortfolioResponse['collections'][number]): Collection {
    return { ...item, coverUrl: item.cover_url, coverThumbnailUrl: item.cover_thumbnail_url, images: item.images };
  }
  function selectedCollection() { return collections.find((collection) => collection.slug === selectedSlug) ?? null; }
  function collectionPayload(collection: Collection): PortfolioPayloadItem {
    return {
      slug: collection.slug, title: collection.title, category: collection.category,
      description: collection.description, cover: collection.cover,
      images: collection.images.map((image) => image.path), totalImages: collection.totalImages,
    };
  }
  function payload() {
    return collections.map(collectionPayload);
  }
  function currentChanges() {
    return portfolioChangeSet(originalCollections, payload());
  }
  function hasPendingChanges() {
    return dirtySlugs.size > 0 || deletedSlugs.size > 0 || orderDirty;
  }
  function captureBaseline() {
    originalCollections = payload();
    baselineBySlug = new Map(originalCollections.map((item) => [item.slug, item]));
    baselineOrder = originalCollections.map((item) => item.slug);
    dirtySlugs.clear(); deletedSlugs.clear(); draftIssuesBySlug.clear(); orderDirty = false;
    for (const item of originalCollections) draftIssuesBySlug.set(item.slug, portfolioDraftIssues([item]));
  }
  function syncDraft(slugs: string[] = [], checkOrder = true) {
    for (const slug of new Set(slugs)) {
      const current = collections.find((item) => item.slug === slug);
      const baseline = baselineBySlug.get(slug);
      if (!current) {
        dirtySlugs.delete(slug); draftIssuesBySlug.delete(slug);
        if (baseline) deletedSlugs.add(slug); else deletedSlugs.delete(slug);
      } else {
        deletedSlugs.delete(slug);
        const next = collectionPayload(current);
        if (!baseline || JSON.stringify(next) !== JSON.stringify(baseline)) dirtySlugs.add(slug);
        else dirtySlugs.delete(slug);
        draftIssuesBySlug.set(slug, portfolioDraftIssues([next]));
      }
    }
    if (checkOrder) {
      const currentOrder = collections.map((item) => item.slug);
      orderDirty = currentOrder.length !== baselineOrder.length || currentOrder.some((slug, index) => slug !== baselineOrder[index]);
    }
    updateDraftStatus();
  }
  function filteredCollections() {
    const query = $<HTMLInputElement>('portfolio-search').value.trim().toLocaleLowerCase('zh-Hant');
    const category = $<HTMLSelectElement>('portfolio-category-filter').value;
    return collections.filter((collection) => (!category || category === 'all' || collection.category === category)
      && (!query || `${collection.title} ${collection.slug} ${collection.category}`.toLocaleLowerCase('zh-Hant').includes(query)));
  }
  function isListFiltered() {
    return Boolean($<HTMLInputElement>('portfolio-search').value.trim())
      || $<HTMLSelectElement>('portfolio-category-filter').value !== 'all';
  }
  function changeCount() {
    return dirtySlugs.size + deletedSlugs.size + Number(orderDirty);
  }
  function validCollections() {
    return portfolioDraftIssues(payload()).length === 0;
  }
  function updateDraftStatus() {
    const changed = hasPendingChanges();
    const count = changeCount();
    const unfinishedUploads = uploadItems.filter((item) => item.status !== 'added').length;
    const failedUploads = uploadItems.filter((item) => item.status === 'failed').length;
    const issues = [...draftIssuesBySlug.values()].flat();
    const badge = $('portfolio-publish-state');
    badge.classList.toggle('is-dirty', changed);
    badge.classList.toggle('is-error', saveFailed && changed);
    if (publishing) badge.textContent = '發布中';
    else if (uploading) badge.textContent = '上傳中 · 尚未發布';
    else if (saveFailed && changed) badge.textContent = '發布失敗 · 草稿已保留';
    else if (changed) badge.textContent = `尚未發布 · ${count} 處修改${unfinishedUploads ? ` · ${unfinishedUploads} 項待上傳` : ''}`;
    else if (failedUploads) badge.textContent = `上傳失敗 · ${failedUploads} 項可重試`;
    else if (unfinishedUploads) badge.textContent = `待上傳 · ${unfinishedUploads} 項`;
    else badge.textContent = collections.length ? '已發布' : '待載入';
    setUnsavedChanges(changed || unfinishedUploads > 0);
    const validationStatus = $('portfolio-validation-status');
    validationStatus.hidden = !changed || !issues.length;
    validationStatus.textContent = issues.length
      ? `尚無法發布：${issues.slice(0, 3).map((issue) => `「${issue.title}」${issue.message}`).join(' ')}${issues.length > 3 ? ` 另有 ${issues.length - 3} 組需修正。` : ''}` : '';
    $<HTMLButtonElement>('portfolio-publish').disabled = busy || uploading || !changed || issues.length > 0;
    $('portfolio-publish').setAttribute('aria-describedby', 'portfolio-validation-status');
    $<HTMLButtonElement>('portfolio-publish').textContent = publishing ? '發布中…' : '發布作品集';
  }
  function updateState() {
    const locked = busy || uploading;
    updateDraftStatus();
    $<HTMLButtonElement>('portfolio-reload').disabled = locked;
    $<HTMLButtonElement>('portfolio-add').disabled = locked || collections.length >= 80;
    $<HTMLButtonElement>('portfolio-upload').disabled = locked || !uploadItems.some((item) => item.status === 'waiting') || !selectedCollection();
    photoInput.disabled = locked || !selectedCollection();
    titleInput.disabled = locked; categoryInput.disabled = locked; descriptionInput.disabled = locked;
