    }
    if (preview) {
      const path = preview.dataset.photoPreview || '';
      if (selectionMode) togglePhotoSelection(path, (event as MouseEvent).shiftKey);
      else openPhotoPreview(path);
      return;
    }
    if (retry) {
      const image = retry.parentElement?.querySelector<HTMLImageElement>('img');
      if (image) {
        const source = image.dataset.thumbnailSrc;
        if (source) {
          const retryUrl = new URL(source, window.location.origin);
          retryUrl.searchParams.set('retry', String(Date.now()));
          image.src = retryUrl.toString(); retry.hidden = true; retry.parentElement?.classList.remove('is-image-error');
        }
      }
      return;
    }
    if (!action || busy || uploading) return;
    const collection = selectedCollection(); const path = action.dataset.photoPath || '';
    const index = collection?.images.findIndex((photo) => photo.path === path) ?? -1;
    if (!collection || index < 0) return;
    const verb = action.dataset.photoAction;
    if (verb === 'up' && index > 0 || verb === 'down' && index < collection.images.length - 1) {
      const position = index + (verb === 'up' ? -1 : 1);
      collection.images = reorderPhoto(collection.images, path, position); syncDraft([collection.slug]); renderPhotos();
      requestAnimationFrame(() => photoGrid.querySelector<HTMLButtonElement>(`[data-photo-path="${CSS.escape(path)}"][data-photo-action="${verb}"]`)?.focus());
    } else if (verb === 'cover') {
      collection.cover = path; collection.coverUrl = collection.images[index].url;
      collection.coverThumbnailUrl = collection.images[index].thumbnail_url || null;
      syncDraft([collection.slug]); renderEditor();
      announce(`已將第 ${index + 1} 張照片設為封面，尚未發布。`);
    } else if (verb === 'remove' && collection.images.length > 1) void removeSinglePhoto(path);
  });
  photoGrid.addEventListener('change', (event) => {
    const checkbox = event.target instanceof HTMLInputElement && event.target.matches('[data-photo-select]')
      ? event.target : null;
    const path = checkbox?.dataset.photoSelect || '';
    const collection = selectedCollection();
    if (!checkbox || !collection || !photoIndexByPath.has(path)) return;
    const shift = checkbox.dataset.selectionShift === 'true';
    delete checkbox.dataset.selectionShift;
    if (shift && checkbox.checked && rangeAnchorPath) {
      const from = photoIndexByPath.get(rangeAnchorPath)!;
      const to = photoIndexByPath.get(path)!;
      const [start, end] = [Math.min(from, to), Math.max(from, to)];
      for (let index = start; index <= end; index += 1) selectedPaths.add(collection.images[index].path);
      syncVisiblePhotoSelection();
    } else {
      if (checkbox.checked) selectedPaths.add(path); else selectedPaths.delete(path);
      updatePhotoSelection(path, checkbox.checked);
    }
    rangeAnchorPath = path;
    setBatchToolbar();
  });
  photoGrid.addEventListener('dragstart', (event) => {
    const card = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-photo-card]') : null;
    if (!photoSortMode || selectionMode || !card || busy || uploading) { event.preventDefault(); return; }
    draggedPhotoPath = card.dataset.photoPath || '';
    if (event.dataTransfer) { event.dataTransfer.effectAllowed = 'move'; event.dataTransfer.setData('text/plain', draggedPhotoPath); }
    card.classList.add('is-dragging');
  });
  photoGrid.addEventListener('dragover', (event) => {
    const card = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-photo-card]') : null;
    if (!draggedPhotoPath || !card) return;
    event.preventDefault(); photoGrid.querySelectorAll('.is-drop-target').forEach((item) => item.classList.remove('is-drop-target')); card.classList.add('is-drop-target');
    updateDragScroll(photoGrid.parentElement!, event.clientY);
  });
  photoGrid.addEventListener('drop', (event) => {
    const card = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-photo-card]') : null;
    const collection = selectedCollection();
    if (!draggedPhotoPath || !card || !collection || !card.dataset.photoPath) return;
    event.preventDefault();
    stopDragScroll();
    const targetIndex = collection.images.findIndex((photo) => photo.path === card.dataset.photoPath);
    const sourceIndex = collection.images.findIndex((photo) => photo.path === draggedPhotoPath);
    const rect = card.getBoundingClientRect();
    const after = event.clientX > rect.left + rect.width / 2;
    const slot = targetIndex + (after ? 1 : 0);
    const position = slot > sourceIndex ? slot - 1 : slot;
    const sourcePath = draggedPhotoPath;
    draggedPhotoPath = '';
    if (sourceIndex >= 0 && targetIndex >= 0) {
      collection.images = reorderPhoto(collection.images, sourcePath, Math.max(0, Math.min(collection.images.length - 1, position)));
      syncDraft([collection.slug]); renderPhotos();
    }
  });
  photoGrid.addEventListener('dragend', () => {
    stopDragScroll();
    draggedPhotoPath = ''; photoGrid.querySelectorAll('.is-dragging,.is-drop-target').forEach((card) => card.classList.remove('is-dragging', 'is-drop-target'));
  });
  photoGrid.addEventListener('error', (event) => {
    const image = event.target instanceof HTMLImageElement ? event.target : null;
    if (!image) return;
    const card = image.closest<HTMLElement>('[data-photo-card]');
    if (!card) return;
    card.classList.add('is-image-error');
    const retry = card.querySelector<HTMLButtonElement>('[data-photo-retry]'); if (retry) retry.hidden = false;
  }, true);
  photoGrid.addEventListener('load', (event) => {
    const image = event.target instanceof HTMLImageElement ? event.target : null;
    const card = image?.closest<HTMLElement>('[data-photo-card]');
    card?.classList.remove('is-image-error');
    const retry = card?.querySelector<HTMLButtonElement>('[data-photo-retry]'); if (retry) retry.hidden = true;
  }, true);

  function scheduleDetailDraftSync(slug: string) {
    window.clearTimeout(detailUpdateTimer);
    detailUpdateTimer = window.setTimeout(() => {
      detailUpdateTimer = 0;
      if (!detailComposing) syncDraft([slug], false);
    }, 150);
  }
  detailForm.addEventListener('compositionstart', () => { detailComposing = true; window.clearTimeout(detailUpdateTimer); });
  detailForm.addEventListener('compositionend', () => {
    detailComposing = false;
    const collection = selectedCollection();
    if (collection) scheduleDetailDraftSync(collection.slug);
  });
  detailForm.addEventListener('input', () => {
    const collection = selectedCollection(); if (!collection || busy || uploading) return;
    collection.title = titleInput.value; collection.description = descriptionInput.value;
    $('portfolio-detail-heading').textContent = collection.title.trim() || '新增作品';
    updateCollectionRow(collection);
    if (!detailComposing) scheduleDetailDraftSync(collection.slug);
  });
  categoryInput.addEventListener('change', () => {
    const collection = selectedCollection(); if (!collection || busy || uploading) return;
    collection.category = categoryInput.value as Collection['category']; updateCollectionRow(collection); syncDraft([collection.slug], false);
  });
  $<HTMLInputElement>('portfolio-search').addEventListener('input', renderList);
  $<HTMLSelectElement>('portfolio-category-filter').addEventListener('change', renderList);
  $<HTMLButtonElement>('portfolio-sort-toggle').addEventListener('click', () => { collectionSortMode = !collectionSortMode; renderList(); });
  $<HTMLButtonElement>('portfolio-restore-order').addEventListener('click', () => {
    if (busy || uploading || isListFiltered()) return;
    const previousOrder = baselineOrder;
    const bySlug = new Map(collections.map((item) => [item.slug, item]));
    collections = [...previousOrder.filter((slug) => bySlug.has(slug)).map((slug) => bySlug.get(slug)!), ...collections.filter((item) => !previousOrder.includes(item.slug))];
    syncDraft([], true);
    renderEditor(); announce('已還原載入時的系列順序，其他草稿修改保留。');
  });
  $<HTMLButtonElement>('portfolio-photo-sort-toggle').addEventListener('click', () => { photoSortMode = !photoSortMode; renderPhotos(); updateState(); });
  $<HTMLButtonElement>('portfolio-selection-toggle').addEventListener('click', () => {
    clearSelection(); selectionMode = !selectionMode;
    photoGrid.querySelectorAll<HTMLElement>('[data-photo-card]').forEach((card) => {
      const index = photoIndexByPath.get(card.dataset.photoPath || '') || 0;
      card.querySelector<HTMLElement>('.portfolio-photo-select')!.hidden = !selectionMode;
      card.querySelector<HTMLButtonElement>('[data-photo-preview]')?.setAttribute('aria-label', selectionMode
        ? `選取第 ${index + 1} 張照片` : `預覽${selectedCollection()?.title || '作品'}第 ${index + 1} 張照片`);
    });
    updateState();
  });
  $<HTMLButtonElement>('portfolio-select-all').addEventListener('click', () => {
    const collection = selectedCollection(); if (!collection) return;
    const selectedCount = collection.images.reduce((total, photo) => total + Number(selectedPaths.has(photo.path)), 0);
    const clear = selectedCount === collection.images.length;
    selectedPaths.clear();
    if (!clear) collection.images.forEach((photo) => selectedPaths.add(photo.path));
    syncVisiblePhotoSelection();
    rangeAnchorPath = clear ? '' : collection.images[0]?.path || ''; setBatchToolbar();
  });
  $<HTMLButtonElement>('portfolio-clear-selection').addEventListener('click', () => {
    selectionMode = false; clearSelection();
    photoGrid.querySelectorAll<HTMLElement>('[data-photo-card]').forEach((card) => {
      const index = photoIndexByPath.get(card.dataset.photoPath || '') || 0;
      card.querySelector<HTMLElement>('.portfolio-photo-select')!.hidden = true;
      card.querySelector<HTMLButtonElement>('[data-photo-preview]')?.setAttribute('aria-label', `預覽${selectedCollection()?.title || '作品'}第 ${index + 1} 張照片`);
    });
    updateState();
  });
  $<HTMLButtonElement>('portfolio-move-selected').addEventListener('click', openMoveDialog);
  $<HTMLButtonElement>('portfolio-remove-selected').addEventListener('click', () => void removeSelectedPhotos());
  $<HTMLInputElement>('portfolio-destination-search').addEventListener('input', () => { renderDestinationOptions(); updateMoveDialog(); });
  destinationSelect.addEventListener('change', updateMoveDialog);
  moveDialog.querySelectorAll<HTMLElement>('[data-close-move]').forEach((button) => button.addEventListener('click', () => moveDialog.close()));
  moveDialog.addEventListener('click', (event) => { if (event.target === moveDialog) moveDialog.close(); });
  $<HTMLButtonElement>('portfolio-confirm-move').addEventListener('click', confirmMove);
  $<HTMLButtonElement>('portfolio-undo-move').addEventListener('click', undoLastMove);
  $<HTMLButtonElement>('portfolio-add').addEventListener('click', newCollection);
  $<HTMLButtonElement>('portfolio-move-to-position').addEventListener('click', () => {
    const position = Number($<HTMLSelectElement>('portfolio-position').value) - 1; applyCollectionOrder(selectedSlug, position);
  });
  $<HTMLButtonElement>('portfolio-sidebar-toggle').addEventListener('click', (event) => toggleSidebar(event.currentTarget as HTMLButtonElement));
  $<HTMLButtonElement>('portfolio-mobile-sidebar-toggle').addEventListener('click', (event) => toggleSidebar(event.currentTarget as HTMLButtonElement));
  $<HTMLButtonElement>('portfolio-info-toggle').addEventListener('click', (event) => {
    const drawer = $('portfolio-info-drawer');
    if (drawer.hidden) openInfoDrawer(event.currentTarget as HTMLElement); else closeInfoDrawer();
  });
  $<HTMLButtonElement>('portfolio-info-close').addEventListener('click', closeInfoDrawer);
  $('portfolio-drawer-backdrop').addEventListener('click', closeInfoDrawer);
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !$<HTMLDialogElement>('portfolio-move-dialog').open && !$<HTMLDialogElement>('portfolio-preview-dialog').open && !$<HTMLElement>('portfolio-info-drawer').hidden) closeInfoDrawer();
    const drawer = $<HTMLElement>('portfolio-info-drawer');
    if (event.key === 'Tab' && !drawer.hidden && !moveDialog.open && !previewDialog.open) {
      const focusable = Array.from(drawer.querySelectorAll<HTMLElement>('button:not(:disabled), input:not(:disabled), select:not(:disabled), textarea:not(:disabled)'));
      const first = focusable[0]; const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
  });
  $<HTMLButtonElement>('portfolio-cover-jump').addEventListener('click', () => {
    const collection = selectedCollection(); if (!collection) return;
    const card = photoGrid.querySelector<HTMLElement>(`[data-photo-path="${CSS.escape(collection.cover)}"]`);
    card?.scrollIntoView({ block: 'center', behavior: 'smooth' });
    if (card) { card.classList.add('is-cover-highlight'); window.setTimeout(() => card.classList.remove('is-cover-highlight'), 1200); }
  });
  photoInput.addEventListener('change', () => { if (photoInput.files) enqueueFiles(photoInput.files); });
  $<HTMLButtonElement>('portfolio-upload').addEventListener('click', () => void runUploadQueue(uploadItems.filter((item) => item.status === 'waiting')));
  $<HTMLButtonElement>('portfolio-stop-upload').addEventListener('click', () => {
    if (!uploading) return;
    stopUploadRequested = true;
    $('portfolio-upload-status').textContent = '目前照片完成或回報結果後，佇列會停止；待處理項目會保留。';
    updateUploadControls();
  });
  $<HTMLButtonElement>('portfolio-retry-failed').addEventListener('click', () => {
    const failed = uploadItems.filter((item) => item.status === 'failed'); failed.forEach((item) => { item.status = 'waiting'; item.message = ''; });
    renderUploadQueue(); void runUploadQueue(failed);
  });
  $('portfolio-upload-queue-list').addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-upload-retry], [data-upload-remove]');
    if (!button || busy || uploading) return;
    const id = button.dataset.uploadRetry || button.dataset.uploadRemove;
    const item = uploadItems.find((entry) => entry.id === id); if (!item) return;
    if (button.dataset.uploadRetry) { item.status = 'waiting'; item.message = ''; void runUploadQueue([item]); }
    else { uploadItems.splice(uploadItems.indexOf(item), 1); renderUploadQueue(); updateState(); }
  });
  $<HTMLButtonElement>('portfolio-clear-uploaded').addEventListener('click', () => {
    for (let index = uploadItems.length - 1; index >= 0; index -= 1) if (uploadItems[index].status === 'added') uploadItems.splice(index, 1);
    renderUploadQueue(); updateState();
  });
  const dropzone = $('portfolio-dropzone');
  dropzone.addEventListener('dragover', (event) => { event.preventDefault(); dropzone.classList.add('is-drag-over'); });
  dropzone.addEventListener('dragleave', (event) => { if (!dropzone.contains(event.relatedTarget as Node)) dropzone.classList.remove('is-drag-over'); });
  dropzone.addEventListener('drop', (event) => {
    event.preventDefault(); dropzone.classList.remove('is-drag-over');
    if (event.dataTransfer?.files) enqueueFiles(event.dataTransfer.files);
  });
  $<HTMLButtonElement>('portfolio-reload').addEventListener('click', async () => {
    if (busy || uploading) return;
    if (hasPendingChanges() && !await requestConfirmation('重新載入會捨棄目前尚未發布的作品集草稿，並讀取最新版本。要繼續嗎？', '捨棄並重新載入')) return;
    const unfinished = uploadItems.filter((item) => item.status !== 'added').length;
    if (unfinished && !await requestConfirmation(`上傳佇列仍有 ${unfinished} 張未完成照片；重新載入會清空這些佇列項目。要繼續嗎？`, '清除佇列並重新載入')) return;
    uploadItems.splice(0); selectedPaths.clear(); closeInfoDrawer();
    void loadPortfolio();
  });
  $<HTMLButtonElement>('portfolio-publish').addEventListener('click', () => void publishPortfolio());
  $<HTMLButtonElement>('portfolio-preview-close').addEventListener('click', () => previewDialog.close());
  $<HTMLButtonElement>('portfolio-preview-previous').addEventListener('click', () => stepPhotoPreview(-1));
  $<HTMLButtonElement>('portfolio-preview-next').addEventListener('click', () => stepPhotoPreview(1));
  previewDialog.addEventListener('click', (event) => { if (event.target === previewDialog) previewDialog.close(); });
  const mobileSidebar = window.matchMedia('(max-width: 1199px)');
  try { sidebarCollapsed = sessionStorage.getItem('phox999.admin.portfolio.sidebar-collapsed') === 'true' && !mobileSidebar.matches; } catch { sidebarCollapsed = false; }
  editor.classList.toggle('is-sidebar-collapsed', sidebarCollapsed);
  $<HTMLButtonElement>('portfolio-sidebar-toggle').setAttribute('aria-expanded', String(!sidebarCollapsed));
  $<HTMLButtonElement>('portfolio-sidebar-toggle').textContent = sidebarCollapsed ? '›' : '‹';
  mobileSidebar.addEventListener('change', () => { editor.classList.remove('is-sidebar-open'); syncSidebarAccessibility(); });
  syncSidebarAccessibility();
  requireAdminSession().then(loadPortfolio).catch((error) => { $('portfolio-load-status').textContent = adminErrorMessage(error); });
</script>
