---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { portfolioAdminCatalog } from '../../data/portfolioCatalog';

const portfolioSeed = portfolioAdminCatalog.map(({ slug, title, category, description, cover, images, totalImages }) => ({
  slug,
  title,
  category,
  description,
  cover: `static:${cover}`,
  images: images.map((image) => `static:${image}`),
  totalImages,
}));
const portfolioSeedJson = JSON.stringify(portfolioSeed).replaceAll('<', '\\u003c');
---
<AdminLayout title="管理作品集" current="portfolio">
  <header class="admin-page-heading">
    <div><span class="admin-eyebrow">作品集</span><h1>管理我的作品集</h1></div>
    <button class="admin-button admin-button--quiet" type="button" id="portfolio-reload">重新載入</button>
  </header>
  <p class="admin-status" id="portfolio-load-status" role="status" aria-live="polite">正在載入作品集…</p>
  <div class="portfolio-admin-grid" id="portfolio-editor" hidden>
    <section class="admin-card portfolio-admin-list-panel" aria-labelledby="portfolio-list-title">
      <div class="admin-panel-heading"><h2 id="portfolio-list-title">作品系列</h2><button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-add">新增作品</button></div>
      <p class="admin-meta" id="portfolio-count"></p>
      <div class="portfolio-admin-list" id="portfolio-list"></div>
    </section>
    <section class="admin-card portfolio-admin-detail" aria-labelledby="portfolio-detail-title">
      <div class="portfolio-admin-empty" id="portfolio-empty"><h2 id="portfolio-detail-title">選擇或新增作品</h2></div>
      <form id="portfolio-detail-form" hidden>
        <div class="admin-panel-heading"><h2 id="portfolio-detail-heading">作品設定</h2><span class="admin-meta" id="portfolio-detail-count"></span></div>
        <div class="portfolio-admin-fields">
          <div class="admin-field"><label for="portfolio-title">作品名稱</label><input id="portfolio-title" maxlength="120" required /></div>
          <div class="admin-field"><label for="portfolio-category">作品分類</label><select id="portfolio-category"><option value="外拍">外拍</option><option value="棚拍">棚拍</option></select></div>
        </div>
        <div class="admin-field"><label for="portfolio-description">作品介紹</label><textarea id="portfolio-description" rows="3" maxlength="1000"></textarea></div>
        <div class="portfolio-admin-cover">
          <div><span class="admin-eyebrow">作品封面</span><p id="portfolio-cover-label">尚未選擇封面</p></div>
          <img id="portfolio-cover-preview" alt="目前作品封面預覽" hidden />
        </div>
        <div class="admin-field portfolio-admin-upload-field">
          <label for="portfolio-image-input">加入照片</label>
          <input id="portfolio-image-input" type="file" accept="image/jpeg,image/png,image/webp" multiple aria-describedby="portfolio-image-help" />
          <p class="admin-help" id="portfolio-image-help">可一次選多張 JPEG、PNG 或 WebP；單張最多 8 MiB。</p>
          <div class="admin-actions"><button class="admin-button admin-button--quiet" type="button" id="portfolio-upload" disabled>加入照片</button></div>
          <p class="admin-status" id="portfolio-upload-status" role="status" aria-live="polite"></p>
        </div>
        <div class="portfolio-admin-photo-heading"><h3 id="portfolio-photos-title">作品照片</h3><span class="admin-meta" id="portfolio-selection-count" role="status" aria-live="polite">已選 0 張</span></div>
        <p class="admin-help" id="portfolio-selection-help">點選照片可多選；Shift + 點選可選取一段照片。每組作品至少保留 1 張。</p>
        <div class="portfolio-admin-photo-toolbar" id="portfolio-photo-toolbar" role="group" aria-label="照片操作">
          <label class="portfolio-admin-select-all"><input id="portfolio-select-all" type="checkbox" />全選</label>
          <button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-clear-selection" disabled>取消選取</button>
          <button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-photo-up" disabled>向前移</button>
          <button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-photo-down" disabled>向後移</button>
          <button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-photo-cover" disabled>設為封面</button>
          <button class="admin-button admin-button--quiet admin-button--small" type="button" id="portfolio-photo-remove" disabled>移除照片</button>
        </div>
        <div class="portfolio-admin-photos" id="portfolio-photos" aria-labelledby="portfolio-photos-title" aria-describedby="portfolio-selection-help"></div>
      </form>
    </section>
  </div>
  <section class="admin-card portfolio-admin-publish" id="portfolio-publish-panel" hidden>
    <div><h2>發布作品集</h2><p class="admin-meta" id="portfolio-dirty">內容尚未變更。</p><p class="admin-status" id="portfolio-save-status" role="status" aria-live="polite"></p></div>
    <button class="admin-button" type="button" id="portfolio-publish" disabled>發布作品集</button>
  </section>
  <script id="portfolio-seed" type="application/json" set:html={portfolioSeedJson}></script>
</AdminLayout>

<script>
  import { AdminApiError, adminErrorMessage, confirmDiscardChanges, requestAdmin, requireAdminSession, setUnsavedChanges } from '../../lib/admin-client';
  import { portfolioChangeSet } from '../../lib/portfolio-changes.js';
  import { portfolioControlState } from '../../lib/portfolio-control-state.js';
  import { moveSelectedPhotos, photoSelectionState, removeSelectedPhotos, selectPhotoRange } from '../../lib/portfolio-photo-selection.js';
  type PortfolioPhoto = { path: string; url: string };
  type Collection = { slug: string; title: string; category: '外拍' | '棚拍'; description: string; cover: string; coverUrl: string; images: PortfolioPhoto[]; totalImages: number };
  type PortfolioResponse = { version: number; collections: Array<Omit<Collection, 'coverUrl'> & { cover_url: string; images: PortfolioPhoto[] }> };
  const $ = <T extends Element = HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const editor = $('#portfolio-editor');
  const list = $('#portfolio-list');
  const detailForm = $<HTMLFormElement>('#portfolio-detail-form');
  const emptyPanel = $('#portfolio-empty');
  const titleInput = $<HTMLInputElement>('#portfolio-title');
  const categoryInput = $<HTMLSelectElement>('#portfolio-category');
  const descriptionInput = $<HTMLTextAreaElement>('#portfolio-description');
  const photoInput = $<HTMLInputElement>('#portfolio-image-input');
  const photoGrid = $('#portfolio-photos');
  const uploadButton = $<HTMLButtonElement>('#portfolio-upload');
  const selectAll = $<HTMLInputElement>('#portfolio-select-all');
  let selectedPhotos = new Set<string>();
  let selectionAnchor: string | null = null;
  let selectionSlug: string | null = null;
  let collections: Collection[] = [];
  let selectedIndex = -1;
  let version = 1;
  let original = '';
  let busy = false;
  let uploading = false;

  function seedCollections(): Collection[] {
    const seed = JSON.parse($('#portfolio-seed').textContent || '[]') as Array<Omit<Collection, 'coverUrl' | 'images'> & { images: string[] }>;
    return seed.map((item) => ({
      ...item,
      coverUrl: item.cover.slice('static:'.length),
      images: item.images.map((path) => ({ path, url: path.slice('static:'.length) })),
    }));
  }
  function payload() {
    return collections.map(({ slug, title, category, description, cover, images }) => ({
      slug, title, category, description, cover, images: images.map((image) => image.path), totalImages: images.length,
    }));
  }
  function updateState() {
    const value = payload();
    const changed = JSON.stringify(value) !== original;
    const valid = value.length > 0 && value.every((item) => item.title.trim() && item.cover && item.images.length > 0);
    const controls = portfolioControlState({ busy, uploading, collections, selectedIndex, hasPendingFiles: Boolean(photoInput.files?.length), changed, valid });
    setUnsavedChanges(changed);
    $('#portfolio-dirty').textContent = changed ? '有尚未發布的修改。' : '內容尚未變更。';
    $<HTMLButtonElement>('#portfolio-publish').disabled = controls.publishDisabled;
    $('#portfolio-count').textContent = `${collections.length} 組作品`;
    uploadButton.disabled = controls.uploadDisabled;
    photoInput.disabled = controls.locked;
    titleInput.disabled = controls.locked;
    categoryInput.disabled = controls.locked;
    descriptionInput.disabled = controls.locked;
    $<HTMLButtonElement>('#portfolio-add').disabled = controls.addDisabled;
    $<HTMLButtonElement>('#portfolio-reload').disabled = controls.reloadDisabled;
    list.querySelectorAll<HTMLButtonElement>('[data-collection-select]').forEach((button) => { button.disabled = controls.locked; });
    list.querySelectorAll<HTMLButtonElement>('[data-collection-action]').forEach((button) => {
      const action = button.dataset.collectionAction;
      const index = Number(button.dataset.collectionIndex);
      const state = controls.collectionActions[index];
      button.disabled = !state || (action === 'up' ? state.upDisabled : action === 'down' ? state.downDisabled : state.removeDisabled);
    });
    const collection = collections[selectedIndex];
    const selection = photoSelectionState(collection?.images || [], selectedPhotos, collection?.cover, controls.locked);
    selectAll.checked = selection.allSelected;
    selectAll.indeterminate = selection.partlySelected;
    selectAll.disabled = selection.selectAllDisabled;
    $('#portfolio-selection-count').textContent = `已選 ${selection.count} 張`;
    $<HTMLButtonElement>('#portfolio-clear-selection').disabled = selection.clearDisabled;
    $<HTMLButtonElement>('#portfolio-photo-up').disabled = selection.upDisabled;
    $<HTMLButtonElement>('#portfolio-photo-down').disabled = selection.downDisabled;
    $<HTMLButtonElement>('#portfolio-photo-cover').disabled = selection.coverDisabled;
    $<HTMLButtonElement>('#portfolio-photo-remove').disabled = selection.removeDisabled;
    photoGrid.querySelectorAll<HTMLButtonElement>('[data-photo-select]').forEach((button) => {
      const selected = selectedPhotos.has(button.dataset.photoSelect!);
      button.disabled = controls.locked;
      button.classList.toggle('is-selected', selected);
      button.setAttribute('aria-pressed', String(selected));
    });
  }
  function collectionFromResponse(item: PortfolioResponse['collections'][number]): Collection {
    return { ...item, coverUrl: item.cover_url, images: item.images };
  }
  function renderList() {
    list.replaceChildren();
    collections.forEach((collection, index) => {
      const row = document.createElement('div'); row.className = `portfolio-admin-item${selectedIndex === index ? ' is-selected' : ''}`;
      const select = document.createElement('button'); select.type = 'button'; select.className = 'portfolio-admin-item__select'; select.dataset.collectionSelect = String(index);
      const name = document.createElement('strong'); name.textContent = collection.title.trim() || '未命名作品';
      const meta = document.createElement('span'); meta.textContent = `${collection.category} · ${collection.images.length} 張`;
      select.append(name, meta);
      const actions = document.createElement('div'); actions.className = 'portfolio-admin-item__actions';
      for (const [action, label] of [['up', '上移'], ['down', '下移'], ['remove', '移除']]) {
        const button = document.createElement('button'); button.type = 'button'; button.className = 'admin-button admin-button--quiet admin-button--small'; button.dataset.collectionAction = action; button.dataset.collectionIndex = String(index); button.textContent = label;
        button.setAttribute('aria-label', action === 'remove' ? `移除${name.textContent}` : `${action === 'up' ? '將' : '將'}${name.textContent}${action === 'up' ? '上移' : '下移'}`);
        actions.append(button);
      }
      row.append(select, actions); list.append(row);
    });
    updateState();
  }
  function renderPhotos() {
    photoGrid.replaceChildren();
    const collection = collections[selectedIndex];
    if (!collection) return;
    selectedPhotos = new Set(collection.images.filter(photo => selectedPhotos.has(photo.path)).map(photo => photo.path));
    if (selectionAnchor && !collection.images.some(photo => photo.path === selectionAnchor)) selectionAnchor = null;
    $('#portfolio-detail-count').textContent = `${collection.images.length} 張照片`;
    collection.images.forEach((photo, index) => {
      const card = document.createElement('button'); card.type = 'button'; card.className = 'portfolio-admin-photo';
      card.dataset.photoSelect = photo.path;
      card.setAttribute('aria-label', `選取${collection.title || '作品'}第 ${index + 1} 張照片${collection.cover === photo.path ? '，目前封面' : ''}`);
      card.setAttribute('aria-pressed', String(selectedPhotos.has(photo.path)));
      const img = document.createElement('img'); img.src = photo.url; img.alt = `${collection.title || '作品'}第 ${index + 1} 張`; img.loading = 'lazy';
      card.append(img);
      if (collection.cover === photo.path) { const badge = document.createElement('span'); badge.className = 'portfolio-admin-photo__cover'; badge.textContent = '封面'; card.append(badge); }
      const check = document.createElement('span'); check.className = 'portfolio-admin-photo__check'; check.textContent = '✓'; check.setAttribute('aria-hidden', 'true');
      card.append(check); photoGrid.append(card);
    });
    updateState();
  }
  function renderEditor() {
    const collection = collections[selectedIndex];
    if (selectionSlug !== (collection?.slug || null)) {
      selectedPhotos.clear(); selectionAnchor = null; selectionSlug = collection?.slug || null;
    }
    emptyPanel.hidden = Boolean(collection); detailForm.hidden = !collection;
    if (!collection) return;
    $('#portfolio-detail-heading').textContent = collection.title.trim() || '新增作品';
    titleInput.value = collection.title; categoryInput.value = collection.category; descriptionInput.value = collection.description;
    const cover = collection.images.find((image) => image.path === collection.cover);
    const coverPreview = $<HTMLImageElement>('#portfolio-cover-preview');
    coverPreview.hidden = !collection.coverUrl; coverPreview.src = collection.coverUrl || cover?.url || '';
    $('#portfolio-cover-label').textContent = collection.cover ? '目前已選擇封面' : '請從照片中選擇封面';
    renderPhotos(); updateState();
  }
  async function loadPortfolio() {
    if (busy || (selectedIndex >= 0 && !confirmDiscardChanges())) return;
    busy = true; updateState(); $('#portfolio-load-status').textContent = '正在載入作品集…';
    try {
      const result = await requestAdmin<PortfolioResponse>('/api/admin/portfolio');
      version = result.version;
      selectedPhotos.clear(); selectionAnchor = null;
      collections = result.collections.length
        ? result.collections.map(collectionFromResponse)
        : seedCollections();
      selectedIndex = collections.length ? 0 : -1;
      original = JSON.stringify(payload());
      editor.hidden = false; $('#portfolio-publish-panel').hidden = false;
      $('#portfolio-load-status').textContent = '';
      renderList(); renderEditor();
    } catch (error) { $('#portfolio-load-status').textContent = adminErrorMessage(error); }
    finally { busy = false; updateState(); }
  }
  async function uploadPhoto(file: File, retryAuth = true): Promise<PortfolioPhoto> {
    const body = new FormData(); body.append('file', file);
    const controller = new AbortController(); const timer = window.setTimeout(() => controller.abort(), 30000);
    let response: Response;
    try { response = await fetch('/api/admin/portfolio-upload', { method: 'POST', credentials: 'same-origin', cache: 'no-store', headers: { 'X-Phox-Request': '1' }, body, signal: controller.signal }); }
    finally { window.clearTimeout(timer); }
    if (response.status === 401 && retryAuth) { await requestAdmin('/api/auth/refresh', { method: 'POST', body: {}, retryAuth: false }); return uploadPhoto(file, false); }
    const result = await response.json().catch(() => null);
    if (!response.ok || !result?.image?.path || !result?.image?.url) throw new Error(result?.message || '照片上傳失敗，請稍後重試。');
    return result.image as PortfolioPhoto;
  }
  async function uploadPhotos() {
    const collection = collections[selectedIndex]; const files = Array.from(photoInput.files || []);
    if (!collection || !files.length || busy || uploading) return;
    if (collection.images.length + files.length > 500) { $('#portfolio-upload-status').textContent = '每組作品最多 500 張照片。'; return; }
    if (files.some((file) => !['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || !file.size || file.size > 8 * 1024 * 1024)) { $('#portfolio-upload-status').textContent = '請確認照片格式正確，且每張不超過 8 MiB。'; return; }
    uploading = true; updateState(); let count = 0;
    try {
      for (const file of files) {
        $('#portfolio-upload-status').textContent = `正在上傳第 ${count + 1} / ${files.length} 張…`;
        const image = await uploadPhoto(file); collection.images.push(image); count += 1;
        const remaining = new DataTransfer(); files.slice(count).forEach((pending) => remaining.items.add(pending)); photoInput.files = remaining.files;
        if (!collection.cover) { collection.cover = image.path; collection.coverUrl = image.url; }
        renderPhotos(); renderList();
      }
      photoInput.value = ''; $('#portfolio-upload-status').textContent = `已加入 ${count} 張；發布作品集後會顯示在網站。`;
    } catch (error) { $('#portfolio-upload-status').textContent = `${count ? `已完成 ${count} 張，剩餘照片仍保留在選擇清單中；修正問題後可繼續上傳。` : ''}${error instanceof Error ? error.message : '照片上傳失敗，請稍後重試。'}`; }
    finally { uploading = false; updateState(); }
  }
  function newCollection() {
    if (busy || uploading || collections.length >= 80) return;
    const slug = `new-${crypto.randomUUID().slice(0, 8)}`;
    collections.push({ slug, title: '', category: '外拍', description: '', cover: '', coverUrl: '', images: [], totalImages: 0 });
    selectedIndex = collections.length - 1; renderList(); renderEditor(); titleInput.focus();
  }
  function moveCollection(index: number, amount: number) {
    const target = index + amount;
    if (busy || uploading || target < 0 || target >= collections.length) return;
    [collections[index], collections[target]] = [collections[target], collections[index]];
    if (selectedIndex === index) selectedIndex = target; else if (selectedIndex === target) selectedIndex = index;
    renderList(); renderEditor();
  }

  list.addEventListener('click', (event) => {
    if (busy || uploading) return;
    const target = event.target instanceof Element ? event.target : null;
    const actionButton = target?.closest<HTMLButtonElement>('[data-collection-action]');
    if (actionButton) {
      const index = Number(actionButton.dataset.collectionIndex);
      const action = actionButton.dataset.collectionAction;
      if (action === 'up') moveCollection(index, -1);
      else if (action === 'down') moveCollection(index, 1);
      else if (action === 'remove' && collections[index] && window.confirm(`確定移除「${collections[index].title || '未命名作品'}」及其中照片？發布後會從網站作品集移除。`)) {
        collections.splice(index, 1); selectedIndex = Math.min(selectedIndex, collections.length - 1); renderList(); renderEditor();
      }
      return;
    }
    const select = target?.closest<HTMLButtonElement>('[data-collection-select]');
    if (select) { selectedIndex = Number(select.dataset.collectionSelect); renderList(); renderEditor(); }
  });
  photoGrid.addEventListener('click', (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-photo-select]') : null;
    const collection = collections[selectedIndex]; const path = button?.dataset.photoSelect;
    if (!path || !collection?.images.some(photo => photo.path === path) || busy || uploading) return;
    if (event.shiftKey && selectionAnchor) selectedPhotos = selectPhotoRange(collection.images, selectedPhotos, selectionAnchor, path);
    else { if (selectedPhotos.has(path)) selectedPhotos.delete(path); else selectedPhotos.add(path); selectionAnchor = path; }
    updateState();
  });
  selectAll.addEventListener('change', () => {
    if (busy || uploading) return;
    const images = collections[selectedIndex]?.images || [];
    selectedPhotos = selectAll.checked ? new Set(images.map(photo => photo.path)) : new Set();
    selectionAnchor = null; updateState();
  });
  const clearSelection = () => { if (busy || uploading) return; selectedPhotos.clear(); selectionAnchor = null; updateState(); };
  $('#portfolio-clear-selection').addEventListener('click', clearSelection);
  detailForm.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && event.target instanceof Element && event.target.closest('#portfolio-photos, #portfolio-photo-toolbar')) clearSelection();
  });
  $('#portfolio-photo-toolbar').addEventListener('click', (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('button') : null;
    const collection = collections[selectedIndex];
    if (!button || !collection || busy || uploading || button.disabled) return;
    const state = photoSelectionState(collection.images, selectedPhotos, collection.cover);
    if (button.id === 'portfolio-photo-up' && !state.upDisabled) collection.images = moveSelectedPhotos(collection.images, selectedPhotos, 'up');
    else if (button.id === 'portfolio-photo-down' && !state.downDisabled) collection.images = moveSelectedPhotos(collection.images, selectedPhotos, 'down');
    else if (button.id === 'portfolio-photo-cover' && !state.coverDisabled) {
      const photo = collection.images.find(photo => selectedPhotos.has(photo.path))!;
      collection.cover = photo.path; collection.coverUrl = photo.url;
    } else if (button.id === 'portfolio-photo-remove' && !state.removeDisabled) {
      if (!window.confirm(`確定從這組作品移除已選的 ${state.count} 張照片？發布作品集後才會更新網站。`)) return;
      const remaining = removeSelectedPhotos(collection.images, selectedPhotos, collection.cover);
      if (!remaining) return;
      Object.assign(collection, remaining); selectedPhotos.clear(); selectionAnchor = null;
    } else return;
    renderList(); renderEditor();
  });
  detailForm.addEventListener('input', (event) => {
    if (event.target !== titleInput && event.target !== descriptionInput) return;
    const collection = collections[selectedIndex]; if (!collection || busy || uploading) return;
    collection.title = titleInput.value; collection.description = descriptionInput.value;
    $('#portfolio-detail-heading').textContent = collection.title.trim() || '新增作品';
    renderList(); updateState();
  });
  categoryInput.addEventListener('change', () => { const collection = collections[selectedIndex]; if (collection && !busy && !uploading) { collection.category = categoryInput.value as Collection['category']; renderList(); updateState(); } });
  photoInput.addEventListener('change', updateState);
  uploadButton.addEventListener('click', () => void uploadPhotos());
  $('#portfolio-add').addEventListener('click', newCollection);
  $('#portfolio-reload').addEventListener('click', () => { if (!busy && !uploading && confirmDiscardChanges()) void loadPortfolio(); });
  $('#portfolio-publish').addEventListener('click', async () => {
    if (busy || uploading || !collections.length) return;
    if (collections.some((item) => !item.title.trim() || !item.images.length || !item.cover)) { $('#portfolio-save-status').textContent = '每組作品都需要名稱、至少一張照片與封面。'; return; }
    if (!window.confirm(`確認發布 ${collections.length} 組作品集？網站上的作品順序與照片會隨即更新。`)) return;
    busy = true; updateState(); $('#portfolio-save-status').textContent = '正在發布作品集…';
    try {
      const changes = portfolioChangeSet(JSON.parse(original) as ReturnType<typeof payload>, payload());
      const result = await requestAdmin<PortfolioResponse>('/api/admin/portfolio-changes', { method: 'PATCH', body: { ...changes, version } });
      version = result.version; collections = result.collections.map(collectionFromResponse); selectedIndex = Math.min(selectedIndex, collections.length - 1);
      original = JSON.stringify(payload()); renderList(); renderEditor();
      $('#portfolio-save-status').textContent = '作品集已發布，網站通常會在一分鐘內更新。';
    } catch (error) {
      $('#portfolio-save-status').textContent = adminErrorMessage(error);
      if (error instanceof AdminApiError && error.status === 409) $('#portfolio-save-status').textContent = '作品集已在其他視窗更新，請重新載入後再修改。';
    } finally { busy = false; updateState(); }
  });
  requireAdminSession().then(loadPortfolio).catch(() => {});
</script>

<style>
  .portfolio-admin-grid { display: grid; grid-template-columns: minmax(280px, .7fr) minmax(0, 1.3fr); gap: 22px; align-items: start; }
  .portfolio-admin-list-panel, .portfolio-admin-detail { min-width: 0; }
  .portfolio-admin-list-panel .admin-panel-heading { align-items: center; }
  .portfolio-admin-list-panel h2, .portfolio-admin-publish h2 { margin: 0; }
  .portfolio-admin-list { display: grid; gap: 10px; margin-top: 14px; }
  .portfolio-admin-list :global(.portfolio-admin-item) { overflow: hidden; border: 1px solid var(--adm-line); border-radius: var(--adm-radius); background: #fff; }
  .portfolio-admin-list :global(.portfolio-admin-item.is-selected) { border-color: var(--adm-primary); background: var(--adm-pale); }
