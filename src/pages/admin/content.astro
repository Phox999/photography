---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="網站內容" current="content">
  <header class="admin-page-heading"><div><span class="admin-eyebrow">WORKSPACE / CONTENT</span><h1>讓資訊，跟上工作室的節奏。</h1><p>維護網站公告與常見問題。發布後，前台可能需等待約 1–3 分鐘更新。</p></div><button class="admin-button admin-button--quiet" type="button" id="content-reload">重新載入</button></header>
  <p class="admin-status" id="content-load-status" role="status" aria-live="polite">正在載入網站內容…</p>
  <form id="admin-content-form" method="post" action="/api/admin/content" hidden>
    <div class="admin-content-grid">
      <div class="admin-content-form">
        <section class="admin-card"><fieldset><legend>網站公告</legend><label class="admin-check"><input type="checkbox" id="announcement-enabled" />在前台顯示公告</label><div class="admin-field" style="margin-top:20px"><label for="announcement">公告內容</label><textarea id="announcement" maxlength="500" rows="4" placeholder="例如：近期合作安排或拍攝時程提醒。" aria-describedby="announcement-help"></textarea><p class="admin-help" id="announcement-help">純文字內容，最多 500 字。啟用公告時必須填寫內容。</p><span class="admin-count" id="announcement-count">0 / 500</span></div></fieldset></section>
        <section class="admin-card"><fieldset><legend>常見問題</legend><p class="admin-help" style="margin-bottom:20px">最多 12 題，可調整順序。每題標題最多 160 字，回答最多 1,200 字。</p><div class="admin-faq-items" id="content-faq-list"></div><p class="admin-help" id="faq-empty" hidden>目前沒有常見問題。發布後，前台會隱藏常見問題區塊。</p><button class="admin-button admin-button--quiet" type="button" id="content-add-faq" style="margin-top:20px">＋ 新增問題</button><p class="admin-status" id="faq-status" role="status" aria-live="polite"></p></fieldset></section>
      </div>
      <aside class="admin-card admin-publish-card" aria-labelledby="publish-heading"><span class="admin-eyebrow">PUBLISHING</span><h2 id="publish-heading">準備好讓大家看見？</h2><p class="admin-help">確認內容後再發布。這裡的修改只會影響公告與常見問題。</p><p class="admin-meta" id="content-version" style="margin-top:18px"></p><p class="admin-help" id="content-dirty">內容尚未變更。</p><button type="submit" class="admin-button" id="content-publish">發布更新</button><p class="admin-status" id="content-save-status" role="status" aria-live="polite"></p><hr style="border:0;border-top:1px solid var(--adm-line);margin:22px 0" /><h3>公告預覽</h3><p class="admin-preview-text" id="announcement-preview">前台公告未啟用。</p><a class="admin-text-link" href="/" target="_blank" rel="noopener">開啟前台網站</a></aside>
    </div>
  </form>
</AdminLayout>
<script>
  import { requireAdminSession, requestAdmin, adminErrorMessage, formatAdminDate, setUnsavedChanges, confirmDiscardChanges, AdminApiError } from '../../lib/admin-client';
  type Faq = { question: string; answer: string };
  type Content = { id: number; announcement: string; announcement_enabled: boolean; faqs: Faq[]; version: number; updated_at: string };
  const $ = <T extends Element = HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const form = $<HTMLFormElement>('#admin-content-form');
  const announcement = $<HTMLTextAreaElement>('#announcement');
  const enabled = $<HTMLInputElement>('#announcement-enabled');
  const faqList = $('#content-faq-list');
  const add = $<HTMLButtonElement>('#content-add-faq');
  const publish = $<HTMLButtonElement>('#content-publish');
  const loadStatus = $('#content-load-status');
  const saveStatus = $('#content-save-status');
  let loaded: Content | null = null;
  let original = '';
  let busy = false;
  let serial = 0;
  function message(element: HTMLElement, value: string, error = false) { element.textContent = value; element.dataset.error = String(error); }
  function readFaqs(): Faq[] {
    return Array.from(faqList.querySelectorAll<HTMLElement>('.admin-faq-item')).map((item) => ({ question: item.querySelector<HTMLInputElement>('[data-faq-question]')!.value, answer: item.querySelector<HTMLTextAreaElement>('[data-faq-answer]')!.value }));
  }
  function readContent() { return { announcement: announcement.value, announcement_enabled: enabled.checked, faqs: readFaqs() }; }
  function updateState() {
    const value = readContent();
    const changed = Boolean(loaded && JSON.stringify(value) !== original);
    setUnsavedChanges(changed);
    $('#content-dirty').textContent = changed ? '有尚未發布的修改。' : '內容尚未變更。';
    $('#announcement-count').textContent = `${announcement.value.length} / 500`;
    $('#announcement-preview').textContent = enabled.checked ? announcement.value || '啟用公告後，請填寫要顯示的內容。' : '前台公告未啟用。';
    announcement.required = enabled.checked;
    add.disabled = busy || value.faqs.length >= 12;
    publish.disabled = busy || !changed;
    $('#faq-empty').hidden = value.faqs.length !== 0;
  }
  function renumber() {
    const rows = Array.from(faqList.querySelectorAll<HTMLElement>('.admin-faq-item'));
    rows.forEach((row, index) => {
      row.querySelector('[data-faq-number]')!.textContent = `問題 ${String(index + 1).padStart(2, '0')}`;
      const up = row.querySelector<HTMLButtonElement>('[data-faq-action="up"]')!;
      const down = row.querySelector<HTMLButtonElement>('[data-faq-action="down"]')!;
      up.disabled = busy || index === 0; down.disabled = busy || index === rows.length - 1;
      up.setAttribute('aria-label', `將第 ${index + 1} 題往上移`); down.setAttribute('aria-label', `將第 ${index + 1} 題往下移`);
      row.querySelector('[data-faq-action="remove"]')!.setAttribute('aria-label', `移除第 ${index + 1} 題`);
    });
    updateState();
  }
  function createFaq(value: Faq) {
    const id = ++serial;
    const item = document.createElement('div'); item.className = 'admin-faq-item';
    const header = document.createElement('div'); header.className = 'admin-faq-item__header';
    const number = document.createElement('strong'); number.dataset.faqNumber = '';
    const actions = document.createElement('div'); actions.className = 'admin-actions';
    for (const [action, label] of [['up', '↑ 上移'], ['down', '↓ 下移'], ['remove', '移除']]) {
      const button = document.createElement('button'); button.type = 'button'; button.dataset.faqAction = action; button.className = `admin-button admin-button--small ${action === 'remove' ? 'admin-button--danger' : 'admin-button--quiet'}`; button.textContent = label; actions.append(button);
    }
    header.append(number, actions); item.append(header);
    const questionField = document.createElement('div'); questionField.className = 'admin-field';
    const questionLabel = document.createElement('label'); questionLabel.htmlFor = `faq-question-${id}`; questionLabel.textContent = '問題標題';
    const question = document.createElement('input'); question.type = 'text'; question.id = questionLabel.htmlFor; question.maxLength = 160; question.required = true; question.dataset.faqQuestion = ''; question.value = value.question;
    questionField.append(questionLabel, question);
    const answerField = document.createElement('div'); answerField.className = 'admin-field';
    const answerLabel = document.createElement('label'); answerLabel.htmlFor = `faq-answer-${id}`; answerLabel.textContent = '回答內容';
    const answer = document.createElement('textarea'); answer.id = answerLabel.htmlFor; answer.maxLength = 1200; answer.required = true; answer.rows = 4; answer.dataset.faqAnswer = ''; answer.value = value.answer;
    answerField.append(answerLabel, answer); item.append(questionField, answerField); faqList.append(item); return item;
  }
  function setBusy(value: boolean) {
    busy = value;
    form.setAttribute('aria-busy', String(value));
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLButtonElement>('input,textarea,button').forEach((element) => { element.disabled = value; });
    $<HTMLButtonElement>('#content-reload').disabled = value;
    renumber();
  }
  function applyContent(content: Content) {
    loaded = content;
    announcement.value = content.announcement || '';
    enabled.checked = content.announcement_enabled;
    faqList.replaceChildren();
    content.faqs.forEach(createFaq);
    original = JSON.stringify(readContent());
    $('#content-version').textContent = `版本 ${content.version} · 最後更新 ${formatAdminDate(content.updated_at)}`;
    renumber();
    form.hidden = false;
  }
  async function loadContent() {
    if (busy) return;
    setBusy(true);
    message(loadStatus, '正在載入網站內容…');
    try {
      const result = await requestAdmin<{ content: Content }>('/api/admin/content');
      applyContent(result.content);
      message(loadStatus, ''); message(saveStatus, '');
    } catch (error) { message(loadStatus, adminErrorMessage(error), true); }
    finally { setBusy(false); }
  }
  form.addEventListener('input', updateState);
  enabled.addEventListener('change', updateState);
  add.addEventListener('click', () => {
    if (busy || readFaqs().length >= 12) return;
    const row = createFaq({ question: '', answer: '' }); renumber(); row.querySelector<HTMLInputElement>('input')!.focus();
    message($('#faq-status'), `已新增第 ${readFaqs().length} 題。`);
  });
  faqList.addEventListener('click', (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-faq-action]') : null;
    const row = button?.closest<HTMLElement>('.admin-faq-item');
    if (!button || !row || busy) return;
    const action = button.dataset.faqAction;
    if (action === 'remove') {
      const question = row.querySelector<HTMLInputElement>('[data-faq-question]')!.value;
      const answer = row.querySelector<HTMLTextAreaElement>('[data-faq-answer]')!.value;
      if ((question || answer) && !window.confirm('確定移除這個常見問題？發布後才會更新前台。')) return;
      const next = row.nextElementSibling || row.previousElementSibling; row.remove(); renumber();
      if (next) next.querySelector<HTMLInputElement>('input')!.focus(); else add.focus();
      message($('#faq-status'), '已移除問題，發布後生效。');
    } else {
      if (action === 'up' && row.previousElementSibling) faqList.insertBefore(row, row.previousElementSibling);
      if (action === 'down' && row.nextElementSibling) faqList.insertBefore(row.nextElementSibling, row);
      renumber();
      const questionInput = row.querySelector<HTMLInputElement>('input'); questionInput?.focus();
      const index = Array.from(faqList.children).indexOf(row) + 1;
      message($('#faq-status'), `已移到第 ${index} 題，發布後生效。`);
    }
  });
  $('#content-reload').addEventListener('click', () => { if (!busy && confirmDiscardChanges()) void loadContent(); });
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (busy || !loaded || !form.reportValidity()) return;
    const value = readContent();
    if ((value.announcement_enabled && !value.announcement.trim()) || value.faqs.some((faq) => !faq.question.trim() || !faq.answer.trim())) { message(saveStatus, '啟用的公告與每一題問答都需要填寫有效內容。', true); return; }
    if (JSON.stringify(value) === original) { message(saveStatus, '內容尚未變更。'); return; }
    if (!window.confirm(`確認發布公告與 ${value.faqs.length} 題常見問題？前台可能需等待約 1–3 分鐘更新。`)) return;
    setBusy(true); message(saveStatus, '正在發布…');
    try {
      const result = await requestAdmin<{ content: Content }>('/api/admin/content', { method: 'PATCH', body: { ...value, version: loaded.version } });
      applyContent(result.content);
      message(saveStatus, '已發布，前台可能需等待約 1–3 分鐘更新；無法連線時保留內建內容。');
    } catch (error) {
      message(saveStatus, adminErrorMessage(error), true);
      if (error instanceof AdminApiError && error.status === 401) message(saveStatus, '登入已逾時。請先複製尚未發布的內容，再重新登入。', true);
    } finally { setBusy(false); }
  });
  requireAdminSession().then(loadContent).catch(() => {});
</script>
