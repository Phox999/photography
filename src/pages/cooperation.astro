---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Plans from '../components/Plans.astro';
import Process from '../components/Process.astro';
import Dates from '../components/Dates.astro';
import FAQ from '../components/FAQ.astro';
import Feedback from '../components/Feedback.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title="台北互惠攝影合作方式與檔期｜Phox999"
  description="了解 Phox999 的互惠人像與主題攝影合作方式、照片交付安排和近期檔期。拍攝前會一起討論主題、服裝與場景，再確認適合的合作計畫。"
>
  <Header />

  <main class="inner-page cooperation-page" id="main-content" tabindex="-1">
    <section class="container page-intro inner-heading" aria-labelledby="cooperation-title">
      <p class="eyebrow">COLLABORATION</p>
      <h1 id="cooperation-title">找到適合的合作方式。</h1>
      <p class="inner-intro">拍攝時間、照片交付與近期檔期，一次了解。</p>
      <nav class="inner-tabs" aria-label="合作資訊目錄">
        <a href="#plans">合作方式</a>
        <a href="/projects/">拍攝企劃</a>
        <a href="#availability">近期檔期</a>
        <a href="#process">合作流程</a>
        <a href="#faq">常見問題</a>
        <a href="#feedback">合作回饋</a>
      </nav>
    </section>

    <Plans id="plans" detailed description="先了解基本安排，細節再依這次拍攝一起確認。" />

    <div class="process-section container">
      <Process />
    </div>

    <Dates id="availability" />
    <FAQ />
    <div class="container cooperation-feedback"><Feedback /></div>

    <section class="container cooperation-availability" aria-label="開始合作">
      <div class="inner-next">
        <div>
          <p class="eyebrow">NEXT STEP</p>
          <h2>你想拍的，是什麼樣子？</h2>
          <p>帶著想法、問題或參考作品，都可以開始討論。</p>
        </div>
        <a class="button button--primary" href={siteConfig.inquiryUrl} data-analytics-event="inquiry_click" data-analytics-placement="cooperation">填寫合作意向</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .cooperation-feedback { padding-block: 56px; }
  .cooperation-feedback :global(.feedback-layout) { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 28px; }
  .cooperation-feedback :global(.feedback-column), .cooperation-feedback :global(.feedback-window) { min-width: 0; }
  .cooperation-feedback :global(.feedback-carousel) { position: relative; }
  .cooperation-feedback :global(.feedback-track) { overflow-x: auto; scrollbar-width: none; touch-action: pan-y; }
  .cooperation-feedback :global(.feedback-profile) { display: grid; align-content: center; gap: 24px; padding: 32px; border: 1px solid var(--color-border); border-radius: var(--radius-xl); }
  .cooperation-feedback :global(.feedback-profile img) { border-radius: 50%; }
  .cooperation-feedback :global(.feedback-profile h3) { font-size: 24px; }
  .cooperation-feedback :global(.feedback-profile p) { margin-block: 20px; }
  .cooperation-feedback :global(.feedback-profile a) { color: var(--color-primary-dark); text-decoration: underline; }
  .cooperation-feedback :global(.feedback-pagination) { grid-column: 1 / -1; }
  @media (max-width: 760px) {
    .cooperation-feedback :global(.feedback-layout) { grid-template-columns: minmax(0, 1fr); }
    .cooperation-feedback :global(.feedback-nav--prev) { left: -10px; }
    .cooperation-feedback :global(.feedback-nav--next) { right: -10px; }
  }
</style>
