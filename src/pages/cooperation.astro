---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Plans from '../components/Plans.astro';
import PlanRecommendation from '../components/PlanRecommendation.astro';
import Process from '../components/Process.astro';
import Dates from '../components/Dates.astro';
import { siteConfig } from '../data/site';
import { SITE_ORIGIN } from '../../server/seo.js';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE_ORIGIN}/cooperation/#webpage`,
    url: `${SITE_ORIGIN}/cooperation/`,
    name: '互惠攝影合作方式與檔期｜phox999 photography',
    description: '了解互惠人像拍攝的合作方式、額外支出、拍攝流程與檔期確認方式。',
    inLanguage: 'zh-Hant-TW',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${SITE_ORIGIN}/cooperation/#service`,
    name: '人像互惠攝影合作',
    serviceType: '人像攝影',
    description: '依每次拍攝主題討論安排；拍攝時間、服裝、照片交付與任何額外支出會事前確認。',
    areaServed: { '@type': 'City', name: '台北' },
    provider: { '@id': `${SITE_ORIGIN}/about/#person` },
    url: `${SITE_ORIGIN}/cooperation/`,
  },
];
---

<BaseLayout
  title="合作方式與檔期｜phox999 photography"
  description="了解一般互惠與主題企劃的安排，查看近期開放檔期，開始討論你想拍攝的作品。"
  structuredData={structuredData}
>
  <Header />

  <main class="inner-page cooperation-page" id="main-content" tabindex="-1">
    <section class="container page-intro inner-heading" aria-labelledby="cooperation-title">
      <p class="eyebrow">COLLABORATION</p>
      <h1 id="cooperation-title">找到適合的合作方式。</h1>
      <p class="inner-intro">拍攝時間、照片交付與近期檔期，一次了解。</p>
      <p class="inner-intro">送出合作意向不等於預約成立；主題、檔期、額外支出與合作細節都會先討論並由雙方確認。</p>
      <nav class="inner-tabs" aria-label="合作資訊目錄">
        <a href="#plans">合作方式</a>
        <a href="#availability">近期檔期</a>
        <a href="#process">合作流程</a>
      </nav>
    </section>

    <Plans id="plans" detailed description="先了解基本安排，細節再依這次拍攝一起確認。" />

    <PlanRecommendation />

    <div class="process-section container">
      <Process />
    </div>

    <Dates id="availability" />

    <section class="container cooperation-availability" aria-label="開始合作">
      <div class="inner-next">
        <div>
          <p class="eyebrow">NEXT STEP</p>
          <h2>你想拍的，是什麼樣子？</h2>
          <p>帶著想法、問題或參考作品，都可以開始討論。</p>
        </div>
        <div class="inner-actions">
          <a class="button button--primary" href={siteConfig.inquiryUrl}>填寫合作意向</a>
          <a class="button button--secondary" href="/cooperation-status/">查詢申請進度</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
