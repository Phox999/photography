---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Portfolio from '../components/Portfolio.astro';
import Plans from '../components/Plans.astro';
import Guidelines from '../components/Guidelines.astro';
import Process from '../components/Process.astro';
import Feedback from '../components/Feedback.astro';
import BehindScenes from '../components/BehindScenes.astro';
import Dates from '../components/Dates.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <TrustBar />
    <Portfolio />
    <Plans />
    {/* <Guidelines /> */}
    <div class="process-section container">
      <Process />
    </div>
    <div class="feedback-behind-section container">
      <Feedback />
      <BehindScenes />
    </div>
    <Dates />
    <FAQ />
  </main>
  <Footer />
</BaseLayout>
