---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Portfolio from '../components/Portfolio.astro';
import FeaturedSeries from '../components/FeaturedSeries.astro';
import VisualDirections from '../components/VisualDirections.astro';
import Dates from '../components/Dates.astro';
import Contact from '../components/Contact.astro';
import '../styles/home-refresh.css';
import '../styles/home-editorial.css';
import { siteConfig } from '../data/site';

const pageDescription = 'Phox999 是台北人像攝影師，提供雙北互惠攝影、外拍、棚拍與主題人像創作。第一次拍攝也沒關係，從主題、服裝到現場引導一起完成喜歡的作品。';
const homepageStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': 'https://phox999.com/#photography-service',
    name: 'Phox999 photography',
    url: 'https://phox999.com/',
    description: pageDescription,
    image: 'https://phox999.com/assets/hero.webp',
    serviceType: ['人像攝影', '互惠攝影', '戶外人像', '棚拍', '主題攝影'],
    areaServed: [
      { '@type': 'City', name: '台北市' },
      { '@type': 'City', name: '新北市' },
    ],
    sameAs: [siteConfig.instagramUrl],
    provider: { '@id': 'https://phox999.com/#photographer' },
  },
];
---

<BaseLayout
  title="台北人像攝影・互惠外拍｜Phox999 photography"
  description={pageDescription}
  ogImage="/assets/hero.webp"
  structuredData={homepageStructuredData}
  editorialHome
>
  <Header home editorial />
  <main class="editorial-home">
    <Hero editorial />
    <Portfolio editorial />
    <FeaturedSeries />
    <VisualDirections />
    <Dates editorial />
    <Contact editorial />
  </main>
  <footer class="editorial-footer">
    <a href="#hero" aria-label="回到首頁頂端">PHOX999</a>
    <nav aria-label="其他資訊">
      <a href="/portfolio/">全部作品</a>
      <a href="/cooperation/">合作方式</a>
      <a href={siteConfig.aboutUrl}>關於我</a>
      <a href={siteConfig.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href={siteConfig.mailtoUrl}>Email</a>
      <button type="button" data-open-analytics-preferences hidden>隱私設定</button>
    </nav>
    <small>© {new Date().getFullYear()} Phox999 photography</small>
  </footer>
</BaseLayout>
