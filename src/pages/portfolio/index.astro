---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { portfolioCatalog, portfolioCategories } from '../../data/portfolioCatalog';

const countFor = (category: string) =>
  portfolioCatalog.filter((item) => category === '全部' || item.category === category).length;
const getShootDate = (slug: string) => {
  const date = slug.match(/^(\d{2})(\d{2})(\d{2})/);
  return date ? `20${date[1]}-${date[2]}-${date[3]}` : '';
};
---

<BaseLayout
  title="全部作品｜phox999 photography"
  description="瀏覽 phox999 photography 的人像攝影作品，包含外拍、棚拍、日系、Cosplay 與城市寫真系列。"
>
  <Header />

  <main class="portfolio-index-page inner-page" id="main-content" tabindex="-1" data-portfolio-archive>
    <section class="portfolio-index-hero container inner-heading" aria-labelledby="portfolio-title">
      <p class="eyebrow">PORTFOLIO</p>
      <h1 id="portfolio-title">全部作品</h1>
      <p class="inner-intro">慢慢看，找到喜歡的畫面與下一次拍攝的方向。</p>
    </section>

    <section class="portfolio-index-content container" aria-labelledby="portfolio-archive-title">
      {portfolioCatalog.length > 0 ? (
        <>
          <div class="archive-controls inner-panel">
            <div class="portfolio-index-toolbar">
              <div><p class="eyebrow">COLLECTIONS</p><h2 id="portfolio-archive-title">作品系列</h2></div>
              <div class="portfolio-filter" role="group" aria-label="篩選作品系列">
                {portfolioCategories.map((category, index) => (
                  <button
                    class={`portfolio-filter__button ${index === 0 ? 'is-active' : ''}`}
                    type="button"
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    aria-label={`${category}，${countFor(category)} 組作品`}
                    aria-controls="portfolio-archive-grid"
                    data-archive-filter
                    data-filter={category}
                  >
                    {category}<span class="portfolio-filter__count" aria-hidden="true">{countFor(category)}</span>
                  </button>
                ))}
              </div>
            </div>

            <div class="archive-tools">
              <div class="archive-search">
                <label class="archive-search__field" for="archive-search-input">
                  <span>搜尋作品</span>
                  <input type="search" id="archive-search-input" placeholder="輸入作品名稱、場景或風格" autocomplete="off" maxlength="160" data-archive-search />
                </label>
                <label class="archive-search__sort" for="archive-sort">
                  <span>排列方式</span>
                  <select id="archive-sort" data-archive-sort>
                    <option value="default">原始編排</option>
                    <option value="date-desc">拍攝時間（新到舊）</option>
                    <option value="date-asc">拍攝時間（舊到新）</option>
                    <option value="title">名稱順序</option>
                  </select>
                </label>
                <button type="button" class="archive-reset" data-archive-reset>清除條件</button>
              </div>
            </div>
          </div>

          <p class="portfolio-index-result" role="status" aria-live="polite" aria-atomic="true" data-archive-result>
            全部 · {portfolioCatalog.length} 組作品
          </p>

          <div class="portfolio-index-grid" id="portfolio-archive-grid">
            {portfolioCatalog.map((collection, index) => (
              <article
                class="portfolio-index-card"
                data-archive-card
                data-category={collection.category}
                data-title={collection.title}
                data-description={collection.description}
                data-date={getShootDate(collection.slug)}
                data-original-index={index}
              >
                <a href={collection.href} aria-label={`瀏覽${collection.title}系列作品`}>
                  <div class="portfolio-index-card__media">
                    <img
                      src={collection.cover}
                      alt={`${collection.title}作品封面`}
                      loading={index < 3 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                    <div class="portfolio-index-card__title">
                      <span>{collection.category}</span>
                      <h3>{collection.title}</h3>
                    </div>
                  </div>
                </a>
              </article>
            ))}
          </div>

          <section class="portfolio-live-detail" data-portfolio-detail hidden aria-labelledby="portfolio-live-title">
            <a class="portfolio-detail-back" href="/portfolio/" data-portfolio-detail-back>← 回全部作品</a>
            <p class="eyebrow" data-portfolio-detail-category></p>
            <h2 id="portfolio-live-title" data-portfolio-detail-title></h2>
            <p class="portfolio-live-detail__description" data-portfolio-detail-description></p>
            <div class="portfolio-live-detail__grid portfolio-justified" data-portfolio-detail-images></div>
          </section>

          <dialog class="portfolio-lightbox" data-lightbox-dialog aria-label="照片放大檢視">
            <div class="portfolio-lightbox__inner">
              <button class="portfolio-lightbox__close" type="button" aria-label="關閉照片" data-lightbox-close>×</button>
              <button class="portfolio-lightbox__nav portfolio-lightbox__nav--prev" type="button" aria-label="上一張照片" data-lightbox-prev>‹</button>
              <img class="portfolio-lightbox__image" src="" alt="" data-lightbox-image />
              <button class="portfolio-lightbox__nav portfolio-lightbox__nav--next" type="button" aria-label="下一張照片" data-lightbox-next>›</button>
              <p class="portfolio-lightbox__count" aria-live="polite" data-lightbox-count></p>
            </div>
          </dialog>

          <div class="portfolio-empty" data-archive-empty hidden>
            <p>找不到符合條件的系列。</p>
            <button type="button" class="archive-reset" data-archive-reset>清除條件，查看全部作品</button>
          </div>
        </>
      ) : (
        <div class="portfolio-index-unavailable inner-panel">
          <p class="portfolio-index-unavailable__title">作品正在整理中。</p>
          <p>也可以到 Instagram 瀏覽公開照片。</p>
          <a class="button button--primary" href="https://www.instagram.com/phox999_/" target="_blank" rel="noopener noreferrer">前往 Instagram</a>
        </div>
      )}
    </section>

    <section class="inner-next container" aria-labelledby="archive-next-title">
      <div>
        <p class="eyebrow">NEXT PROJECT</p>
        <h2 id="archive-next-title">找到喜歡的方向了嗎？</h2>
        <p>把畫面與想法整理在一起，從這裡開始下一次拍攝。</p>
      </div>
      <div class="inner-actions">
        <a class="button button--primary" href="/cooperation/">了解合作方式</a>
        <a class="button button--secondary" href="/#contact">填寫合作意向</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .portfolio-index-page {
    background: linear-gradient(180deg, #f4f9fb 0, #fff 30rem);
  }

  .portfolio-index-hero {
    padding-bottom: clamp(36px, 5vw, 60px);
  }

  .portfolio-index-content {
    padding-bottom: clamp(52px, 7vw, 88px);
  }

  .archive-controls {
    margin-bottom: 24px;
    padding: clamp(20px, 3vw, 34px);
  }

  .portfolio-index-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: 18px;
  }

  .portfolio-index-toolbar h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
  }

  .portfolio-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .portfolio-filter__button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 0;
    border-radius: var(--radius-pill);
    background: #fff;
    padding: 8px 18px;
    color: var(--color-primary-dark);
    font: inherit;
    font-weight: 700;
    text-align: center;
    box-shadow: var(--shadow-soft);
    cursor: pointer;
  }

  .portfolio-filter__button.is-active {
    background: var(--color-primary);
    color: #fff;
    box-shadow: 0 10px 26px rgba(49, 129, 162, .2);
  }

  .portfolio-filter__count {
    font-family: 'Outfit', var(--font-body), sans-serif;
    font-size: 0.84em;
    opacity: 0.8;
  }

  .archive-tools {
    margin: 0;
  }

  .archive-search {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 180px auto;
    gap: 14px;
    align-items: end;
    margin: 0;
    padding: 0;
  }

  .archive-search label {
    display: grid;
    min-width: 0;
    gap: 7px;
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .archive-search input,
  .archive-search select {
    width: 100%;
    min-width: 0;
    min-height: 46px;
    border: 1px solid #dce5e9;
    border-radius: var(--radius-md);
    background: #fff;
    padding: 9px 12px;
    color: var(--color-text);
    font: inherit;
  }

  .archive-search input:focus-visible,
  .archive-search select:focus-visible {
    border-color: #889ba3;
    outline: 2px solid #889ba3;
    outline-offset: 2px;
  }

  .archive-reset {
    min-height: 46px;
    border: 1px solid #dce5e9;
    border-radius: var(--radius-pill);
    background: #fff;
    padding: 9px 16px;
    color: var(--color-muted);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .archive-reset:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
  }

  .portfolio-index-result {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .portfolio-index-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }

  .portfolio-index-card {
    min-width: 0;
  }

  .portfolio-index-card[hidden] {
    display: none;
  }

  :global(.portfolio-index-card > a) {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: #fff;
    box-shadow: var(--shadow-card);
  }

  :global(.portfolio-index-card__media) {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-surface-soft);
  }

  :global(.portfolio-index-card__media::after) {
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.68));
    content: '';
    pointer-events: none;
  }

  :global(.portfolio-index-card__media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms ease;
  }

  :global(.portfolio-index-card:hover .portfolio-index-card__media img),
  :global(.portfolio-index-card:focus-within .portfolio-index-card__media img) {
    transform: scale(1.025);
  }

  :global(.portfolio-index-card__title) {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: 4px;
    padding: 42px 22px 20px;
    color: #fff;
    pointer-events: none;
  }

  :global(.portfolio-index-card__title span) {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  :global(.portfolio-index-card__title h3) {
    color: #fff;
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .portfolio-live-detail {
    border-radius: var(--radius-xl);
    background: #fff;
    padding: clamp(22px, 4vw, 42px);
    box-shadow: var(--shadow-card);
  }

  .portfolio-live-detail[hidden] { display: none; }

  .portfolio-detail-back {
    display: inline-flex;
    margin-bottom: 28px;
    color: var(--color-primary-dark);
    font-weight: 700;
  }

  .portfolio-live-detail h2 {
    margin: 6px 0 10px;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .portfolio-live-detail__description { margin-bottom: 24px; color: var(--color-muted); }



  .portfolio-empty,
  .portfolio-index-unavailable {
    border-radius: var(--radius-xl);
    background: var(--color-surface-soft);
    padding: clamp(24px, 4vw, 40px);
    color: var(--color-muted);
  }

  .portfolio-empty p,
  .portfolio-index-unavailable__title {
    color: var(--color-text);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .portfolio-empty .archive-reset {
    margin-top: 14px;
  }

  .portfolio-index-unavailable > p + p {
    margin-top: 8px;
  }

  .portfolio-index-unavailable .button {
    margin-top: 20px;
  }

  @media (max-width: 900px) {
    .portfolio-index-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .archive-search {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .archive-search__field {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .portfolio-index-toolbar {
      align-items: flex-start;
      flex-direction: column;
    }

    .archive-search {
      grid-template-columns: minmax(0, 1fr);
    }

    .archive-search__field {
      grid-column: auto;
    }

    .portfolio-index-grid {
      grid-template-columns: minmax(0, 1fr);
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-index-card__media img {
      transition: none;
    }
  }
</style>

<script>
  import { loadPublishedPortfolio } from '../../lib/portfolio-content';

  const getShootDate = (slug: string) => {
    const date = slug.match(/^(\d{2})(\d{2})(\d{2})/);
    return date ? `20${date[1]}-${date[2]}-${date[3]}` : '';
  };

  const archive = document.querySelector<HTMLElement>('[data-portfolio-archive]');

  if (archive) {
    const buttons = Array.from(archive.querySelectorAll<HTMLButtonElement>('[data-archive-filter]'));
    let cards = Array.from(archive.querySelectorAll<HTMLElement>('[data-archive-card]'));
    const grid = archive.querySelector<HTMLElement>('#portfolio-archive-grid');
    const empty = archive.querySelector<HTMLElement>('[data-archive-empty]');
    const result = archive.querySelector<HTMLElement>('[data-archive-result]');
    const search = archive.querySelector<HTMLInputElement>('[data-archive-search]');
    const sort = archive.querySelector<HTMLSelectElement>('[data-archive-sort]');
    const controls = archive.querySelector<HTMLElement>('.archive-controls');
    const detail = archive.querySelector<HTMLElement>('[data-portfolio-detail]');
    const detailTitle = archive.querySelector<HTMLElement>('[data-portfolio-detail-title]');
    const detailCategory = archive.querySelector<HTMLElement>('[data-portfolio-detail-category]');
    const detailDescription = archive.querySelector<HTMLElement>('[data-portfolio-detail-description]');
    const detailImages = archive.querySelector<HTMLElement>('[data-portfolio-detail-images]');
    const lightbox = archive.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
    const lightboxImage = archive.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const lightboxCount = archive.querySelector<HTMLElement>('[data-lightbox-count]');
    let lightboxImages: HTMLImageElement[] = [];
    let currentLightboxIndex = 0;
    let publishedCollections: Awaited<ReturnType<typeof loadPublishedPortfolio>> = null;
    let category = '全部';

    const updateLightbox = (index: number) => {
      if (!lightboxImage || !lightboxImages.length) return;
      currentLightboxIndex = (index + lightboxImages.length) % lightboxImages.length;
      const currentImage = lightboxImages[currentLightboxIndex];
      lightboxImage.src = currentImage.currentSrc || currentImage.src;
      lightboxImage.alt = currentImage.alt || '';
      if (lightboxCount) {
        lightboxCount.textContent = String(currentLightboxIndex + 1) + ' / ' + String(lightboxImages.length);
      }
    };

    const openLightbox = (index: number) => {
      if (!lightbox || !detailImages || !lightboxImage) return;
      lightboxImages = Array.from(detailImages.querySelectorAll<HTMLImageElement>('.portfolio-justified__button img'));
      if (!lightboxImages.length) return;
      updateLightbox(index);
      if (typeof lightbox.showModal === 'function') lightbox.showModal();
      else lightbox.setAttribute('open', '');
    };

    const closeLightbox = () => {
      if (!lightbox) return;
      if (lightbox.open && typeof lightbox.close === 'function') lightbox.close();
      else lightbox.removeAttribute('open');
    };

    detailImages?.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest<HTMLButtonElement>('[data-lightbox-open]');
      if (button) openLightbox(Number(button.dataset.lightboxIndex || 0));
    });

    archive.querySelector<HTMLButtonElement>('[data-lightbox-close]')?.addEventListener('click', closeLightbox);
    archive.querySelector<HTMLButtonElement>('[data-lightbox-prev]')?.addEventListener('click', () => updateLightbox(currentLightboxIndex - 1));
    archive.querySelector<HTMLButtonElement>('[data-lightbox-next]')?.addEventListener('click', () => updateLightbox(currentLightboxIndex + 1));

    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    lightbox?.addEventListener('close', () => {
      if (!lightboxImage) return;
      lightboxImage.src = '';
      lightboxImage.alt = '';
    });

    window.addEventListener('keydown', (event) => {
      if (!lightbox?.open) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        updateLightbox(currentLightboxIndex - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        updateLightbox(currentLightboxIndex + 1);
      }
    });

    const showCollection = (slug: string | null) => {
      const collection = publishedCollections?.find((item) => item.slug === slug);
      if (!detail || !grid || !controls) return;
      if (!collection) {
        detail.hidden = true;
        grid.hidden = false;
        controls.hidden = false;
        if (slug) {
          if (result) result.textContent = '找不到這組作品。';
        }
        return;
      }
      if (detailTitle) detailTitle.textContent = collection.title;
      if (detailCategory) detailCategory.textContent = collection.category;
      if (detailDescription) detailDescription.textContent = collection.description;
      if (detailImages) {
        detailImages.replaceChildren(...collection.images.map((src, index) => {
          const figure = document.createElement('figure');
          figure.className = 'portfolio-justified__item';
          const button = document.createElement('button');
          button.className = 'portfolio-justified__button';
          button.type = 'button';
          button.dataset.lightboxOpen = '';
          button.dataset.lightboxIndex = String(index);
          button.setAttribute('aria-label', '開啟 ' + collection.title + ' 照片 ' + (index + 1));
          const image = document.createElement('img');
          image.src = src;
          image.alt = `${collection.title}作品照片 ${index + 1}`;
          image.loading = index < 3 ? 'eager' : 'lazy';
          image.decoding = 'async';
          button.append(image);
          figure.append(button);
          return figure;
        }));
      }
      detail.hidden = false;
      grid.hidden = true;
      controls.hidden = true;
      if (empty) empty.hidden = true;
      if (result) result.textContent = `${collection.title} · ${collection.images.length} 張照片`;
      detail.scrollIntoView({ block: 'start' });
    };

    const apply = () => {
      const query = (search?.value || '').trim().toLocaleLowerCase('zh-Hant');
      const order = sort?.value || 'default';
      let visibleCount = 0;

      cards.forEach((card) => {
        const matchesCategory = category === '全部' || card.dataset.category === category;
        const searchable = `${card.dataset.title || ''} ${card.dataset.description || ''} ${card.dataset.category || ''}`.toLocaleLowerCase('zh-Hant');
        const visible = matchesCategory && (!query || searchable.includes(query));
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      if (grid) {
        const sorted = [...cards].sort((left, right) => {
          if (order === 'title') {
            return (left.dataset.title || '').localeCompare(right.dataset.title || '', 'zh-Hant', { numeric: true });
          }
          if (order === 'date-desc' || order === 'date-asc') {
            const leftDate = left.dataset.date || '';
            const rightDate = right.dataset.date || '';
            if (!leftDate && rightDate) return 1;
            if (leftDate && !rightDate) return -1;
            return order === 'date-desc'
              ? rightDate.localeCompare(leftDate)
              : leftDate.localeCompare(rightDate);
          }
          return Number(left.dataset.originalIndex) - Number(right.dataset.originalIndex);
        });
        sorted.forEach((card) => grid.append(card));
      }

      buttons.forEach((button) => {
        const active = button.dataset.filter === category;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      if (empty) empty.hidden = visibleCount > 0;
      if (result) result.textContent = `${category}${query ? ` · 搜尋「${query}」` : ''} · ${visibleCount} 組作品`;
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        category = button.dataset.filter || '全部';
        apply();
      });
    });

    search?.addEventListener('input', apply);
    sort?.addEventListener('change', apply);
    archive.querySelectorAll<HTMLButtonElement>('[data-archive-reset]').forEach((button) => {
      button.addEventListener('click', () => {
        category = '全部';
        if (search) search.value = '';
        if (sort) sort.value = 'default';
        apply();
      });
    });

    archive.querySelector<HTMLAnchorElement>('[data-portfolio-detail-back]')?.addEventListener('click', (event) => {
      event.preventDefault();
      const url = new URL(window.location.href);
      url.searchParams.delete('collection');
      window.history.pushState({}, '', url);
      showCollection(null);
      apply();
    });

    window.addEventListener('popstate', () => showCollection(new URL(window.location.href).searchParams.get('collection')));

    apply();

    const hydratePublishedPortfolio = async () => {
      publishedCollections = await loadPublishedPortfolio();
      if (!publishedCollections || !grid) return;
      grid.replaceChildren(...publishedCollections.map((collection, index) => {
        const article = document.createElement('article');
        article.className = 'portfolio-index-card';
        article.dataset.archiveCard = '';
        article.dataset.category = collection.category;
        article.dataset.title = collection.title;
        article.dataset.description = collection.description;
        article.dataset.date = getShootDate(collection.slug);
        article.dataset.originalIndex = String(index);
        const link = document.createElement('a');
        link.href = collection.href;
        link.setAttribute('aria-label', `瀏覽${collection.title}系列作品`);
        const media = document.createElement('div');
        media.className = 'portfolio-index-card__media';
        const image = document.createElement('img');
        image.src = collection.cover;
        image.alt = `${collection.title}作品封面`;
        image.loading = index < 3 ? 'eager' : 'lazy';
        image.decoding = 'async';
        const overlay = document.createElement('div');
        overlay.className = 'portfolio-index-card__title';
        const categoryLabel = document.createElement('span');
        categoryLabel.textContent = collection.category;
        const title = document.createElement('h3');
        title.textContent = collection.title;
        overlay.append(categoryLabel, title);
        media.append(image, overlay);
        link.append(media);
        article.append(link);
        return article;
      }));
      cards = Array.from(archive.querySelectorAll<HTMLElement>('[data-archive-card]'));
      buttons.forEach((button) => {
        const filter = button.dataset.filter || '全部';
        const count = publishedCollections!.filter((item) => filter === '全部' || item.category === filter).length;
        const countLabel = button.querySelector<HTMLElement>('.portfolio-filter__count');
        if (countLabel) countLabel.textContent = String(count);
        button.setAttribute('aria-label', `${filter}，${count} 組作品`);
      });
      apply();
      showCollection(new URL(window.location.href).searchParams.get('collection'));
    };
    void hydratePublishedPortfolio();
  }
</script>
