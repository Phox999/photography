---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title="關於我｜phox999 photography"
  description="認識 phox999 攝影師小蔡：在台北拍攝人像，重視事前溝通、現場引導，以及自然、有故事感的畫面。"
>
  <Header />

  <main class="inner-page about-page" id="main-content" tabindex="-1">
    <section class="container inner-panel about-profile" aria-labelledby="about-title">
      <figure class="about-profile__portrait">
        <img src="/assets/Profile-pic.jpg" alt="小蔡的人像照片" width="900" height="900" fetchpriority="high" />
      </figure>

      <div class="inner-heading about-profile__copy">
        <p class="eyebrow">ABOUT</p>
        <h1 id="about-title">嗨，我是小蔡。</h1>
        <p class="about-profile__lead">在台北拍人像，也是一名有設計背景的攝影師。</p>
        <p class="inner-intro">我喜歡自然、有故事的畫面。從事前討論到現場引導，一起找到舒服的拍攝節奏。第一次拍攝也沒關係，主題、服裝與場景都能一起討論。</p>
        <div class="about-profile__actions">
          <a class="button button--primary" href={siteConfig.inquiryUrl}>填寫合作意向</a>
          <a class="text-link" href={siteConfig.portfolioUrl}>看看作品</a>
        </div>
      </div>

      <dl class="about-profile__facts" aria-label="關於小蔡">
        <div><dt>人像合作</dt><dd>80+</dd></div>
        <div><dt>畫面企劃與構成</dt><dd>設計背景</dd></div>
        <div><dt>人像創作</dt><dd>台北</dd></div>
      </dl>
    </section>

    <section class="container inner-panel about-approach" aria-labelledby="approach-title">
      <div>
        <p class="eyebrow">HOW I WORK</p>
        <h2 id="approach-title">舒服地做自己，<br />就是好的開始。</h2>
        <p class="inner-intro">不用先學會擺姿勢。我們從你的想法出發，一起完成喜歡的畫面。</p>
      </div>
      <ol class="about-approach__steps">
        <li>
          <span class="about-approach__number" aria-hidden="true">01</span>
          <h3>先聊聊想拍什麼</h3>
          <p>主題、服裝與場景會先一起確認，讓拍攝當天有方向，也留一點即興的空間。</p>
        </li>
        <li>
          <span class="about-approach__number" aria-hidden="true">02</span>
          <h3>現場慢慢找到感覺</h3>
          <p>不知道手要放哪、表情怎麼做都沒關係，我會協助動作、走位與畫面調整。</p>
        </li>
        <li>
          <span class="about-approach__number" aria-hidden="true">03</span>
          <h3>讓彼此的想法進入作品</h3>
          <p>我會在意你的想法，也會從攝影與設計角度提供建議，找到雙方都喜歡的畫面。</p>
        </li>
      </ol>
    </section>

    <section class="container inner-next" aria-labelledby="about-next-title">
      <div>
        <p class="eyebrow">LET’S CREATE</p>
        <h2 id="about-next-title">有想拍的畫面嗎？</h2>
        <p>帶著一點想法就能開始，其他細節我們再一起聊。</p>
      </div>
      <a class="button button--primary" href={siteConfig.inquiryUrl}>填寫合作意向</a>
    </section>
  </main>

  <Footer />
</BaseLayout>
