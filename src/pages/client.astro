---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/inner-pages.css';
---
<BaseLayout title="專屬相簿｜phox999 photography" description="透過攝影師提供的邀請連結，瀏覽照片、確認選片與下載已交付的作品。" noindex={true}>
  <Header />
  <main id="main-content" class="cg-page inner-page" tabindex="-1">
    <div class="container">
    <header class="cg-intro inner-heading"><p class="inner-kicker">專屬相簿</p><h1 id="cg-title">一起完成，最後的選擇。</h1><p class="inner-intro" id="cg-intro-copy">使用攝影師提供的專屬邀請連結，查看這次合作的照片。</p></header>
    <section class="cg-gate" id="cg-gate"><h2 id="cg-gate-title">請從邀請連結進入</h2><p id="cg-gate-message">開啟攝影師提供的完整連結，即可查看這次合作的照片。</p><div class="cg-actions"><a class="button button--primary" href="mailto:chuajinglun@ymail.com">聯繫攝影師</a><button class="button button--secondary" type="button" id="cg-retry" hidden>重新載入相簿</button></div></section>
    <p class="cg-status" id="cg-status" role="status" aria-live="polite"></p>
    <section id="cg-workspace" hidden aria-label="相簿選片工作區">
      <ol class="cg-timeline" aria-label="目前進度"><li id="cg-stage-open"><span>01</span>瀏覽相簿</li><li id="cg-stage-select"><span>02</span>確認選片</li><li id="cg-stage-deliver"><span>03</span>作品交付</li></ol>
      <div class="cg-meta"><p id="cg-album-meta"></p><button class="cg-text-button" id="cg-refresh" type="button">更新照片連結</button></div>
      <div class="cg-workspace">
        <div><div class="cg-toolbar"><h2>這次的畫面</h2><button class="cg-filter" type="button" id="cg-filter" aria-pressed="false">只看已選</button></div><p class="cg-empty" id="cg-empty" hidden>目前沒有可顯示的照片。</p><div class="cg-grid" id="cg-grid"></div></div>
        <aside class="cg-summary" aria-labelledby="cg-summary-title"><p class="eyebrow">THE FINAL PICKS</p><h2 id="cg-summary-title">你的選片清單</h2><p id="cg-count" role="status" aria-live="polite"></p><p class="cg-help" id="cg-selection-help">先點照片上的愛心挑選，再一起確認清單。</p><ol id="cg-selected-list" class="cg-selected-list"></ol><label for="cg-note">想補充的細節</label><textarea id="cg-note" rows="4" maxlength="2000" placeholder="說明這次選片的整體想法；每張照片也能分別加註。"></textarea><p class="cg-help" id="cg-note-help">最多 2,000 字。送出前，請確認照片與備註。</p><p class="cg-help" id="cg-draft-status" role="status" aria-live="polite"></p><div class="cg-draft-actions"><button class="cg-text-button" type="button" id="cg-save-retry" hidden>再試儲存草稿</button><button class="cg-text-button" type="button" id="cg-draft-reload" hidden>放棄本頁草稿，載入已儲存版本</button></div><button class="button button--primary" type="button" id="cg-review">檢查並確認選片</button><p id="cg-submitted" class="cg-receipt" hidden></p><p class="cg-help" id="cg-download-help" hidden>可下載的作品會在照片下方顯示按鈕。連結短期有效；無法開啟時可重新取得。</p><div id="cg-batch" hidden><label for="cg-batch-size">每批下載張數</label><select id="cg-batch-size"><option value="20">20 張</option><option value="10">10 張</option><option value="5">5 張</option><option value="1">1 張</option></select><p class="cg-help">ZIP 每批最多 20 張、32 MiB。每次點擊下載一批；檔案過大可減少張數或改用單張下載。</p><button class="button button--secondary" id="cg-download-selected" type="button">下載已選成品 ZIP</button><button class="button button--secondary" id="cg-download-all" type="button">下載全部成品 ZIP</button><p class="cg-help" id="cg-batch-status" role="status"></p></div><a class="cg-contact" href="mailto:chuajinglun@ymail.com">需要調整？聯繫攝影師</a></aside>
      </div>
    </section>
    <noscript><p class="cg-gate">相簿需要 JavaScript 才能載入。私人照片不會包含在此頁面的 HTML 中。</p></noscript>
    </div>
  </main>
  <dialog class="cg-dialog cg-review-dialog" id="cg-review-dialog" aria-labelledby="cg-review-title"><h2 id="cg-review-title">再看一次，這些就是你的選擇。</h2><p id="cg-review-copy">送出後會鎖定清單。若需要修改，請聯繫攝影師。</p><ol id="cg-review-list"></ol><p class="cg-review-note" id="cg-review-note"></p><p role="status" id="cg-review-status"></p><div class="cg-actions"><button class="button button--secondary" type="button" id="cg-review-cancel">返回調整</button><button class="button button--primary" type="button" id="cg-confirm">確認送出選片</button></div></dialog>
  <dialog class="cg-dialog cg-lightbox" id="cg-lightbox" aria-labelledby="cg-lightbox-title"><div class="cg-lightbox-top"><p id="cg-lightbox-title"></p><button class="cg-icon-button" type="button" id="cg-lightbox-close" aria-label="關閉照片">×</button></div><img id="cg-lightbox-image" alt="" referrerpolicy="no-referrer" /><div class="cg-lightbox-controls"><button type="button" class="cg-icon-button" id="cg-previous" aria-label="上一張照片">←</button><button type="button" class="button button--primary" id="cg-lightbox-select" aria-pressed="false">選取照片</button><button type="button" class="cg-icon-button" id="cg-next" aria-label="下一張照片">→</button></div></dialog>
  <Footer />
</BaseLayout>

<script>
  import { ClientGalleryError, invitationFromFragment, requestClientGallery, safePhotoUrl, requestGalleryArchive, DraftSaver, type ClientDraft, type ClientGallery, type ClientPhoto, type ClientSelection } from '../lib/client-gallery-client';
  const $ = <T extends Element = HTMLElement>(id: string) => document.getElementById(id) as T;
  const hasInvitation = new URLSearchParams(location.hash.replace(/^#/, '')).has('token');
  let token = invitationFromFragment(location.hash);
  if (location.hash) history.replaceState(null, '', `${location.pathname}${location.search}`);
  let data: ClientGallery | null = null;
  let selected: string[] = [];
  let photoNotes: Record<string, string> = {};
  let saveTimer = 0;
  let archiveBusy = false;
  const batchCursor = { selected: 0, all: 0 };
  const saver = new DraftSaver(async body => (await requestClientGallery<{ draft: ClientDraft }>('/api/client/draft', token, body)).draft, renderDraftState);
  let busy = false;
  let filterSelected = false;
  let lightboxId = '';
  const note = $<HTMLTextAreaElement>('cg-note');
  const review = $<HTMLDialogElement>('cg-review-dialog');
  const lightbox = $<HTMLDialogElement>('cg-lightbox');
  const status = (text: string) => { $('cg-status').textContent = text; };
  const locked = () => Boolean(data?.selection?.submittedAt) || data?.gallery.status === 'delivered';
  const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = '') => { const node = document.createElement(tag); node.className = className; node.textContent = text; return node; };
  function draftContent() { return { photoIds: [...selected], photoNotes: Object.fromEntries(selected.filter(id => photoNotes[id]?.trim()).map(id => [id, photoNotes[id].trim()])), note: note.value.trim() }; }
  function renderDraftState() {
    if (!data || locked()) { $('cg-draft-status').textContent = ''; $('cg-save-retry').hidden = true; $('cg-draft-reload').hidden = true; return; }
    $('cg-draft-status').textContent = saver.error ? `${saver.error} 本頁內容仍保留。` : saver.saving ? '正在儲存草稿…' : saver.dirty ? '尚有未儲存的變更。' : saver.version ? '草稿已儲存；再次開啟同一邀請可繼續。' : '選片與備註會自動儲存。';
    $('cg-save-retry').hidden = !saver.error || saver.conflict;
    $('cg-draft-reload').hidden = !saver.error;
    $<HTMLButtonElement>('cg-save-retry').disabled = busy || saver.saving;
    $<HTMLButtonElement>('cg-draft-reload').disabled = busy || saver.saving;
  }
  function queueSave() {
    if (!data || locked()) return;
    saver.update(draftContent()); window.clearTimeout(saveTimer);
    // A failed/conflicting request pauses automatic writes until an explicit retry/reload.
    if (!saver.error && !saver.conflict) saveTimer = window.setTimeout(() => { void saver.flush(); }, 750);
    renderDraftState();
  }
  function renderSummary() {
    if (!data) return;
    const photoTitles = new Map(data.photos.map(photo => [photo.id, photo.title]));
    $('cg-count').textContent = `已選 ${selected.length} / ${data.gallery.selectionLimit} 張`;
    const list = $('cg-selected-list'); list.replaceChildren();
    for (const id of selected) { const item = make('li', '', photoTitles.get(id) || `已隱藏照片（${id.slice(-8)}）`); if (!photoTitles.has(id) && !locked()) { const remove = make('button', 'cg-text-button', '移除'); remove.type = 'button'; remove.disabled = busy; remove.addEventListener('click', () => toggle(id)); item.append(remove); } list.append(item); }
    note.disabled = busy || locked();
    $<HTMLButtonElement>('cg-review').disabled = busy || locked() || selected.length === 0;
    $('cg-review').hidden = locked();
    $('cg-selection-help').textContent = data.gallery.status === 'delivered' ? '攝影師已開放交件，選片清單不再接受修改。' : data.selection ? '清單已確認；需要修改時，請直接聯繫攝影師。' : '選片與每張備註會自動儲存。確認送出後，清單將鎖定。';
    $('cg-submitted').hidden = !data.selection;
    if (data.selection) $('cg-submitted').textContent = `選片已確認 · ${new Date(data.selection.submittedAt).toLocaleString('zh-TW', { timeZone: 'Asia/Taipei' })}`;
    $('cg-download-help').hidden = data.gallery.status !== 'delivered';
    $('cg-batch').hidden = data.gallery.status !== 'delivered' || !data.gallery.allowDownloads;
    renderBatch(); renderDraftState();
    $('cg-stage-open').dataset.active = 'true';
    $('cg-stage-select').dataset.active = String(Boolean(data.selection));
    $('cg-stage-deliver').dataset.active = String(data.gallery.status === 'delivered');
    $('cg-stage-select').setAttribute('aria-current', !data.selection && data.gallery.status === 'proofing' ? 'step' : 'false');
    $('cg-stage-deliver').setAttribute('aria-current', data.gallery.status === 'delivered' ? 'step' : 'false');
  }
  function renderPhotos() {
    if (!data) return;
    const grid = $('cg-grid'); grid.replaceChildren();
    const visible = data.photos.filter(photo => !filterSelected || selected.includes(photo.id));
    $('cg-empty').hidden = visible.length > 0;
    $('cg-empty').textContent = filterSelected ? '還沒有已選照片。切回全部照片，就能開始挑選。' : '攝影師尚未放入可瀏覽的照片。請稍後重新載入，或直接聯繫確認。';
    for (const photo of visible) {
      const article = make('article', 'cg-card'); article.dataset.selected = String(selected.includes(photo.id));
      const media = make('div', 'cg-card-media');
      const open = make('button', 'cg-photo-open'); open.type = 'button'; open.setAttribute('aria-label', `放大查看 ${photo.title}`);
      const img = make('img'); img.src = safePhotoUrl(photo.previewUrl, location.origin); img.alt = photo.title; img.loading = 'lazy'; img.decoding = 'async'; img.referrerPolicy = 'no-referrer';
      img.addEventListener('error', () => { open.setAttribute('aria-label', `${photo.title} 圖片未能載入，請更新照片連結`); img.alt = `${photo.title}｜圖片未能載入，請更新照片連結`; });
      open.append(img); open.addEventListener('click', () => openPhoto(photo.id));
      const pick = make('button', 'cg-pick', selected.includes(photo.id) ? '♥' : '♡'); pick.type = 'button'; pick.dataset.photoId = photo.id; pick.setAttribute('aria-label', `選取 ${photo.title}`); pick.setAttribute('aria-pressed', String(selected.includes(photo.id))); pick.disabled = busy || locked(); pick.addEventListener('click', () => toggle(photo.id));
      media.append(open, pick); article.append(media, make('h3', '', photo.title));
      if (selected.includes(photo.id)) {
        const label = make('label', 'cg-photo-note-label', '這張照片的備註（最多 500 字）'); label.htmlFor = `note-${photo.id}`;
        const input = make('textarea', 'cg-photo-note'); input.id = label.htmlFor; input.maxLength = 500; input.rows = 2; input.value = photoNotes[photo.id] || ''; input.disabled = busy || locked();
        input.addEventListener('input', () => { photoNotes[photo.id] = input.value; queueSave(); }); article.append(label, input);
      }
      if (data.gallery.status === 'delivered' && data.gallery.allowDownloads && photo.downloadable) {
        const download = make('button', 'cg-text-button', '下載成品 ↓'); download.type = 'button'; download.disabled = busy; download.addEventListener('click', () => void downloadPhoto(photo, download)); article.append(download);
      }
      grid.append(article);
    }
  }
  function render() { renderPhotos(); renderSummary(); if (lightbox.open) renderLightbox(); }
  function toggle(id: string) {
    if (!data || busy || locked()) return;
    if (selected.includes(id)) { selected = selected.filter(value => value !== id); delete photoNotes[id]; }
    else if (selected.length < data.gallery.selectionLimit) selected.push(id);
    else { status(`最多可選 ${data.gallery.selectionLimit} 張。請先取消一張，再加入新的照片。`); return; }
    queueSave(); render();
    status(`已${selected.includes(id) ? '加入' : '移除'}選片；目前 ${selected.length} 張。尚未送出。`);
    if (lightbox.open) $<HTMLButtonElement>('cg-lightbox-select').focus({ preventScroll: true });
    else ($('cg-grid').querySelector<HTMLButtonElement>(`[data-photo-id="${id}"]`) || $<HTMLButtonElement>('cg-filter')).focus({ preventScroll: true });
  }
  function renderLightbox() {
    const photo = data?.photos.find(value => value.id === lightboxId); if (!photo) return;
    $('cg-lightbox-title').textContent = photo.title;
    const img = $<HTMLImageElement>('cg-lightbox-image'); img.src = safePhotoUrl(photo.previewUrl, location.origin); img.alt = photo.title;
    const pick = $<HTMLButtonElement>('cg-lightbox-select'); pick.disabled = busy || locked(); pick.textContent = selected.includes(photo.id) ? '♥ 已選取' : '♡ 選取照片'; pick.setAttribute('aria-pressed', String(selected.includes(photo.id)));
  }
  function openPhoto(id: string) { lightboxId = id; renderLightbox(); lightbox.showModal(); window.dispatchEvent(new CustomEvent('phox999:lightbox-open')); }
  function stepPhoto(direction: number) { if (!data?.photos.length) return; const index = data.photos.findIndex(value => value.id === lightboxId); lightboxId = data.photos[(index + direction + data.photos.length) % data.photos.length].id; renderLightbox(); }
  async function downloadPhoto(photo: ClientPhoto, button: HTMLButtonElement) {
    button.disabled = true;
    try {
      const response = await requestClientGallery<{url: string}>('/api/client/download', token, { photoId: photo.id });
      const url = safePhotoUrl(response.url, location.origin); if (!url) throw new ClientGalleryError(502);
      const anchor = make('a'); anchor.href = url; anchor.download = ''; anchor.rel = 'noopener noreferrer'; anchor.referrerPolicy = 'no-referrer'; anchor.target = '_blank'; document.body.append(anchor); anchor.click(); anchor.remove();
      status('已開啟短期有效的下載連結；若未開始下載，可稍後重試。');
    } catch (error) { status(error instanceof Error ? error.message : '無法取得下載連結。'); }
    finally { button.disabled = false; }
  }
  function renderBatch() {
    if (!data) return;
    for (const kind of ['selected', 'all'] as const) {
      const count = data.photos.filter(p => p.downloadable && (kind === 'all' || selected.includes(p.id))).length;
      const button = $<HTMLButtonElement>(`cg-download-${kind}`);
      button.disabled = archiveBusy || busy || count === 0;
      const cursor = Math.min(batchCursor[kind], count); const amount = Number($<HTMLSelectElement>('cg-batch-size').value);
      button.textContent = `${kind === 'all' ? '全部' : '已選'}成品 ZIP · ${count ? `${cursor === count ? 1 : cursor + 1}–${Math.min((cursor === count ? 0 : cursor) + amount, count)} / ${count}` : '0 張'}`;
    }
  }
  async function downloadBatch(kind: 'selected' | 'all') {
    if (!data || archiveBusy || busy || data.gallery.status !== 'delivered' || !data.gallery.allowDownloads) return;
    const candidates = data.photos.filter(p => p.downloadable && (kind === 'all' || selected.includes(p.id)));
    const amount = Number($<HTMLSelectElement>('cg-batch-size').value); const start = batchCursor[kind] >= candidates.length ? 0 : batchCursor[kind];
    const ids = candidates.slice(start, start + amount).map(p => p.id); if (!ids.length) return;
    archiveBusy = true; renderBatch(); $('cg-batch-status').textContent = `正在準備第 ${start + 1}–${start + ids.length} 張…`;
    try {
      const blob = await requestGalleryArchive(token, ids); const url = URL.createObjectURL(blob);
      const anchor = make('a'); anchor.href = url; anchor.download = `photos-${start + 1}-${start + ids.length}.zip`; document.body.append(anchor); anchor.click(); anchor.remove(); window.setTimeout(() => URL.revokeObjectURL(url), 60_000);
      batchCursor[kind] = start + ids.length;
      $('cg-batch-status').textContent = `第 ${start + 1}–${start + ids.length} 張已準備下載。${batchCursor[kind] < candidates.length ? '再次點擊可下載下一批。' : '這組照片已全部分批提供；再次點擊可從頭下載。'}`;
    } catch (error) { $('cg-batch-status').textContent = error instanceof Error ? error.message : '下載失敗，這批尚未完成。'; }
    finally { archiveBusy = false; renderBatch(); }
  }
  function apply(result: ClientGallery, replaceDraft = false) {
    const firstLoad = data === null;
    if (data && result.selection && saver.dirty && !replaceDraft) { saver.stop(); saver.conflict = true; saver.error = '選片已在另一個視窗確認。請核對本頁內容，再載入已確認版本。'; render(); return; }
    data = result;
    if (result.selection) {
      selected = [...new Set(result.selection.photoIds)]; photoNotes = { ...result.selection.photoNotes }; note.value = result.selection.note; saver.stop();
    } else if (firstLoad || replaceDraft) {
      const draft = result.draft; selected = draft ? [...draft.photoIds] : []; photoNotes = { ...(draft?.photoNotes || {}) }; note.value = draft?.note || '';
      saver.reset(draftContent(), draft?.version || 0);
    }
    // Updating expiring previews preserves pending local changes and version.
    $('cg-title').textContent = result.gallery.title;
    $('cg-intro-copy').textContent = '照片、選片與交件，集中在這次合作的專屬空間。';
    $('cg-album-meta').textContent = `${result.photos.length} 張照片 · ${result.gallery.status === 'delivered' ? '已開放交件' : '選片階段'}${result.gallery.expiresAt ? ` · 邀請有效至 ${new Date(result.gallery.expiresAt).toLocaleDateString('zh-TW', { timeZone: 'Asia/Taipei' })}` : ''}`;
    $('cg-gate').hidden = true; $('cg-workspace').hidden = false; render();
  }
  async function load(replaceDraft = false) {
    if (!token || busy || saver.saving) return;
    window.clearTimeout(saveTimer);
    busy = true; status('正在載入專屬相簿…'); render(); $<HTMLButtonElement>('cg-refresh').disabled = true; $<HTMLButtonElement>('cg-retry').disabled = true;
    try { const result = await requestClientGallery<ClientGallery>('/api/client/gallery', token); apply(result, replaceDraft); status('相簿已載入。'); }
    catch (error) {
      const message = error instanceof Error ? error.message : '相簿無法載入。'; status(message);
      if (!data || (error instanceof ClientGalleryError && [401, 403, 404, 410].includes(error.status))) {
        // Keep unsaved content in memory while access is unavailable; never overwrite it.
        saver.error = message; $('cg-workspace').hidden = true; $('cg-gate').hidden = false; $('cg-gate-title').textContent = '目前無法開啟相簿'; $('cg-gate-message').textContent = message; $('cg-retry').hidden = false; lightbox.close();
      }
    } finally { busy = false; $<HTMLButtonElement>('cg-refresh').disabled = false; $<HTMLButtonElement>('cg-retry').disabled = false; render(); if (saver.dirty && !saver.error && !locked()) queueSave(); }
  }
  note.addEventListener('input', queueSave);
  $('cg-save-retry').addEventListener('click', () => { void saver.flush(); });
  $('cg-draft-reload').addEventListener('click', () => { if (window.confirm('本頁尚未儲存的選片與備註將被放棄，改為載入已儲存版本。確定繼續？')) void load(true); });
  $('cg-download-selected').addEventListener('click', () => { void downloadBatch('selected'); });
  $('cg-download-all').addEventListener('click', () => { void downloadBatch('all'); });
  $('cg-batch-size').addEventListener('change', renderBatch);
  $('cg-filter').addEventListener('click', () => { filterSelected = !filterSelected; $('cg-filter').setAttribute('aria-pressed', String(filterSelected)); $('cg-filter').textContent = filterSelected ? '顯示全部照片' : '只看已選'; renderPhotos(); });
  $('cg-refresh').addEventListener('click', () => void load()); $('cg-retry').addEventListener('click', () => void load());
  $('cg-lightbox-close').addEventListener('click', () => lightbox.close());
  lightbox.addEventListener('close', () => { const previousId = lightboxId; lightboxId = ''; window.dispatchEvent(new CustomEvent('phox999:lightbox-close')); const pick = $('cg-grid').querySelector<HTMLButtonElement>(`[data-photo-id="${previousId}"]`); (pick?.closest('.cg-card')?.querySelector<HTMLButtonElement>('.cg-photo-open') || $<HTMLButtonElement>('cg-filter')).focus({ preventScroll: true }); });
  lightbox.addEventListener('keydown', (event) => { if (event.key === 'ArrowLeft') { event.preventDefault(); stepPhoto(-1); } if (event.key === 'ArrowRight') { event.preventDefault(); stepPhoto(1); } });
  $('cg-previous').addEventListener('click', () => stepPhoto(-1)); $('cg-next').addEventListener('click', () => stepPhoto(1)); $('cg-lightbox-select').addEventListener('click', () => toggle(lightboxId));
  $('cg-review').addEventListener('click', () => {
    if (!data || busy || locked() || !selected.length) return;
    $('cg-review-list').replaceChildren(...data.photos.filter(photo => selected.includes(photo.id)).map(photo => make('li', '', `${photo.title}${photoNotes[photo.id]?.trim() ? ` — ${photoNotes[photo.id].trim()}` : ''}`)));
    $('cg-review-note').textContent = note.value.trim() || '沒有補充備註。'; $('cg-review-status').textContent = '';
    $('cg-review-copy').textContent = `即將確認 ${selected.length} 張照片。送出後清單會鎖定，若需修改請聯繫攝影師。`;
    $('cg-confirm').textContent = '確認送出選片'; review.showModal();
  });
  $('cg-review-cancel').addEventListener('click', () => review.close());
  review.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
  $('cg-confirm').addEventListener('click', async () => {
    if (!data || busy || locked() || selected.length === 0) return;
    window.clearTimeout(saveTimer);
