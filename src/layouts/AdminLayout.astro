---
import '../styles/global.css';
import '../styles/admin.css';
const { title = '管理後台', current = '', login = false } = Astro.props;
const links = [
  { href: '/admin/', label: '合作管理', key: 'inquiries', number: '01' },
  { href: '/admin/availability/', label: '拍攝檔期', key: 'availability', number: '06' },
  { href: '/admin/content/', label: '網站內容', key: 'content', number: '02' },
  { href: '/admin/audit/', label: '操作紀錄', key: 'audit', number: '03' },
  { href: '/admin/galleries/', label: '選片交件', key: 'galleries', number: '04' },
  { href: '/admin/feedback/', label: '合作回饋', key: 'feedback', number: '05' },
];
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#63badf" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}｜phox999 管理後台</title>
  </head>
  <body class:list={['admin-body', { 'admin-body--login': login }]}>
    <a class="admin-skip" href="#admin-main">跳到主要內容</a>
    <div class="admin-shell" data-admin-shell={login ? 'login' : 'protected'}>
      <header class="admin-header">
        <a class="admin-brand" href={login ? '/' : '/admin/'} aria-label="Phox999 管理首頁">Phox999<span>photography</span></a>
        <div class="admin-header__actions">
          <span class="admin-user" data-admin-user></span>
          <a class="admin-text-link" href="/">瀏覽網站</a>
          <a class="admin-text-link" href="/admin/login/" data-admin-reauth hidden>重新登入</a>
          <button class="admin-button admin-button--quiet admin-button--small" type="button" data-admin-logout hidden>登出</button>
        </div>
      </header>
      <p class="admin-shell-status" role="status" data-admin-shell-status></p>
      {!login && <nav class="admin-nav" aria-label="管理功能">{links.map((link) => <a href={link.href} aria-current={current === link.key ? 'page' : undefined}><span>{link.number}</span>{link.label}</a>)}</nav>}
      <main id="admin-main" class="admin-main" tabindex="-1">
        {!login && <section class="admin-gate admin-card" data-admin-gate aria-live="polite">
          <span class="admin-eyebrow">PRIVATE STUDIO</span>
          <h2>確認管理權限</h2>
          <p data-admin-gate-message>正在確認登入狀態…</p>
          <button class="admin-button" type="button" data-admin-retry hidden>重新載入</button>
        </section>}
        <div data-admin-workspace hidden={!login}><slot /></div>
        <noscript><div class="admin-card admin-notice">管理後台需要啟用 JavaScript 才能登入並載入資料。你的帳號與合作資料不會包含在此靜態頁面中。</div></noscript>
      </main>
      <footer class="admin-footer"><span>Phox999 photography</span><span>工作室管理 · 所有時間以台北時間顯示</span></footer>
    </div>
    <script>
      import { initAdminShell } from '../lib/admin-client';
      initAdminShell();
    </script>
  </body>
</html>
