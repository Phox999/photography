---
import '../styles/global.css';
import '../styles/shell-refresh.css';
import '../styles/inner-refresh.css';
import FloatingActions from '../components/FloatingActions.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  referrer?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const siteOrigin = 'https://phox999.com';
const {
  title = '台北人像攝影・互惠外拍｜Phox999 photography',
  description = 'Phox999 是台北人像攝影師，提供雙北互惠攝影、戶外人像、棚拍與主題創作。第一次拍攝也能從主題、服裝與場景一起討論。',
  canonical,
  ogImage = '/assets/og-hero.jpg',
  ogImageAlt = 'Phox999 photography 人像攝影作品',
  ogType = 'website',
  noindex = false,
  referrer,
  structuredData,
} = Astro.props;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, siteOrigin).href;
const ogImageUrl = new URL(ogImage, siteOrigin).href;
const imagePath = new URL(ogImageUrl).pathname.toLowerCase();
const ogImageType = imagePath.endsWith('.webp')
  ? 'image/webp'
  : imagePath.endsWith('.png')
    ? 'image/png'
    : 'image/jpeg';
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    {referrer && <meta name="referrer" content={referrer} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;800&amp;family=Noto+Serif+TC:wght@600;700&amp;family=Outfit:wght@400;500;600;700&amp;display=swap"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content="Phox999 photography" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
    <title>{title}</title>
  </head>
  <body id="top">
    {!noindex && <aside class="public-announcement" data-public-announcement role="status" hidden></aside>}
    <slot />
    {!noindex && <FloatingActions />}
  </body>
</html>

<style>
  .public-announcement { position: fixed; z-index: 19; top: clamp(92px, 8vw, 112px); left: 50%; width: min(calc(100% - 36px), 760px); max-height: 112px; overflow: auto; padding: 12px 22px; transform: translateX(-50%); border: 1px solid rgb(255 255 255 / .9); border-radius: var(--radius-pill); background: rgb(255 255 255 / .94); color: var(--color-muted); box-shadow: var(--shadow-card); backdrop-filter: blur(16px); text-align: center; font-size: .92rem; font-weight: 600; line-height: 1.6; }
  @media (max-width: 760px) { .public-announcement { top: 92px; padding: 10px 16px; border-radius: var(--radius-lg); font-size: .84rem; } }
</style>

<script>
  import { initInquiryAnalytics } from '../lib/inquiry-analytics';

  initInquiryAnalytics(import.meta.env.PUBLIC_GA4_MEASUREMENT_ID);
</script>

<script>
  import { loadPublicSiteContent } from '../lib/site-content';
  const notice = document.querySelector<HTMLElement>('[data-public-announcement]');
  if (notice) {
    const content = await loadPublicSiteContent();
    if (content.announcement.trim()) {
      notice.textContent = content.announcement;
      notice.hidden = false;
    }
  }
</script>
