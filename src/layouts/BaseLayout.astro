---
import '../styles/global.css';
import '../styles/shell-refresh.css';
import '../styles/inner-refresh.css';
import FloatingActions from '../components/FloatingActions.astro';
import FavoriteWorks from '../components/FavoriteWorks.astro';
import '../styles/favorites.css';
import { canonicalUrl as getCanonicalUrl, DEFAULT_DESCRIPTION, safeJsonLd } from '../../server/seo.js';

const {
  title = 'phox999 photography｜互惠人像攝影合作',
  description = DEFAULT_DESCRIPTION,
  canonicalPath = Astro.url.pathname,
  image = 'https://phox999.com/assets/og-hero.jpg',
  imageAlt = 'phox999 photography 首頁主視覺',
  structuredData,
  allowStructuredDataWhenNoindex = false,
  noindex = false,
  showPublicUi = !noindex,
  referrer,
} = Astro.props;
const pageCanonicalUrl = getCanonicalUrl(canonicalPath);
const robots = noindex ? 'noindex, nofollow, noarchive' : 'index, follow, max-image-preview:large';
const schemaItems = noindex && !allowStructuredDataWhenNoindex
  ? []
  : (Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : []);
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={pageCanonicalUrl} />
    {referrer && <meta name="referrer" content={referrer} />}
    <meta property="og:site_name" content="phox999 photography" />
    <meta property="og:url" content={pageCanonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    {schemaItems.map((schema) => <script type="application/ld+json" data-seo-jsonld set:html={safeJsonLd(schema)}></script>)}
  </head>
  <body id="top">
    {showPublicUi && <aside class="public-announcement" data-public-announcement role="status" hidden></aside>}
    <slot />
    {showPublicUi && <FloatingActions />}
    {showPublicUi && <FavoriteWorks />}
  </body>
</html>

<style>
  .public-announcement { position: fixed; z-index: 19; top: clamp(92px, 8vw, 112px); left: 50%; width: min(calc(100% - 36px), 760px); max-height: 112px; overflow: auto; padding: 12px 22px; transform: translateX(-50%); border: 1px solid rgb(255 255 255 / .9); border-radius: var(--radius-pill); background: rgb(255 255 255 / .94); color: var(--color-muted); box-shadow: var(--shadow-card); backdrop-filter: blur(16px); text-align: center; font-size: .92rem; font-weight: 600; line-height: 1.6; }
  @media (max-width: 760px) { .public-announcement { top: 92px; padding: 10px 16px; border-radius: var(--radius-lg); font-size: .84rem; } }
</style>

<script>
  import { loadPublicSiteContent } from '../lib/site-content';
  const notice = document.querySelector<HTMLElement>('[data-public-announcement]');
  if (notice) {
    const content = await loadPublicSiteContent();
    if (content.announcement.trim()) {
      notice.textContent = content.announcement;
      notice.hidden = false;
    }
  }
</script>
