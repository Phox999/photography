---
import '../styles/global.css';
import '../styles/shell-refresh.css';
import '../styles/inner-refresh.css';
import FloatingActions from '../components/FloatingActions.astro';

interface Props {
  editorialHome?: boolean;
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  referrer?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const siteOrigin = 'https://phox999.com';
const {
  title = '台北人像攝影・互惠外拍｜Phox999 photography',
  description = 'Phox999 是台北人像攝影師，提供雙北互惠攝影、戶外人像、棚拍與主題創作。第一次拍攝也能從主題、服裝與場景一起討論。',
  canonical,
  ogImage = '/assets/og-hero.jpg',
  ogImageAlt = 'Phox999 photography 人像攝影作品',
  ogType = 'website',
  noindex = false,
  referrer,
  structuredData,
  editorialHome = false,
} = Astro.props;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, siteOrigin).href;
const ogImageUrl = new URL(ogImage, siteOrigin).href;
const imagePath = new URL(ogImageUrl).pathname.toLowerCase();
const ogImageType = imagePath.endsWith('.webp')
  ? 'image/webp'
  : imagePath.endsWith('.png')
    ? 'image/png'
    : 'image/jpeg';
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {editorialHome && <link rel="preload" href="/assets/audio/kave_msri-camera-shutter-314056.mp3" as="fetch" crossorigin="anonymous" />}
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    {referrer && <meta name="referrer" content={referrer} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;800&amp;family=Noto+Serif+TC:wght@600;700&amp;family=Outfit:wght@400;500;600;700&amp;display=swap"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content="Phox999 photography" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
    <title>{title}</title>
  </head>
  <body id="top" class:list={{ 'editorial-shell': editorialHome }}>
    {!noindex && <aside class="public-announcement" data-public-announcement role="status" hidden></aside>}
    <slot />
    {!noindex && <dialog class="site-analytics-dialog" data-site-analytics-dialog aria-labelledby="site-analytics-dialog-title">
      <div class="site-analytics-dialog__heading">
        <h2 id="site-analytics-dialog-title">匿名瀏覽量測設定</h2>
        <form method="dialog"><button type="submit" class="site-analytics-dialog__close" aria-label="關閉隱私設定">關閉</button></form>
      </div>
      <p>本站使用第一方隨機識別碼估計訪客，記錄公開頁瀏覽、合作入口點擊與表單流程；不記錄表單欄位內容、完整 IP 或完整 User-Agent。統計事件最長保留 90 天，可以在此停用量測或清除識別碼。</p>
      <p class="site-analytics-dialog__status" role="status" aria-live="polite" data-site-analytics-status></p>
      <div class="site-analytics-dialog__actions">
        <button type="button" class="site-analytics-dialog__button" data-site-analytics-toggle aria-pressed="false">停用匿名量測</button>
        <button type="button" class="site-analytics-dialog__button site-analytics-dialog__button--quiet" data-site-analytics-clear>清除識別碼</button>
      </div>
    </dialog>}
    {!noindex && !editorialHome && <FloatingActions />}
  </body>
</html>

<style>
  .public-announcement { position: fixed; z-index: 19; top: clamp(92px, 8vw, 112px); left: 50%; width: min(calc(100% - 36px), 760px); max-height: 112px; overflow: auto; padding: 12px 22px; transform: translateX(-50%); border: 1px solid rgb(255 255 255 / .9); border-radius: var(--radius-pill); background: rgb(255 255 255 / .94); color: var(--color-muted); box-shadow: var(--shadow-card); backdrop-filter: blur(16px); text-align: center; font-size: .92rem; font-weight: 600; line-height: 1.6; }
  @media (max-width: 760px) { .public-announcement { top: 92px; padding: 10px 16px; border-radius: var(--radius-lg); font-size: .84rem; } }
  .site-analytics-dialog { width: min(calc(100% - 32px), 620px); max-height: calc(100dvh - 48px); overflow-y: auto; border: 1px solid var(--color-border, #dce6eb); border-radius: var(--radius-lg, 16px); background: var(--color-surface, #fff); padding: 24px; color: var(--color-muted, #52636b); font-size: .94rem; line-height: 1.7; box-shadow: 0 20px 60px rgb(0 0 0 / .2); }
  .site-analytics-dialog::backdrop { background: rgb(0 0 0 / .45); }
  .site-analytics-dialog__heading { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 12px; }
  .site-analytics-dialog__heading h2 { color: var(--color-text, #1f3138); margin: 0; font-size: 1.3rem; }
  .site-analytics-dialog__close { border: 0; background: none; color: var(--color-primary-dark, #176b8a); font: inherit; cursor: pointer; }
  .site-analytics-dialog__status { min-height: 1.3em; color: var(--color-primary-dark, #176b8a); }
  .site-analytics-dialog__actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .site-analytics-dialog__button { min-height: 40px; padding: 8px 12px; border: 1px solid var(--color-primary-dark, #176b8a); border-radius: var(--radius-pill, 999px); background: var(--color-primary-dark, #176b8a); color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  .site-analytics-dialog__button--quiet { background: transparent; color: var(--color-primary-dark, #176b8a); }
  .site-analytics-dialog button:focus-visible { outline: 3px solid var(--color-focus, #f4b542); outline-offset: 3px; }
</style>

<script>
  import { initInquiryAnalytics } from '../lib/inquiry-analytics';
  import { initSiteAnalytics } from '../lib/site-analytics';

  initInquiryAnalytics(import.meta.env.PUBLIC_GA4_MEASUREMENT_ID);
  initSiteAnalytics();
  const analyticsDialog = document.querySelector<HTMLDialogElement>('[data-site-analytics-dialog]');
  document.querySelectorAll<HTMLButtonElement>('[data-open-analytics-preferences]').forEach((button) => {
    if (!analyticsDialog) return;
    button.hidden = false;
    button.addEventListener('click', () => analyticsDialog.showModal());
  });
  analyticsDialog?.addEventListener('click', (event) => {
    if (event.target === analyticsDialog) analyticsDialog.close();
  });
</script>

<script>
  import { loadPublicSiteContent } from '../lib/site-content';
  const notice = document.querySelector<HTMLElement>('[data-public-announcement]');
  if (notice) {
    const content = await loadPublicSiteContent();
    if (content.announcement.trim()) {
      notice.textContent = content.announcement;
      notice.hidden = false;
    }
  }
</script>
