---
import Layout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { SITE_ORIGIN, portfolioPath } from '../../server/seo.js';

interface Props {
  title: string;
  description: string;
  slug?: string;
  category?: '外拍' | '棚拍';
  cover?: string;
  noindex?: boolean;
  images: string[];
}

const { title, description, slug, category = '人像', cover, noindex = false, images } = Astro.props;
const canonicalPath = slug ? portfolioPath(slug) : Astro.url.pathname;
const displayTitle = `${title}｜${category}人像作品・phox999 photography`;
const shareImage = new URL(cover || images[0], SITE_ORIGIN).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${SITE_ORIGIN}${canonicalPath}#webpage`,
      url: `${SITE_ORIGIN}${canonicalPath}`,
      name: displayTitle,
      description,
      inLanguage: 'zh-Hant-TW',
      isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
      mainEntity: { '@id': `${SITE_ORIGIN}${canonicalPath}#gallery` },
      breadcrumb: { '@id': `${SITE_ORIGIN}${canonicalPath}#breadcrumb` },
    },
    {
      '@type': 'ImageGallery',
      '@id': `${SITE_ORIGIN}${canonicalPath}#gallery`,
      url: `${SITE_ORIGIN}${canonicalPath}`,
      name: title,
      description,
      creator: { '@id': `${SITE_ORIGIN}/about/#person` },
      image: images.map((url, index) => ({
        '@type': 'ImageObject',
        contentUrl: new URL(url, SITE_ORIGIN).href,
        name: `${title}作品照片 ${index + 1}`,
        description: `${title}人像作品照片。`,
        creator: { '@id': `${SITE_ORIGIN}/about/#person` },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE_ORIGIN}${canonicalPath}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: `${SITE_ORIGIN}/` },
        { '@type': 'ListItem', position: 2, name: '作品集', item: `${SITE_ORIGIN}/portfolio/` },
        { '@type': 'ListItem', position: 3, name: title, item: `${SITE_ORIGIN}${canonicalPath}` },
      ],
    },
  ],
};
---

<Layout
  title={displayTitle}
  description={description}
  canonicalPath={canonicalPath}
  image={shareImage}
  imageAlt={`${title}作品封面`}
  structuredData={structuredData}
  noindex={noindex}
  allowStructuredDataWhenNoindex={noindex}
>
  <Header />
  <main class="portfolio-detail">
    <section class="portfolio-detail__hero container">
      <a class="portfolio-detail__back" href="/portfolio/">← 回全部作品</a>

      <p class="eyebrow" data-portfolio-category>PORTFOLIO · {category}</p>
      <h1 data-portfolio-title>{title}</h1>
      <p class="portfolio-detail__description" data-portfolio-description>{description}</p>
      <p><a href="/cooperation/">了解互惠攝影合作方式</a> · <a href="/#contact">填寫合作意向</a></p>
    </section>

    <section
      class="portfolio-justified container"
      aria-label={`${title} 照片集`}
      data-justified-gallery
    >
      {
        images.map((image, index) => (
          <figure class="portfolio-justified__item">
            <button
              class="portfolio-justified__button"
              type="button"
              data-lightbox-open
              data-lightbox-index={index}
              aria-label={`開啟 ${title} 照片 ${index + 1}`}
            >
              <img
                src={image}
                alt={`${title}作品照片 ${index + 1}`}
                loading={index < 3 ? 'eager' : 'lazy'}
              />
            </button>
          </figure>
        ))
      }
    </section>

    <dialog class="portfolio-lightbox" data-lightbox-dialog>
      <div class="portfolio-lightbox__inner">
        <button
          class="portfolio-lightbox__close"
          type="button"
          aria-label="關閉照片"
          data-lightbox-close
        >
          ×
        </button>

        <button
          class="portfolio-lightbox__nav portfolio-lightbox__nav--prev"
          type="button"
          aria-label="上一張照片"
          data-lightbox-prev
        >
          ‹
        </button>

        <img class="portfolio-lightbox__image" src="" alt="" data-lightbox-image />

        <button
          class="portfolio-lightbox__nav portfolio-lightbox__nav--next"
          type="button"
          aria-label="下一張照片"
          data-lightbox-next
        >
          ›
        </button>

        <p class="portfolio-lightbox__count" data-lightbox-count></p>
      </div>
    </dialog>
  </main>
  <Footer />

<script>
    const setupPortfolioLightbox = () => {
      const gallery = document.querySelector('[data-justified-gallery]');
      const dialog = document.querySelector('[data-lightbox-dialog]');
      const lightboxImage = document.querySelector('[data-lightbox-image]');
      const count = document.querySelector('[data-lightbox-count]');
      const closeButton = document.querySelector('[data-lightbox-close]');
      const prevButton = document.querySelector('[data-lightbox-prev]');
      const nextButton = document.querySelector('[data-lightbox-next]');

      if (!gallery || !dialog || !lightboxImage) return;

      const images = Array.from(gallery.querySelectorAll('img'));
      let currentIndex = 0;

      const updateLightbox = (index) => {
        if (!images.length) return;

        currentIndex = (index + images.length) % images.length;

        const currentImage = images[currentIndex];

        lightboxImage.src = currentImage.currentSrc || currentImage.src;
        lightboxImage.alt = currentImage.alt || '';

        if (count) {
          count.textContent = `${currentIndex + 1} / ${images.length}`;
        }
      };

      const openLightbox = (index) => {
        updateLightbox(index);

        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        } else {
          dialog.setAttribute('open', '');
        }
      };

      const closeLightbox = () => {
        dialog.close();
        lightboxImage.src = '';
        lightboxImage.alt = '';
      };

      gallery.addEventListener('click', (event) => {
        const target = event.target;

        if (!(target instanceof HTMLElement)) return;

        const button = target.closest('[data-lightbox-open]');
        if (!button) return;

        const index = Number.parseInt(button.dataset.lightboxIndex || '0', 10);
        openLightbox(index);
      });

      closeButton?.addEventListener('click', closeLightbox);

      prevButton?.addEventListener('click', () => {
        updateLightbox(currentIndex - 1);
      });

      nextButton?.addEventListener('click', () => {
        updateLightbox(currentIndex + 1);
      });

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) {
          closeLightbox();
        }
      });

      window.addEventListener('keydown', (event) => {
        if (!dialog.open) return;

        if (event.key === 'ArrowLeft') {
          updateLightbox(currentIndex - 1);
        }

        if (event.key === 'ArrowRight') {
          updateLightbox(currentIndex + 1);
        }
      });
    };

    setupPortfolioLightbox();
  </script>
</Layout>
