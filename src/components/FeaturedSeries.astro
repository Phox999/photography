---
import { portfolioCatalog } from '../data/portfolioCatalog';
import { getImageSrcset } from '../lib/image-variants';
import { serializePortfolioRouteMap } from '../lib/portfolio-routes';
import { getPublicImageDimensions } from '../lib/image-dimensions';
import { selectHomepageSeries } from '../lib/home-featured-series.js';
const series = await Promise.all(selectHomepageSeries(portfolioCatalog).map(async item => {
  const photos = [...new Set(item.images)].slice(0, 3);
  const dimensions = await Promise.all(photos.map(getPublicImageDimensions));
  return { ...item, photos, dimensions };
}));
---
<section id="featured-series" class="featured-series" aria-labelledby="series-title" data-featured-series data-series-routes={serializePortfolioRouteMap(portfolioCatalog)}>
  <header class="featured-series__heading">
    <p class="eyebrow">03 / FEATURED SERIES</p>
    <h2 id="series-title">每一種你，都有自己的故事。</h2>
  </header>
  {series.map((item, seriesIndex) => <article class="series-row" data-series-card data-series-slug={item.slug} aria-labelledby={`series-name-${seriesIndex}`}>
    <div class="series-images" data-series-images>
      {item.photos.map((src, index) => <img src={src} srcset={getImageSrcset(src)} sizes={index === 0 ? '70vw' : '23vw'} alt={`${item.title}・影像 ${index + 1}`} loading="lazy" decoding="async" width={item.dimensions[index]?.width} height={item.dimensions[index]?.height} />)}
    </div>
    <div class="series-label editorial-label"><span>03 / 0{seriesIndex + 1}</span><p>FEATURED<br />SERIES</p></div>
    <div class="series-info"><span>SELECTED SERIES / 0{seriesIndex + 1}</span><h3 id={`series-name-${seriesIndex}`} data-series-title>{item.title}</h3><a href={item.href} data-series-link>查看系列 <span aria-hidden="true">↗</span></a></div>
  </article>)}
</section>
<script>
  import { loadPublishedPortfolio } from '../lib/portfolio-content';
  import { parsePortfolioRouteMap } from '../lib/portfolio-routes';
  import { setPortfolioImageSource } from '../lib/image-variants';
  import { selectHomepageSeries } from '../lib/home-featured-series.js';
  const root = document.querySelector<HTMLElement>('[data-featured-series]');
  if (root) loadPublishedPortfolio(parsePortfolioRouteMap(root.dataset.seriesRoutes)).then(collections => {
    if (!collections) return;
    const selected = selectHomepageSeries(collections);
    root.querySelectorAll<HTMLElement>('[data-series-card]').forEach((card, seriesIndex) => {
      const item = selected[seriesIndex];
      card.hidden = !item;
      if (!item) return;
      card.dataset.seriesSlug = item.slug;
      const images = [...new Set(item.images)].slice(0, 3).map((src, index) => {
        const image = document.createElement('img');
        image.alt = `${item.title}・影像 ${index + 1}`;
        image.loading = 'lazy'; image.decoding = 'async'; image.width = 1200; image.height = 800;
        setPortfolioImageSource(image, src, index === 0 ? '70vw' : '23vw');
        return image;
      });
      card.querySelector('[data-series-images]')?.replaceChildren(...images);
      card.querySelector('[data-series-title]')!.textContent = item.title;
      card.querySelector<HTMLAnchorElement>('[data-series-link]')!.href = item.href;
    });
  });
</script>
