---
import { homepageNavigation } from '../data/site';
---
<footer class="camera-footer" aria-label="PHOX999 頁尾">
  <div class="camera-footer__top">
    <div>
      <p class="camera-footer__eyebrow">THE NEXT FRAME.</p>
      <h2>下一個故事，<br />一起拍下來。</h2>
    </div>
    <nav class="camera-footer__links" aria-label="頁尾導覽">{homepageNavigation.map((link) => <a href={link.href}>{link.label}</a>)}</nav>
  </div>
  <a class="camera-footer__wordmark" href="#hero" aria-label="PHOX999，回到首頁頂部">PHOX999</a>
  <div class="camera-footer__bottom">
    <p>© 2026 PHOX999 PHOTOGRAPHY</p>
    <p>PORTRAIT PHOTOGRAPHY / TAIPEI</p>
    <button type="button" data-open-analytics-preferences hidden>隱私設定</button>
  </div>
</footer>

<style>
  .camera-footer { --footer-muted: rgb(255 255 255 / .78); --footer-hairline: rgb(255 255 255 / .24); padding: clamp(48px, 4.3945vw, 90px) 4.6875% clamp(28px, 2.246vw, 46px); background: var(--color-primary); color: var(--color-on-primary); }
  .camera-footer__top { display: flex; justify-content: space-between; gap: 40px; min-height: clamp(160px, 9.57vw, 196px); }
  .camera-footer__eyebrow { margin: 0 0 18px; color: var(--footer-muted); font: 500 clamp(11px, .78125vw, 16px)/1.4 var(--font-body); letter-spacing: 2.5px; }
  .camera-footer h2 { margin: 0; font: 600 clamp(30px, 2.6367vw, 54px)/1.45 var(--font-heading); color: inherit; }
  .camera-footer__links { display: flex; flex-direction: column; gap: clamp(16px, 1.367vw, 28px); padding-right: 28px; font: 500 clamp(14px, .928vw, 19px)/1.4 var(--font-body); }
  .camera-footer__links a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .camera-footer__wordmark { display: block; width: max-content; margin: clamp(40px, 3.369vw, 69px) -.366vw 0; font: 700 20.58594vw/1 var(--font-brand); letter-spacing: -.02em; white-space: nowrap; }
  .camera-footer__bottom { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; margin-top: clamp(28px, 1.758vw, 36px); padding-top: 28px; border-top: 1px solid var(--footer-hairline); color: var(--footer-muted); font: 400 clamp(10px, .684vw, 14px)/1.4 var(--font-body); letter-spacing: .7px; }
  .camera-footer__bottom p { margin: 0; }
  .camera-footer__bottom button { justify-self: end; border: 0; padding: 0; background: transparent; color: inherit; font: inherit; cursor: pointer; }
  .camera-footer__bottom button:hover { text-decoration: underline; text-underline-offset: 4px; }
  .camera-footer :focus-visible { outline: 2px solid currentColor; outline-offset: 6px; }
  @media (max-width: 600px) {
    .camera-footer { padding-inline: 6%; }
    .camera-footer__top { flex-direction: column; gap: 32px; }
    .camera-footer__links { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px 24px; padding: 0; }
    .camera-footer__wordmark { font-size: 19.95vw; }
    .camera-footer__bottom { grid-template-columns: 1fr; gap: 14px; padding-top: 22px; }
    .camera-footer__bottom button { justify-self: start; min-height: 36px; }
  }
</style>
