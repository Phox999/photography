---
import { portfolioCatalog } from '../data/portfolioCatalog';
import { orderFeaturedPortfolio } from '../lib/featured-portfolio.js';
import { getImageSrcset } from '../lib/image-variants';
import { getPublicImageDimensions } from '../lib/image-dimensions';

const portrait = '/assets/portfolio/260201_棚拍 RE/_I7A0019.webp';
const secondWork = orderFeaturedPortfolio(portfolioCatalog).find((item) => item.cover !== portrait);
const secondImage = secondWork?.cover ?? portfolioCatalog[0]?.cover ?? portrait;
const [portraitDimensions, secondDimensions] = await Promise.all([
  getPublicImageDimensions(portrait),
  getPublicImageDimensions(secondImage),
]);
---
<section id="directions" class="visual-directions editorial-section" aria-labelledby="directions-title">
  <div class="direction-grid" aria-label="精選拍攝風格">
    <img
      class="direction-grid__main"
      src={portrait}
      srcset={getImageSrcset(portrait)}
      sizes="(max-width: 720px) 100vw, 35vw"
      alt="耳機主題棚拍作品，呈現自在且有個性的風格"
      width={portraitDimensions?.width}
      height={portraitDimensions?.height}
      loading="lazy"
      decoding="async"
    />
    <img
      class="direction-grid__detail"
      src={secondImage}
      srcset={getImageSrcset(secondImage)}
      sizes="(max-width: 720px) 42vw, 16vw"
      alt={secondWork ? `${secondWork.title}人像作品` : '人像攝影作品'}
      width={secondDimensions?.width}
      height={secondDimensions?.height}
      loading="lazy"
      decoding="async"
    />
  </div>
  <header class="direction-copy">
    <p class="eyebrow">05 / VISUAL DIRECTION</p>
    <h2 id="directions-title">找到屬於你的<br />風格。</h2>
    <p>自然、個性，或一個從沒試過的自己。</p>
  </header>
</section>
