---
import { siteConfig } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-inner footer-inner--grouped">
    <a class="logo logo--footer" href="/" aria-label="回到首頁">
      <span>phox999</span>
      <small>photography</small>
    </a>

    <nav class="footer-group" aria-label="探索攝影作品">
      <h2>探索作品</h2>
      <a href={siteConfig.portfolioUrl}>全部作品</a>
      <a href="/#portfolio">首頁精選</a>
      <a href={siteConfig.aboutUrl}>關於我</a>
    </nav>

    <nav class="footer-group" aria-label="拍攝合作資訊">
      <h2>一起拍攝</h2>
      <a href="/cooperation/">合作方式</a>
      <a href="/cooperation/#availability">開放檔期</a>
      <a href="/cooperation/#process">合作流程</a>
    </nav>

    <nav class="footer-group" aria-label="更多資訊">
      <h2>更多資訊</h2>
      <a href="/behind-scenes/">拍攝花絮</a>
      <a href="/cooperation/#process">合作流程</a>
      <a href={siteConfig.aboutUrl}>關於我</a>
    </nav>

    <div class="footer-bottom">
      <p>© 2026 Phox999 photography</p>
      <div class="footer-contact-links">
        <a href={siteConfig.instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="18" cy="6" r="1" class="footer-icon__dot"/></svg>
        </a>
        <a href={siteConfig.mailtoUrl} aria-label="Email" title="Email">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
