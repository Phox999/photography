---
import { faqItems } from '../data/site';
import { faqPageSchema } from '../lib/faq-state.js';
---

<section class="section container" id="faq" aria-labelledby="faq-title">
  <div class="section-heading">
    <p class="eyebrow">FAQ</p>
    <h2 id="faq-title">常見問題</h2>
  </div>

  <div class="faq-grid">
    {
      faqItems.map((item) => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </div>
  <script type="application/ld+json" data-faq-schema set:html={JSON.stringify(faqPageSchema(faqItems)).replace(/</g, '\\u003c')} />
</section>

<script>
  import { loadPublicSiteContent } from '../lib/site-content';
  import { faqPageSchema, publicFaqView } from '../lib/faq-state.js';
  const grid = document.querySelector<HTMLElement>('#faq .faq-grid');
  if (grid) {
    const section = grid.closest<HTMLElement>('#faq');
    const { faqs: contentFaqs } = await loadPublicSiteContent();
    const view = publicFaqView(contentFaqs);
    const structuredData = section?.querySelector<HTMLScriptElement>('[data-faq-schema]');
    const items = view.items.map(({ question, answer }) => {
      const detail = document.createElement('details');
      detail.className = 'faq-item';
      const summary = document.createElement('summary');
      summary.textContent = question;
      const paragraph = document.createElement('p');
      paragraph.textContent = answer;
      detail.append(summary, paragraph);
      return detail;
    });
    grid.replaceChildren(...items);
    if (section) section.hidden = !view.visible;
    if (structuredData) {
      if (view.visible) {
        structuredData.textContent = JSON.stringify(faqPageSchema(view.items));
      } else {
        structuredData.remove();
      }
    }
  }
</script>
