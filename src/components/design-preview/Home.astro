---
import {asset,collections} from '../../data/design-preview';
import dimensions from '../../data/design-preview-images.json';
import CooperationForm from './CooperationForm.astro';
import '../../styles/design-preview-home.css';
const stories = [
 {title:'晴空之下',id:0,images:['370bf.png','0a2f8.png','c0188.png','d04f8.png','1e501.png','1aa94.png']},
 {title:'放課後',id:1,images:['cff2b.png','c9b1e.png','014c9.png','8bd37.png','437ba.png','1f3d6.png']}
];
---
<div class="home-editorial">
 <section class="editorial-hero" aria-label="PHOX999 攝影">
  <img src={asset('f8a43.png')} width="2048" height="1364" alt="少女在海邊奔跑，回頭望向鏡頭" fetchpriority="high"/>
  <div class="hero-note"><small>PHOX999 / PORTRAIT PHOTOGRAPHY</small><h1>一些相遇，<br/>一些故事。</h1><a href="#home-stories">往下探索</a></div>
  <span class="editorial-scroll">SCROLL TO EXPLORE</span>
 </section>
 <div id="home-stories">
 {stories.map((story,i)=><section class:list={['home-story',{'home-story-reverse':i===1}]}>
  <div class="story-label"><small>SELECTED SERIES / 0{i+1}</small><h2>{story.title}</h2><a href={'/design-preview/series/'+story.id+'/'}>查看系列 ↗</a><small class="swipe-hint">往下探索 ↓</small></div>
  <div class="story-rail" tabindex="0" role="region" aria-label={story.title+'，可橫向捲動照片'}>{story.images.map((file,index)=>{const size=dimensions[file];return <img src={asset(file)} width={size.width} height={size.height} alt={story.title+' / '+String(index+1).padStart(2,'0')} loading="lazy"/>;})}</div>
 </section>)}
 </div>
 <section class="home-selected">
  <div class="story-label"><small>PORTFOLIO / SELECTED WORKS</small><h2>精選作品</h2><a href="/design-preview/portfolio/">查看全部作品 ↗</a></div>
  <div class="selected-rail" tabindex="0" role="region" aria-label="精選作品，可橫向捲動">{[collections[1],collections[0],...collections.slice(2,8)].map((item,i)=><a href={'/design-preview/series/'+item.id+'/'}><img src={asset(item.image)} alt={item.title} loading="lazy"/><span><small>0{i+1}</small>{item.title}</span></a>)}</div>
 </section>
 <section class="home-manifesto" aria-label="攝影理念"><img src={asset('e2a9c.svg')} class="quote-open" alt=""/><h2>每一種你，<br/>都有自己的故事。</h2><img src={asset('c5bef.svg')} class="quote-close" alt=""/></section>
 <section class="page-space home-cooperation"><small>COLLABORATION</small><h2>一起創作</h2><CooperationForm/></section>
</div>
<script>
 const preference=matchMedia('(prefers-reduced-motion: reduce)');
 const desktop=matchMedia('(min-width: 1024px) and (pointer: fine)');
 const stories=[...document.querySelectorAll<HTMLElement>('.home-story,.home-selected')];
 let pending=false;
 function update(){
  pending=false;
  if(preference.matches)return;
  for(const section of stories){
   const rail=section.querySelector<HTMLElement>('.story-rail,.selected-rail');
   if(!rail||section.contains(document.activeElement)||(desktop.matches&&rail.matches(':hover')))continue;
   const rect=section.getBoundingClientRect();
   const progress=Math.max(0,Math.min(1,(innerHeight-rect.top)/(innerHeight+rect.height)));
   const direction=section.classList.contains('home-story-reverse')?1-progress:progress;
   rail.scrollLeft=(rail.scrollWidth-rail.clientWidth)*direction;
  }
 }
 function schedule(){if(!pending){pending=true;requestAnimationFrame(update);}}
 addEventListener('scroll',schedule,{passive:true});
 addEventListener('resize',schedule,{passive:true});
 desktop.addEventListener('change',schedule);
  function syncMotionPreference(){
  document.querySelector('.home-editorial')?.classList.toggle('scroll-motion',!preference.matches);
  if(preference.matches)stories.forEach(s=>s.querySelector('.story-rail,.selected-rail')?.scrollTo(0,0));
  else schedule();
 }
 preference.addEventListener('change',syncMotionPreference);
 // Intrinsic image dimensions stabilize the rails; recalculate after late image loads.
 document.querySelectorAll('.home-editorial img').forEach(img=>img.addEventListener('load',schedule,{once:true}));
 syncMotionPreference();
 schedule();
</script>
