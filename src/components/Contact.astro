---
import { siteConfig } from '../data/site';

const shootStyles = [
  { id: 'office-lady', title: 'OL 制服' },
  { id: 'couple', title: '情侶寫真' },
  { id: 'small-group', title: '2-4 人小團體' },
  { id: 'baseball', title: '棒球' },
  { id: 'muscle-men', title: '肌肉(男生優先)' },
  { id: 'red-theme', title: '紅色' },
  { id: 'fashion-lingerie', title: '時尚內衣' },
  { id: 'home-portrait', title: '居家寫真' },
  { id: 'school-swimsuit', title: '死庫水' },
  { id: 'bondage', title: '束縛' },
  { id: 'water', title: '水' },
  { id: 'other', title: '其他' },
];
const showThemeImages = false;
---

<section class="section contact-section" id="contact" aria-labelledby="contact-title">
  <div class="container contact-layout">
    <header class="contact-copy">
      <p class="eyebrow">CONTACT</p>
      <h2 id="contact-title">一鍵申請，下一步開始拍攝</h2>
    </header>

    <form class="contact-form" data-inquiry-form>
      <label class="hidden-field" aria-hidden="true">
        <span>網站</span>
        <input name="website" type="text" autocomplete="off" tabindex="-1" />
      </label>

      <div class="contact-editor" data-contact-editor>
        <section class="contact-form-section" aria-labelledby="contact-step-1-title">
          <h3 id="contact-step-1-title">1. 挑選想拍攝的風格</h3>
          <fieldset class="contact-style-select">
            <legend>a.本期推薦主題 <span>可複選</span></legend>
            <div class:list={['contact-style-grid', !showThemeImages && 'contact-style-grid--text-only']}>
              {shootStyles.map((style) => (
                <button class="contact-style" type="button" aria-pressed="false" data-contact-style={style.id} data-style-title={style.title}>
                  {showThemeImages && style.image && <img src={style.image} alt="" width="360" height="240" loading="lazy" decoding="async" />}
                  <span>{style.title}</span>
                  <span class="contact-style__check" aria-hidden="true">✓</span>
                </button>
              ))}
            </div>
          </fieldset>

          <section class="contact-reference-card" aria-labelledby="reference-title">
            <h4 id="reference-title">b. 加入自己的參考照片 / 連結 <span>選填</span></h4>
            <div class="contact-reference-grid">
              <div class="form-field">
                <div class="reference-file-picker">
                  <input class="reference-file-input" id="reference-images" type="file" accept="image/jpeg,image/png,image/webp" multiple aria-describedby="reference-images-help reference-status" data-reference-images />
                  <label class="reference-file-picker__button" for="reference-images">選擇照片</label>
                  <span class="reference-file-picker__names" data-reference-file-names aria-live="polite">尚未選擇檔案</span>
                </div>
                <p class="field-help" id="reference-images-help">最多 3 張 JPG、PNG 或 WebP，每張 4 MB。</p>
                <div class="reference-previews" data-reference-previews aria-live="polite"></div>
                <p class="field-help" id="reference-status" data-reference-status role="status"></p>
              </div>
              <div class="form-field">
                <label for="description">拍攝想法 <span>選填</span></label>
                <textarea id="description" name="description" rows="5" aria-describedby="description-help description-count" placeholder="例如：想拍攝的氛圍、地點或其他想法"></textarea>
                <p class="field-help" id="description-help">可填自由文字，或選擇上方風格；兩者合計最多 2,000 字。</p>
                <p class="field-help" data-description-count aria-live="polite">0 / 2,000 字</p>
                <label for="reference-links">參考連結 <span>選填</span></label>
                <textarea id="reference-links" name="reference_links" rows="3" maxlength="6146" aria-describedby="reference-links-help" placeholder="每行一個 http:// 或 https:// 網址"></textarea>
                <p class="field-help" id="reference-links-help">最多 3 個連結，每個最多 2,048 字；後端只儲存連結文字。</p>
              </div>
            </div>
          </section>
        </section>

        <section class="contact-form-section" aria-labelledby="contact-step-2-title">
          <h3 id="contact-step-2-title">2. 填寫合作資訊</h3>
          <div class="form-grid">
            <div class="form-field">
              <label for="name">姓名／暱稱</label>
              <input id="name" name="name" type="text" autocomplete="name" maxlength="80" required aria-describedby="name-help" />
              <p class="field-help" id="name-help">必填，最多 80 字。</p>
            </div>
          </div>
          <div class="form-grid contact-details-grid">
            <div class="form-field">
              <label for="collaboration_type">合作類型</label>
              <select id="collaboration_type" name="collaboration_type" required>
                <option value="">請選擇</option>
                <option value="標準方案(3hr)">一般互惠｜約 3 小時</option>
                <option value="主題合作">主題企劃</option>
              </select>
            </div>
            <div class="form-field">
              <label for="preferred_date">偏好日期</label>
              <input id="preferred_date" name="preferred_date" type="text" autocomplete="off" maxlength="200" placeholder="選填" />
            </div>
          </div>
          <div class="form-grid">
            <div class="form-field">
              <label for="contact_method">聯絡方式</label>
              <select id="contact_method" name="contact_method" required>
                <option value="">請選擇</option>
                <option value="Instagram">Instagram</option>
                <option value="Line">LINE</option>
                <option value="Facebook">Facebook</option>
                <option value="Threads">Threads</option>
                <option value="手機">手機</option>
                <option value="其他">其他</option>
              </select>
            </div>
            <div class="form-field">
              <label for="contact_account">聯絡帳號／連結</label>
              <input id="contact_account" name="contact_account" type="text" autocomplete="off" maxlength="120" required />
            </div>
          </div>

          <label class="checkbox-field">
            <input name="consent" type="checkbox" required />
            <span>我同意以上資料用於本次合作聯繫與檔期確認。</span>
          </label>

          <div class="form-footer">
            <button class="button button--primary" type="submit">確認合作內容</button>
          </div>
        </section>
      </div>

      <section class="contact-review" data-contact-review hidden aria-labelledby="contact-review-title">
        <div class="contact-review__heading">
          <h3 id="contact-review-title" tabindex="-1">確認這次的拍攝想法</h3>
          <p>內容還沒送出，可以返回修改。</p>
        </div>
        <dl class="contact-review__details">
          <div><dt>姓名／暱稱</dt><dd data-review-name></dd></div>
          <div><dt>聯絡方式</dt><dd data-review-contact></dd></div>
          <div><dt>合作類型</dt><dd data-review-type></dd></div>
          <div><dt>偏好日期</dt><dd data-review-date></dd></div>
        </dl>
        <div class="contact-review__section" data-review-styles hidden>
          <h4>喜歡的拍攝風格</h4>
          <p data-review-style-list></p>
        </div>
        <div class="contact-review__section" data-review-references hidden>
          <h4>加入的參考</h4>
          <p data-review-file-list></p>
          <ul data-review-link-list></ul>
          <p class="field-help">照片僅在此頁預覽，尚未上傳。</p>
        </div>
        <div class="contact-review__section">
          <h4>拍攝想法</h4>
          <p data-review-description></p>
        </div>
        <div class="contact-review__actions">
          <button class="button button--secondary" type="button" data-edit-inquiry>返回修改</button>
          <button class="button button--primary" type="button" data-confirm-inquiry>確認送出合作意向</button>
        </div>
      </section>
      <p class="form-status" role="status" aria-live="polite" data-inquiry-status></p>
      <div class="contact-links" aria-label="其他聯絡方式">
        <a href={siteConfig.instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="18" cy="6" r="1" class="contact-icon__dot"/></svg>
        </a>
        <a href={siteConfig.mailtoUrl} aria-label="Email" title="Email">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
        </a>
        <a href={siteConfig.googleFormUrl} target="_blank" rel="noopener noreferrer" aria-label="Google 表單" title="Google 表單">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h5M9 12h6M9 16h6"/></svg>
        </a>
      </div>
    </form>
  </div>
</section>

<script>
  import { buildInquiryPayload, normalizeInquiryDraft, validateInquiryDraft } from '../lib/inquiry-form.js';

  const inquiryForm = document.querySelector('[data-inquiry-form]');

  if (inquiryForm instanceof HTMLFormElement) {
    const preferredDateInput = inquiryForm.querySelector<HTMLInputElement>('#preferred_date');
    const requestedDate = new URLSearchParams(window.location.search).get('preferred_date');
    const requestedDateValue = requestedDate && /^\d{4}-\d{2}-\d{2}$/.test(requestedDate)
      ? new Date(`${requestedDate}T00:00:00Z`)
      : null;
    if (preferredDateInput && requestedDate && requestedDateValue && Number.isFinite(requestedDateValue.getTime())
      && requestedDateValue.toISOString().slice(0, 10) === requestedDate
      && !preferredDateInput.value.trim()) {
      preferredDateInput.value = requestedDate.replaceAll('-', '/');
    }

    const editor = inquiryForm.querySelector('[data-contact-editor]');
    const review = inquiryForm.querySelector('[data-contact-review]');
    const status = inquiryForm.querySelector('[data-inquiry-status]');
    const styleButtons = Array.from(inquiryForm.querySelectorAll('[data-contact-style]'));
    const referenceInput = inquiryForm.querySelector('[data-reference-images]');
    const referenceFileNames = inquiryForm.querySelector('[data-reference-file-names]');
    const referencePreviews = inquiryForm.querySelector('[data-reference-previews]');
    const referenceStatus = inquiryForm.querySelector('[data-reference-status]');
    const description = inquiryForm.querySelector('#description');
    const confirmButton = inquiryForm.querySelector('[data-confirm-inquiry]');
    const descriptionCount = inquiryForm.querySelector('[data-description-count]');
    let referenceFiles = [];
    let pending = false;

    const selectedStyles = () => styleButtons
      .filter((button) => button.getAttribute('aria-pressed') === 'true')
      .map((button) => button.getAttribute('data-style-title'))
      .filter(Boolean);

    const readDraft = () => normalizeInquiryDraft(new FormData(inquiryForm), selectedStyles());
    const fieldSelectors = {
      name: '#name',
      contact_method: '#contact_method',
      contact_account: '#contact_account',
      collaboration_type: '#collaboration_type',
      preferred_date: '#preferred_date',
      description: '#description',
      reference_links: '#reference-links',
      consent: '[name="consent"]',
    };
    const reportValidationError = (error) => {
      if (status) status.textContent = error.message;
      inquiryForm.querySelector(fieldSelectors[error.field] || '#description')?.focus();
    };
    const updateDescriptionCount = () => {
      if (!descriptionCount) return;
      const count = readDraft().combinedDescription.length;
      descriptionCount.textContent = `${count} / 2,000 字`;
    };

    const showEditor = () => {
      if (pending) return;
      if (editor) editor.hidden = false;
      if (review) review.hidden = true;
      inquiryForm.querySelector('[type="submit"]')?.focus();
    };

    const setReviewText = (selector, value) => {
      const target = inquiryForm.querySelector(selector);
      if (target) target.textContent = value || '未填寫';
    };

    const fillReview = (draft) => {
      setReviewText('[data-review-name]', draft.name);
      setReviewText('[data-review-contact]', `${draft.contactMethod}｜${draft.contactAccount}`);
      setReviewText('[data-review-type]', draft.collaborationType);
      setReviewText('[data-review-date]', draft.preferredDate);
      setReviewText('[data-review-description]', draft.description);

      const styles = selectedStyles();
      const stylesPanel = inquiryForm.querySelector('[data-review-styles]');
      const stylesText = inquiryForm.querySelector('[data-review-style-list]');
      if (stylesPanel) stylesPanel.hidden = styles.length === 0;
      if (stylesText) stylesText.textContent = styles.join('、');

      const links = draft.referenceLinks;
      const referencesPanel = inquiryForm.querySelector('[data-review-references]');
      const fileText = inquiryForm.querySelector('[data-review-file-list]');
      const linkList = inquiryForm.querySelector('[data-review-link-list]');
      if (referencesPanel) referencesPanel.hidden = links.length === 0 && referenceFiles.length === 0;
      if (fileText) fileText.textContent = referenceFiles.length ? `照片名稱：${referenceFiles.map((file) => file.name).join('、')}` : '';
      if (linkList) {
        linkList.replaceChildren();
        links.forEach((url) => {
          const item = document.createElement('li');
          item.textContent = url;
          linkList.appendChild(item);
        });
      }
      if (editor) editor.hidden = true;
      if (review) review.hidden = false;
      inquiryForm.querySelector('#contact-review-title')?.focus();
    };

    const clearPreviews = () => {
      if (referencePreviews) referencePreviews.replaceChildren();
      referenceFiles.forEach((file) => { if (file.previewUrl) URL.revokeObjectURL(file.previewUrl); });
      referenceFiles = [];
      if (referenceFileNames) referenceFileNames.textContent = '尚未選擇檔案';
    };

    const renderPreviews = () => {
      if (!referencePreviews) return;
      referencePreviews.replaceChildren();
      referenceFiles.forEach((file) => {
        const figure = document.createElement('figure');
        const image = document.createElement('img');
        image.src = file.previewUrl;
        image.alt = `參考照片預覽：${file.name}`;
        const caption = document.createElement('figcaption');
        caption.textContent = file.name;
        figure.append(image, caption);
        referencePreviews.appendChild(figure);
      });
    };

    styleButtons.forEach((button) => button.addEventListener('click', () => {
      if (pending) return;
      const isSelected = button.getAttribute('aria-pressed') === 'true';
      button.setAttribute('aria-pressed', String(!isSelected));
      updateDescriptionCount();
    }));

    description?.addEventListener('input', updateDescriptionCount);

    referenceInput?.addEventListener('change', () => {
      if (!(referenceInput instanceof HTMLInputElement) || !referenceStatus) return;
      const files = Array.from(referenceInput.files || []);
      const accepted = files.slice(0, 3).filter((file) => /image\/(jpeg|png|webp)/.test(file.type) && file.size <= 4 * 1024 * 1024);
      clearPreviews();
      referenceFiles = accepted.map((file) => ({ name: file.name, previewUrl: URL.createObjectURL(file) }));
      if (referenceFileNames) referenceFileNames.textContent = accepted.length ? accepted.map((file) => file.name).join('、') : '尚未選擇檔案';
      renderPreviews();
      if (files.length > 3 || accepted.length !== files.length) {
        referenceStatus.textContent = '最多選 3 張 JPG、PNG 或 WebP，每張不可超過 4 MB。';
      } else {
        referenceStatus.textContent = accepted.length ? `已選 ${accepted.length} 張照片供本頁預覽。` : '';
      }
      if (files.length > 3 || accepted.length !== files.length) referenceInput.value = '';
    });

    inquiryForm.addEventListener('submit', (event) => {
      event.preventDefault();
      if (pending) return;
      const draft = readDraft();
      const validationError = validateInquiryDraft(draft);
      if (validationError) {
        reportValidationError(validationError);
        return;
      }
      fillReview(draft);
      if (status) status.textContent = '';
    });

    inquiryForm.querySelector('[data-edit-inquiry]')?.addEventListener('click', showEditor);

    confirmButton?.addEventListener('click', async () => {
      if (pending) return;
      const draft = readDraft();
      const validationError = validateInquiryDraft(draft);
      if (validationError) {
        showEditor();
        reportValidationError(validationError);
        return;
      }
      const payload = buildInquiryPayload(draft);

      pending = true;
      if (confirmButton instanceof HTMLButtonElement) confirmButton.disabled = true;
      if (status) status.textContent = '送出中…';

      let responseReceived = false;
      try {
        const response = await fetch('/api/inquiries', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        responseReceived = true;
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.message || '目前無法送出，請改用 Instagram 或 Google 表單聯絡。');

        inquiryForm.reset();
        styleButtons.forEach((button) => button.setAttribute('aria-pressed', 'false'));
        clearPreviews();
        updateDescriptionCount();
        if (editor) editor.hidden = false;
        if (review) review.hidden = true;
        if (status) {
          const receiptUrl = result?.receipt?.url;
          const reference = result?.receipt?.reference;
          const validUrl = typeof receiptUrl === 'string' && /^\/cooperation-status\/#token=[a-f0-9]{64}$/i.test(receiptUrl);
          const validReference = typeof reference === 'string' && /^PHOX-[A-F0-9]{20}$/.test(reference);
          if (validReference) {
            status.replaceChildren(document.createTextNode('已收到合作意向。查詢代碼：'));
            const code = document.createElement('code');
            code.textContent = reference;
            const link = document.createElement('a');
            link.href = validUrl ? receiptUrl : '/cooperation-status/';
            link.textContent = '查看申請狀況';
            status.append(code, document.createTextNode('。請保存這組代碼。 '), link);
          } else {
            status.textContent = '已收到合作意向，我會再回覆確認檔期。';
          }
        }
      } catch (error) {
        if (status) {
          status.textContent = responseReceived
            ? (error instanceof Error ? error.message : '目前無法送出，請改用 Instagram 或 Google 表單聯絡。')
            : '連線中斷，送出結果尚未確認。為避免重複，請先透過 Instagram 或 Email 與我確認；表單內容仍保留。';
        }
      } finally {
        pending = false;
        if (confirmButton instanceof HTMLButtonElement) confirmButton.disabled = false;
      }
    });

    updateDescriptionCount();
    window.addEventListener('pagehide', clearPreviews);
  }
</script>
