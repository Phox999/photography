---
const steps = [
  {
    number: '01',
    icon: '/assets/icons/process/process-01.png',
    title: '申請合作',
    text: '填寫合作意向與拍攝方向。',
  },
  {
    number: '02',
    icon: '/assets/icons/process/process-02.png',
    title: '確認合作',
    text: '確認合作內容與時間、地點。',
  },
  {
    number: '03',
    icon: '/assets/icons/process/process-03.png',
    title: '溝通協作',
    text: '確認風格、服裝與公開範圍。',
  },
  {
    number: '04',
    icon: '/assets/icons/process/process-04.png',
    title: '拍攝日',
    text: '依討論內容拍攝，現場協助引導。',
  },
  {
    number: '05',
    icon: '/assets/icons/process/process-05.png',
    title: '成片與發文',
    text: '交付照片，確認使用與發文方式。',
  },
];
---

<section class="mini-section process-flow" id="process" aria-labelledby="process-title">
  <div class="section-heading process-flow__heading">
    <p class="eyebrow">PROCESS</p>
    <h2 id="process-title">合作流程</h2>
    <p class="process-flow__intro">
      簡單清楚的合作流程，讓我們一起創造安心、愉快且有價值的影像作品。
    </p>
  </div>

  <div class="process-flow__list">
    {
      steps.map((step) => (
        <article class="process-flow__card">
          <div class="process-flow__icon" aria-hidden="true">
            <img src={step.icon} alt="" loading="lazy" />
          </div>

          <div class="process-flow__content">
            <div class="process-flow__heading-row">
              <span class="process-flow__number">{step.number}</span>
              <h3>{step.title}</h3>
            </div>

            <p>{step.text}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>