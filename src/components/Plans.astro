---
import { siteConfig } from '../data/site';

const plans = [
  {
    icon: '/assets/icons/plan-light.png',
    title: '輕量體驗',
    subtitle: '適合第一次合作 / 記錄生活',
    bullets: ['2 小時拍攝', '可拍攝 1 套服裝', '交付照片 30-50 張'],
    cta: '開始聊聊拍攝',
  },
  {
    icon: '/assets/icons/plan-standard.png',
    title: '標準方案',
    subtitle: '適合想累積自己的作品',
    badge: '熱門選擇',
    bullets: ['3 小時拍攝', '可拍攝 1-3 套服裝', '交付照片 80-100 張'],
    cta: '開始聊聊拍攝',
  },
  {
    icon: '/assets/icons/plan-theme.png',
    title: '主題合作',
    subtitle: '適合有明確主題或創作想法',
    bullets: ['可討論時間、場景、風格與服裝', '照片數量依企劃內容討論', '共同完成一組更完整的影像作品'],
    cta: '開始聊聊拍攝',
  },
];
---

<section class="section container" id="plans" aria-labelledby="plans-title">
  <div class="section-heading">
    <p class="eyebrow">SOLUTIONS</p>
    <h2 id="plans-title">合作方案介紹</h2>
  </div>

  <div class="plan-grid">
    {
      plans.map((plan) => (
        <article class={`plan-card ${plan.badge ? 'plan-card--featured' : ''}`}>
          {plan.badge && <span class="badge">{plan.badge}</span>}

          <img class="plan-card__icon" src={plan.icon} alt="" aria-hidden="true" />

          <h3>{plan.title}</h3>
          <p class="plan-card__subtitle">{plan.subtitle}</p>

          <ul>
            {plan.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>

          <a
            class="button button--secondary"
            href={siteConfig.inquiryUrl}
          >
            {plan.cta}
          </a>
        </article>
      ))
    }
  </div>

  <p class="section-note">場地費、道具費等額外支出，雙方事前討論與分攤。</p>
</section>
