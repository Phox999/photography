---
import { siteConfig } from '../data/site';

const plans = [
  {
    icon: '/assets/icons/plan-standard.png',
    title: '一般互惠',
    subtitle: '適合第一次合作，或想拍一組完整人像作品',
    bullets: ['約 2–3 小時', '1–2 套服裝', '交付約 40–80 張照片'],
  },
  {
    icon: '/assets/icons/plan-theme.png',
    title: '主題企劃',
    subtitle: '適合已有明確主題、服裝或場景想法',
    bullets: ['時間與場景共同規劃', '服裝與風格拍攝前確認', '交付數量依企劃內容討論'],
  },
];
---

<section class="section container" id="plans" aria-labelledby="plans-title">
  <div class="section-heading">
    <p class="eyebrow">COLLABORATION</p>
    <h2 id="plans-title">合作方式</h2>
  </div>

  <div class="plan-grid">
    {
      plans.map((plan) => (
        <article class="plan-card">
          <img class="plan-card__icon" src={plan.icon} alt="" aria-hidden="true" />
          <h3>{plan.title}</h3>
          <p class="plan-card__subtitle">{plan.subtitle}</p>

          <ul>
            {plan.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>

          <a class="button button--secondary" href={siteConfig.inquiryUrl}>
            立即預約
          </a>
        </article>
      ))
    }
  </div>

  <p class="section-note">互惠合作不收拍攝費；棚租、場地與道具等額外支出會事前討論。</p>
</section>
