---
import { siteConfig } from '../data/site';

const heroImages = [
  '/assets/hero.webp',
  '/assets/hero-02.webp',
  '/assets/hero-03.webp',
  '/assets/hero-04.webp',
];
---

<section class="hero" id="hero" aria-labelledby="hero-title" data-hero-carousel>
  <div class="hero__media" aria-hidden="true">
    {
      heroImages.map((image, index) => (
        <img
          class={`hero__image ${index === 0 ? 'is-active' : ''}`}
          src={image}
          alt=""
          loading={index === 0 ? 'eager' : 'lazy'}
          data-hero-image
        />
      ))
    }
  </div>

  <div class="hero__overlay"></div>

  <div class="hero__content container">
    <h1 id="hero-title">第一次互惠拍攝，<br />也能安心開始。</h1>

<p class="hero__copy">
  不論你是第一次拍照，還是想累積作品，
  <br>
  拍攝前都會充分溝通需求與風格，尊重彼此的想法，
  一起完成自然、有故事的作品。
</p>

    <a
      class="button button--primary"
      href={siteConfig.inquiryUrl}
    >
      立即預約
    </a>
  </div>
</section>

<script>
  const heroCarousel = document.querySelector('[data-hero-carousel]');

  if (heroCarousel) {
    const images = Array.from(heroCarousel.querySelectorAll('[data-hero-image]'));
    let currentIndex = 0;

    const goToHeroImage = (index) => {
      if (!images.length) return;

      images[currentIndex].classList.remove('is-active');
      currentIndex = (index + images.length) % images.length;
      images[currentIndex].classList.add('is-active');
    };

    if (images.length > 1) {
      window.setInterval(() => {
        goToHeroImage(currentIndex + 1);
      }, 4600);
    }
  }
</script>
