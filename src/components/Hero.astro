---
import { defaultHeroContent, siteConfig } from '../data/site';
import { getPublicImageDimensions } from '../lib/image-dimensions';
import heroManifest from '../data/hero-image-variants.json' with { type: 'json' };
import { heroImageSources } from '../lib/hero-images';
import { heroFocalPoint } from '../data/homePhotoPresentation';
import { getImageSrcset } from '../lib/image-variants';
interface Props { editorial?: boolean; }
const { editorial = false } = Astro.props;

const editorialHeroSource = '/assets/portfolio/260201_棚拍 RE/_I7A0019.webp';
const initialHeroSource = editorial ? editorialHeroSource : heroManifest.defaultSource;
const initialHeroSources = initialHeroSource && !editorial ? heroImageSources(initialHeroSource) : undefined;
const heroImageDimensions = await getPublicImageDimensions(editorial ? editorialHeroSource : '/assets/hero.webp');
---

<section class="hero" id="hero" aria-labelledby="hero-title" data-hero-carousel data-editorial={editorial || undefined}>
  <div class="hero__media" aria-hidden="true">
    <img
      class="hero__image is-active"
      src={editorial ? editorialHeroSource : initialHeroSources?.srcset ? '/assets/hero.webp' : '/assets/hero-2560.webp'}
      srcset={editorial ? getImageSrcset(editorialHeroSource) : initialHeroSources?.srcset ?? '/assets/hero-960.webp 960w, /assets/hero-1440.webp 1440w, /assets/hero-2560.webp 2560w'}
      sizes={editorial ? '(max-width: 720px) 100vw, 46vw' : initialHeroSources?.sizes ?? '(orientation: portrait) 150svh, 100vw'}
      alt=""
      width={initialHeroSources?.width ?? heroImageDimensions?.width}
      height={initialHeroSources?.height ?? heroImageDimensions?.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      data-original-src={initialHeroSource}
      data-hero-image
      style={editorial ? { objectPosition: heroFocalPoint(initialHeroSource) } : undefined}
    />
    {editorial && <div class="hero-image-tag"><strong>耳機白日</strong><span>棚拍・音樂主題 / 青春感</span></div>}
  </div>

  <div class="hero__overlay"></div>

  <div class="hero__content container">
    <p class="hero__eyebrow" data-hero-eyebrow>{editorial ? 'PHOX999 / 台北人像攝影' : ''}</p>
    <h1 id="hero-title" data-hero-title>{editorial ? <>把喜歡的自己，<br />好好留住。</> : <>第一次互惠拍攝，<br />也能安心開始。</>}</h1>

    <p class="hero__subtitle" data-hero-subtitle>{editorial ? '用喜歡的光線，留住此刻的樣子。' : ''}</p>

    <p class="hero__copy" data-hero-copy>{editorial ? '' : defaultHeroContent.copy}</p>

    <div class="hero__actions">
      <a
        class="button button--primary"
        href={siteConfig.inquiryUrl}
        data-analytics-event="inquiry_click"
        data-analytics-placement="hero"
      >
        填寫合作意向
      </a>
      {editorial && <a class="button button--secondary" href="#portfolio">看看作品</a>}
    </div>
  </div>
</section>

<script>
  import { loadPublicSiteContent } from '../lib/site-content';
  import { heroFocalPoint } from '../data/homePhotoPresentation';
  import { canReuseStaticHeroImage, heroImageSources, loadHeroImageWithFallback, replaceHeroImagesWhenLoaded } from '../lib/hero-images';

  const heroCarousel = document.querySelector('[data-hero-carousel]');

  if (heroCarousel) {
    const media = heroCarousel.querySelector<HTMLElement>('.hero__media');
    let images = media ? Array.from(media.querySelectorAll<HTMLImageElement>('[data-hero-image]')) : [];
    const title = heroCarousel.querySelector('[data-hero-title]');
    const copy = heroCarousel.querySelector('[data-hero-copy]');
    let currentIndex = 0;

    const goToHeroImage = async (index: number) => {
      if (!images.length) return;
      const nextIndex = (index + images.length) % images.length;
      const nextImage = images[nextIndex];
      const existingStaticImage = nextImage.dataset.staticHeroEquivalent === 'true' && nextImage.naturalWidth > 0;
      if (!existingStaticImage && !await loadHeroImageWithFallback(nextImage)) return;
      images[currentIndex].classList.remove('is-active');
      currentIndex = nextIndex;
      images[currentIndex].classList.add('is-active');
    };

    loadPublicSiteContent().then(async (content) => {
      if (title && !heroCarousel.hasAttribute('data-editorial')) title.textContent = content.hero_title;
      if (copy && !heroCarousel.hasAttribute('data-editorial')) copy.textContent = content.hero_copy;

      if (media && content.hero_image_urls.length) {
        const firstUrl = content.hero_image_urls[0];
        const existingImage = images[currentIndex];
        const reuseExistingImage = await canReuseStaticHeroImage(existingImage, firstUrl);
        if (reuseExistingImage) existingImage.dataset.staticHeroEquivalent = 'true';

        const apiImages = content.hero_image_urls.map((url, index) => {
          if (index === 0 && reuseExistingImage) return existingImage;
          const sources = heroImageSources(url);
          const image = document.createElement('img');
          image.className = `hero__image ${index === 0 ? 'is-active' : ''}`;
          image.dataset.originalSrc = url;
          if (heroCarousel.hasAttribute('data-editorial')) image.style.objectPosition = heroFocalPoint(url);
          image.alt = '';
          if (sources.width && sources.height) {
            image.width = sources.width;
            image.height = sources.height;
          }
          image.loading = index === 0 ? 'eager' : 'lazy';
          image.decoding = 'async';
          if (index === 0) image.fetchPriority = 'high';
          image.dataset.heroImage = '';
          return image;
        });

        const replaced = reuseExistingImage
          ? (media.replaceChildren(...apiImages), true)
          : await replaceHeroImagesWhenLoaded(media, apiImages);
        if (replaced) {
          currentIndex = 0;
          images = apiImages;
        }
      }

      if (images.length > 1) {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const timer = window.setInterval(() => { if (!document.hidden) void goToHeroImage(currentIndex + 1); }, 4600);
          window.addEventListener('pagehide', () => window.clearInterval(timer), { once: true });
        }
      }
    });
  }
  if (heroCarousel?.hasAttribute('data-editorial')) {
    const image = heroCarousel.querySelector<HTMLImageElement>('[data-hero-image]');
    if (image && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      image.animate([{ filter: 'blur(6px)', scale: '1.02' }, { filter: 'blur(0)', scale: '1' }], { duration: 1100, easing: 'ease-out' });
      heroCarousel.querySelector('.hero-focus')?.animate([{ opacity: 0.3 }, { opacity: 0 }], { duration: 1100 });
    }
  }
</script>
