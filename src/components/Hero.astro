---
import { siteConfig } from '../data/site';

const heroImages = [
  '/assets/hero.webp',
  '/assets/hero-02.webp',
  '/assets/hero-03.webp',
  '/assets/hero-04.webp',
  '/assets/portfolio/6-20海邊jk_/IMG_9630.webp',
  '/assets/portfolio/照片分享/IMG_6114.webp',
  '/assets/portfolio/地雷系/LINE_ALBUM_202681_260921_7.webp',
  '/assets/portfolio/興華天橋/13.webp',
  '/assets/portfolio/maid/01.webp',
];
---

<section class="hero" id="hero" aria-labelledby="hero-title" data-hero-carousel>
  <div class="hero__media" aria-hidden="true">
    {
      heroImages.map((image, index) => (
        <img
          class={`hero__image ${index === 0 ? 'is-active' : ''}`}
          src={image}
          alt=""
          loading={index === 0 ? 'eager' : 'lazy'}
          data-hero-image
        />
      ))
    }
  </div>

  <div class="hero__overlay"></div>

  <div class="hero__content container">
    <h1 id="hero-title" data-hero-title>第一次互惠拍攝，<br />也能安心開始。</h1>

    <p class="hero__subtitle"></p>

    <p class="hero__copy" data-hero-copy>不論你是第一次拍照，還是想累積作品，<br />拍攝前都會充分溝通需求與風格，尊重彼此的想法，一起完成自然、有故事的作品。</p>

    <a
      class="button button--primary"
      href={siteConfig.inquiryUrl}
    >
      立即預約
    </a>
  </div>
</section>

<script>
  import { loadPublicSiteContent } from '../lib/site-content';

  const heroCarousel = document.querySelector('[data-hero-carousel]');

  if (heroCarousel) {
    let images = Array.from(heroCarousel.querySelectorAll<HTMLImageElement>('[data-hero-image]'));
    const media = heroCarousel.querySelector<HTMLElement>('.hero__media');
    const title = heroCarousel.querySelector('[data-hero-title]');
    const copy = heroCarousel.querySelector('[data-hero-copy]');
    let currentIndex = 0;
    let hasCustomImage = false;

    const goToHeroImage = (index) => {
      if (!images.length) return;

      images[currentIndex].classList.remove('is-active');
      currentIndex = (index + images.length) % images.length;
      images[currentIndex].classList.add('is-active');
    };

    loadPublicSiteContent().then((content) => {
      if (title) title.textContent = content.hero_title;
      if (copy) copy.textContent = content.hero_copy;
      if (content.hero_image_urls.length && media) {
        hasCustomImage = true;
        currentIndex = 0;
        media.replaceChildren(...content.hero_image_urls.map((url, index) => {
          const image = document.createElement('img');
          image.className = `hero__image ${index === 0 ? 'is-active' : ''}`;
          image.src = url;
          image.alt = '';
          image.loading = index === 0 ? 'eager' : 'lazy';
          image.dataset.heroImage = '';
          return image;
        }));
        images = Array.from(media.querySelectorAll<HTMLImageElement>('[data-hero-image]'));
      }
    });

    if (images.length > 1) {
      window.setInterval(() => {
        if (!hasCustomImage) goToHeroImage(currentIndex + 1);
      }, 4600);
    }
  }
</script>
