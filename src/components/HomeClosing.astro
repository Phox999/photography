---
import { siteConfig } from '../data/site';
import { getImageSrcset } from '../lib/image-variants';
import { getPublicImageDimensions } from '../lib/image-dimensions';

const image = '/assets/portfolio/260201_棚拍 RE/_I7A0019.webp';
const dimensions = await getPublicImageDimensions(image);
---

<section class="home-closing editorial-section" aria-labelledby="closing-title">
  <div class="home-closing__copy">
    <p class="eyebrow">07 / YOUR NEXT FRAME</p>
    <h2 id="closing-title">下一個畫面，<br />留給你。</h2>
    <p>有想拍的主題，就從聊聊開始。</p>
    <a
      class="button button--primary"
      href={siteConfig.inquiryUrl}
      data-analytics-event="inquiry_click"
      data-analytics-placement="home-closing"
    >填寫合作意向</a>
  </div>
  <figure class="home-closing__media">
    <img
      src={image}
      srcset={getImageSrcset(image)}
      sizes="(max-width: 720px) 100vw, 44vw"
      alt="戴著耳機、穿著黑色皮衣的模特站在攝影棚中"
      width={dimensions?.width}
      height={dimensions?.height}
      loading="lazy"
      decoding="async"
    />
    <figcaption class="home-image-tag">
      <strong>耳機白日</strong>
      <span>棚拍・音樂主題 / 青春感</span>
    </figcaption>
  </figure>
</section>
