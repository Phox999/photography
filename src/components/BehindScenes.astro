---
import { portfolioCatalog } from '../data/portfolioCatalog';

const stories = portfolioCatalog.slice(0, 6);
---

<section class="behind-page-section container" aria-labelledby="behind-title">
  <header class="behind-page-heading inner-heading">
    <p class="eyebrow">BEHIND THE SCENES</p>
    <h1 id="behind-title">拍攝花絮</h1>
    <p class="inner-intro">每組作品都從一次討論開始。這裡整理不同主題與場景的拍攝記錄，現場側拍也會陸續更新。</p>
  </header>

  <div class="behind-page-note" role="note">
    <span class="behind-page-note__mark" aria-hidden="true">i</span>
    <p>目前先以已公開作品記錄每次拍攝方向；新的現場花絮素材整理完成後，會在這裡補上。</p>
  </div>

  <div class="behind-story-heading">
    <div>
      <p class="eyebrow">RECENT STORIES</p>
      <h2>從主題開始，看見每組作品的樣子。</h2>
    </div>
    <a class="text-link" href="/portfolio/">瀏覽全部作品</a>
  </div>

  <div class="behind-story-grid">
    {stories.map((story, index) => (
      <article class="behind-story-card">
        <a href={story.href} aria-label={`瀏覽${story.title}拍攝記錄`}>
          <div class="behind-story-card__image">
            <img src={story.cover} alt={`${story.title}拍攝作品`} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
            <span>{story.category}</span>
          </div>
          <div class="behind-story-card__copy">
            <h3>{story.title}</h3>
            <p>{story.description}</p>
            <span class="behind-story-card__link">看這組作品 <span aria-hidden="true">→</span></span>
          </div>
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  .behind-page-section { padding-block: clamp(132px, 15vw, 180px) clamp(64px, 8vw, 104px); }
  .behind-page-heading { max-width: 780px; margin-bottom: clamp(30px, 4vw, 48px); }
  .behind-page-heading h1 { margin: 0; font-size: clamp(2.5rem, 5vw, 4.25rem); }
  .behind-page-heading .inner-intro { max-width: 42em; margin-top: 18px; }
  .behind-page-note { display: flex; align-items: flex-start; gap: 14px; margin-bottom: clamp(42px, 6vw, 72px); padding: 18px 22px; border: 1px solid var(--color-border); border-radius: var(--radius-card, 28px); background: var(--color-surface-soft); color: var(--color-muted); }
  .behind-page-note__mark { display: grid; width: 26px; height: 26px; flex: 0 0 auto; place-items: center; border-radius: 50%; background: #dff3fb; color: var(--color-primary-dark); font-weight: 800; }
  .behind-page-note p { margin: 0; line-height: 1.75; }
  .behind-story-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
  .behind-story-heading h2 { max-width: 22em; font-size: clamp(1.8rem, 3.3vw, 2.6rem); }
  .behind-story-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .behind-story-card { min-width: 0; overflow: hidden; border-radius: var(--radius-card, 30px); background: var(--color-surface); box-shadow: var(--shadow-card); }
  .behind-story-card > a { display: block; height: 100%; color: inherit; }
  .behind-story-card__image { position: relative; overflow: hidden; aspect-ratio: 4 / 3; background: var(--color-surface-soft); }
  .behind-story-card__image::after { position: absolute; inset: 45% 0 0; background: linear-gradient(transparent, rgb(15 34 42 / .54)); content: ''; pointer-events: none; }
  .behind-story-card__image img { width: 100%; height: 100%; object-fit: cover; transition: transform 300ms ease; }
  .behind-story-card > a:hover img, .behind-story-card > a:focus-visible img { transform: scale(1.035); }
  .behind-story-card__image > span { position: absolute; z-index: 1; right: 16px; bottom: 14px; color: #fff; font-size: .9rem; font-weight: 700; }
  .behind-story-card__copy { padding: 22px 24px 24px; }
  .behind-story-card__copy h3 { margin: 0; font-family: var(--font-heading); font-size: clamp(1.3rem, 2vw, 1.65rem); }
  .behind-story-card__copy p { min-height: 3.5em; margin: 10px 0 18px; color: var(--color-muted); line-height: 1.75; }
  .behind-story-card__link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--color-primary-dark); font-weight: 700; }
  .behind-page-section a:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 4px; }
  @media (max-width: 820px) { .behind-story-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; } }
  @media (max-width: 560px) {
    .behind-page-section { padding-top: 112px; }
    .behind-story-heading { align-items: flex-start; flex-direction: column; }
    .behind-story-grid { grid-template-columns: minmax(0, 1fr); }
    .behind-story-card__copy p { min-height: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .behind-story-card__image img { transition: none; } }
</style>
