---
import { navItems, siteConfig } from '../data/site';

interface Props { home?: boolean; editorial?: boolean; }
const { home = false, editorial = false } = Astro.props;
const links = editorial ? [
  { label: '作品', href: '#portfolio' },
  { label: '創作方向', href: '#directions' },
  { label: '開放檔期', href: '#dates' },
  { label: '申請合作', href: '#contact' },
] : navItems;
const currentPath = Astro.url.pathname;
---

<header class:list={['site-header', home && 'site-header--home']} aria-label="網站導覽">
<a class="logo" href="/">
  <span>Phox999</span>
  <small>photography</small>
</a>

  <nav class="desktop-nav" aria-label="主要導覽">
    {links.map((item) => <a href={item.href} aria-current={item.href === currentPath ? 'page' : undefined}>{item.label}</a>)}
  </nav>

  <a class="button button--header" href={siteConfig.inquiryUrl} data-analytics-event="inquiry_click" data-analytics-placement="header-desktop">
    填寫合作意向
  </a>

  <details class="mobile-nav">
    <summary aria-label="開啟導覽選單">選單</summary>
    <div class="mobile-nav__panel">
      {links.map((item) => <a href={item.href} aria-current={item.href === currentPath ? 'page' : undefined}>{item.label}</a>)}
      <a href={siteConfig.inquiryUrl} data-analytics-event="inquiry_click" data-analytics-placement="header-mobile">填寫合作意向</a>
    </div>
  </details>
</header>
