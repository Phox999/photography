---
import { navItems, siteConfig } from '../data/site';
---

<header class="site-header" aria-label="網站導覽">
<a class="logo" href="/">
  <span>Phox999</span>
  <small>photography</small>
</a>

  <nav class="desktop-nav" aria-label="主要導覽">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <a class="button button--header" href={siteConfig.inquiryUrl}>
    開始聊聊拍攝
  </a>

  <details class="mobile-nav">
    <summary aria-label="開啟導覽選單">選單</summary>
    <div class="mobile-nav__panel">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={siteConfig.inquiryUrl}>開始聊聊拍攝</a>
    </div>
  </details>
</header>
