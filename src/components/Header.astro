---
import { navItems, siteConfig } from '../data/site';

interface Props { home?: boolean; editorial?: boolean; }
const { home = false, editorial = false } = Astro.props;
const links = editorial ? [
  { label: '拍攝理念', href: '#story' },
  { label: '精選作品', href: '#portfolio' },
  { label: '拍攝流程', href: '#process' },
] : navItems;
const currentPath = Astro.url.pathname;
---

<header class:list={['site-header', home && 'site-header--home']} aria-label="網站導覽">
<a class="logo" href="/">
  {editorial && <svg class="logo-mark" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <g fill="currentColor" stroke="#fff" stroke-width="2" stroke-linejoin="round">
      <path d="M48 7c14-1 27 6 34 18L58 46c-4 3-10 1-11-4L42 12c0-3 3-5 6-5Z" />
      <path d="M48 7c14-1 27 6 34 18L58 46c-4 3-10 1-11-4L42 12c0-3 3-5 6-5Z" transform="rotate(60 50 50)" />
      <path d="M48 7c14-1 27 6 34 18L58 46c-4 3-10 1-11-4L42 12c0-3 3-5 6-5Z" transform="rotate(120 50 50)" />
      <path d="M48 7c14-1 27 6 34 18L58 46c-4 3-10 1-11-4L42 12c0-3 3-5 6-5Z" transform="rotate(180 50 50)" />
      <path d="M48 7c14-1 27 6 34 18L58 46c-4 3-10 1-11-4L42 12c0-3 3-5 6-5Z" transform="rotate(240 50 50)" />
      <path d="M48 7c14-1 27 6 34 18L58 46c-4 3-10 1-11-4L42 12c0-3 3-5 6-5Z" transform="rotate(300 50 50)" />
    </g>
    <circle cx="50" cy="50" r="7" fill="#fff" />
  </svg>}
  <span>{editorial ? 'phox999' : 'Phox999'}</span>
  {!editorial && <small>photography</small>}
</a>

  <nav class="desktop-nav" aria-label="主要導覽">
    {links.map((item) => <a href={item.href} aria-current={item.href === currentPath ? 'page' : undefined}>{item.label}</a>)}
  </nav>

  <a class="button button--header" href={siteConfig.inquiryUrl} data-analytics-event="inquiry_click" data-analytics-placement="header-desktop">
    填寫合作意向
  </a>

  <details class="mobile-nav">
    <summary aria-label="開啟導覽選單">選單</summary>
    <div class="mobile-nav__panel">
      {links.map((item) => <a href={item.href} aria-current={item.href === currentPath ? 'page' : undefined}>{item.label}</a>)}
      <a href={siteConfig.inquiryUrl} data-analytics-event="inquiry_click" data-analytics-placement="header-mobile">填寫合作意向</a>
    </div>
  </details>
</header>

<script>
  const mobileNav = document.querySelector('.site-header--home .mobile-nav');
  mobileNav?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) mobileNav.open = false;
  });
</script>
