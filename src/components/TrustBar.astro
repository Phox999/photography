---
const items = [
  {
    number: '80',
    unit: '+',
    title: '場合作經驗',
  },
  {
    number: '設計背景',
    unit: '',
    title: '',
  },
];
---

<section class="trust-wrap" aria-label="合作信任重點">
  <div class="trust-bar trust-bar--stats container">
    {
      items.map((item) => (
        <article class:list={['trust-stat', 'trust-stat--vertical', !item.title && 'trust-stat--text']}>
          <div class="trust-stat__number">
            <span>{item.number}</span>
            {item.unit && <small>{item.unit}</small>}
          </div>

          {item.title && (
            <div class="trust-stat__content">
              <h2>{item.title}</h2>
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>
