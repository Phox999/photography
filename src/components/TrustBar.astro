---
const items = [
{
  number: '50',
  unit: '+',
  title: '場合作經驗',
  text: '豐富的拍攝與溝通經驗',
},
  {
    number: '8 ',
    unit: '年',
    title: '設計訓練',
    text: '台師大設計所畢業，審美在線',
  },
  {
    number: '0',
    unit: '',
    title: '經驗OK',
    text: '拍攝過程會協助引導',
  },
];
---

<section class="trust-wrap" aria-label="合作信任重點">
  <div class="trust-bar trust-bar--stats container">
    {
      items.map((item) => (
        <article class="trust-stat">
          <div class="trust-stat__number">
            <span>{item.number}</span>
            {item.unit && <small>{item.unit}</small>}
          </div>

          <div class="trust-stat__content">
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>